---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Divider from './Divider.astro';
import About from './About.astro';
import Console from './Console.astro';
import Process from './Process.astro';
import Inventory from './Inventory.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Journey from './Journey.astro';
import PuppetSprite from './PuppetSprite.astro';
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang}>
  <PuppetSprite />
  <Hero lang={lang} />
  <main id="contenido">
    <About lang={lang} />
    <Console lang={lang} />
    <Divider shape="clouds" color="var(--sky-light)" bg="transparent" />
    <Process lang={lang} />
    <Divider shape="hills" color="var(--ground)" bg="var(--sky-light)" />
    <Inventory lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
  <Journey lang={lang} />
</Base>

<script>
  import { initMotion } from '../scripts/motion';
  import { initRewind } from '../scripts/rewind';
  initMotion();
  initRewind();
</script>
