---
// The first screen. An intro in the spirit of a title card: on cream, José's little mark wobbles
// while the world loads; then a cobalt liquid rises with a wavy edge and his name lands letter by
// letter, as puffy 3D letters made in Blender (blender/hero3d.py), with his own face as the "O".
// Glossy stickers for his worlds float around it; drag them, throw them, or tap one to open those
// projects. A glass lens follows the mouse over the name and bursts when clicked.
// Last comes the way in: his Creative ID drops on its lanyard; pull it onto the reader (or tap)
// and access is granted. "Enter without scanning" opens it too, and nothing is gated without JS.
import Puppet from './Puppet.astro';
import { getData, t, type Lang } from '../i18n';
import LangSwitch from './LangSwitch.astro';
import h3d from '../data/hero3d.json';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { site, worlds } = getData(lang);
const ui = t(lang);
const h = ui.hero3d;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const L = h3d.letters as Record<string, { w: number; h: number; x0: number; y0: number }>;
const lines = [['J', 'O', 'S', 'E-acute', ' ', 'L', 'U', 'I', 'S'], ['P', 'I', 'N', 'E', 'D', 'A']];
const ls = (k: string) => `--w:${L[k].w};--h:${L[k].h};--y0:${L[k].y0}`;
const wname = Object.fromEntries(worlds.map((w) => [w.id, w.name]));
const wcol = Object.fromEntries(worlds.map((w) => [w.id, w.bg]));
// Where each sticker rests, in % of the stage, its turn and its width (vw on wide screens).
const stickers = [
  { id: 'mando', group: 'juegos', label: wname.juegos, x: 30, y: 2, r: -14, s: 15, d: 0, mx: 1, my: 1, ms: 24 },
  { id: 'visor', group: 'vr', label: wname.vr, x: 54, y: 9, r: 10, s: 12, d: 1.4, mx: 74, my: 0, ms: 22 },
  { id: 'gema', group: '3d', label: wname['3d'], x: 44, y: 78, r: 8, s: 10.5, d: 0.7, mx: -2, my: 44, ms: 17 },
  { id: 'chip', group: 'software', label: wname.software, x: 60, y: 62, r: -9, s: 11, d: 2.1, mx: 82, my: 46, ms: 17 },
  { id: 'claqueta', group: '3d', label: h.claqueta, x: 24, y: 86, r: 12, s: 11.5, d: 1, mx: 3, my: 68, ms: 19 },
];
const S = h3d.stickers as Record<string, { w: number; h: number }>;
// Bubbles rising through the water at the gate: fixed pseudo-random spots, sizes and timings.
const rnd = (i: number, k: number) => ((Math.sin(i * 12.9898 + k * 78.233) * 43758.5453) % 1 + 1) % 1;
const bubs = Array.from({ length: 22 }, (_, i) => ({
  x: (rnd(i, 1) * 100).toFixed(1), s: (5 + rnd(i, 2) * 22).toFixed(0), d: (7 + rnd(i, 3) * 9).toFixed(1),
  dl: (-rnd(i, 4) * 16).toFixed(1), w: ((rnd(i, 5) - 0.5) * 70).toFixed(0),
}));
---
<section class="hero" id="inicio" aria-labelledby="hero-title" data-scene="hero">
  <div class="water" aria-hidden="true">
    <canvas class="water-gl"></canvas>
    <div class="water-rays"></div>
    <div class="bubs">
      {bubs.map((b) => <span style={`--x:${b.x}%;--s:${b.s}px;--d:${b.d}s;--dl:${b.dl}s;--w:${b.w}px`}></span>)}
    </div>
    <span class="water-ring"></span>
    <svg class="water-surface" viewBox="0 0 2880 60" preserveAspectRatio="none">
      <path d="M0 30 C240 0 480 60 720 30 C960 0 1200 60 1440 30 C1680 0 1920 60 2160 30 C2400 0 2640 60 2880 30 V60 H0 Z" />
    </svg>
  </div>
  <svg class="defs" width="0" height="0" aria-hidden="true">
    <filter id="underwater" x="-8%" y="-8%" width="116%" height="116%">
      <feTurbulence type="fractalNoise" baseFrequency="0.008 0.016" numOctaves="2" seed="4" result="n">
        <animate attributeName="baseFrequency" dur="9s" values="0.008 0.016;0.012 0.024;0.008 0.016" repeatCount="indefinite" />
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="9" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
  <header class="nav wrap">
    <a class="id" href="#inicio" aria-label={`José Luis Pineda, ${ui.home}`}>
      <span class="id-face" aria-hidden="true">
        <Puppet pose="calm" live={false} class="f-calm" />
        <Puppet pose="celebrate" live={false} class="f-joy" />
      </span>
      <span class="id-text">
        <span class="id-name">José Luis</span>
        <span class="id-status"><span class="dot" aria-hidden="true"></span>{ui.available}</span>
      </span>
    </a>
    <nav aria-label={ui.chapters}>
      <ul class="glass" data-liquid='{"bezel":16,"scale":30}'>
        <li class="hide-sm gated" style="--i:0"><a class="sketch-pill" href="#quien-soy">{ui.navAbout}</a></li>
        <li class="hide-sm gated" style="--i:1"><a class="sketch-pill" href="#proyectos">{ui.navWorlds}</a></li>
        <li class="hide-md gated" style="--i:2"><a class="sketch-pill" href="#como-trabajo">{ui.navProcess}</a></li>
        <li class="li-lang"><LangSwitch lang={lang} /></li>
        <li class="gated" style="--i:3"><a class="nav-cta" href="#contacto">{ui.writeMe}</a></li>
      </ul>
    </nav>
  </header>

  <div class="stage">
    <div class="name-wrap">
      <p class="hello hand">{h.hello}</p>
      <h1 class="name" id="hero-title" aria-label={`${site.name.first} ${site.name.last}`}>
        {lines.map((line) => (
          <span class="line" aria-hidden="true">
            {line.map((k) =>
              k === ' ' ? <span class="sp"></span>
              : k === 'O' ? (
                <span class="ch face" style={ls('O')}>
                  <span class="face-in"><Puppet pose="calm" view="450 660 780 700" class="face-pp" /></span>
                </span>
              ) : (
                <img class="ch" src={`${base}hero/l-${k}.webp`} style={ls(k)} alt="" draggable="false"
                  width={Math.round(L[k].w * 420)} height={Math.round(L[k].h * 420)} fetchpriority="high" />
              ))}
          </span>
        ))}
      </h1>
      <p class="role">
        <span class="role-name">{h.role}</span>
        <span class="role-place">{h.place}</span>
      </p>
      <span class="card-zone" aria-hidden="true"></span>
      <p class="hero-tag gated" style="--i:1">{ui.heroTag}</p>
      <p class="hero-actions gated" style="--i:2">
        <a class="btn" href="#quien-soy">{ui.start} <span class="arrow" aria-hidden="true">↓</span></a>
        <a class="btn-glass glass" href="#proyectos">{ui.navWorlds}</a>
      </p>
    </div>

    <ul class="stickers" aria-label={ui.navWorlds}>
      {stickers.map((s) => (
        <li class="sticker-li" style={`--x:${s.x};--y:${s.y};--mx:${s.mx};--my:${s.my};--ms:${s.ms};--r:${s.r}deg;--s:${s.s};--ar:${S[s.id].w / S[s.id].h};--d:${s.d}s;--c:${wcol[s.group]}`}>
          <button class="sticker" type="button" data-group={s.group} aria-label={`${h.open} ${s.label}`}>
            <img src={`${base}hero/s-${s.id}.webp`} alt="" draggable="false" loading="eager" />
            <span class="sticker-tip glass" aria-hidden="true">{s.label}</span>
          </button>
        </li>
      ))}
    </ul>

    <div class="lens" aria-hidden="true"><div class="lens-in"></div><span class="lens-shine"></span></div>
    <div class="ghost" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M4 2 L4 19 L8.5 15 L11.5 22 L14.5 20.7 L11.6 14 L18 14 Z" /></svg>
      <span class="ghost-tag" data-drag={h.drag}>{h.cursor}</span>
    </div>
  </div>

  <div class="lanyard" data-lanyard>
    <div class="strap" aria-hidden="true"><span class="reel"></span></div>
    <span class="cord" aria-hidden="true"></span>
    <div class="swing">
      <svg class="clip" viewBox="0 0 60 92" aria-hidden="true">
        <rect x="16" y="0" width="28" height="18" rx="4" fill="#9aa0ad" />
        <circle cx="30" cy="30" r="13" fill="none" stroke="#b9bec8" stroke-width="7" />
        <path d="M22 40 L18 70 Q16 84 30 86 Q44 84 42 70 L38 40" fill="none" stroke="#c9cdd5" stroke-width="7" stroke-linecap="round" />
        <path d="M30 56 L30 74" stroke="#8b919d" stroke-width="5" stroke-linecap="round" />
      </svg>
      <div class="badge">
        <div class="badge-card cid">
          <img src={`${base}img/creative-id.webp`} width="889" height="575" alt={ui.cidAlt} draggable="false" />
          <span class="slot" aria-hidden="true"></span>
          <span class="scan-beam" aria-hidden="true"></span>
          <span class="pass-stamp" aria-hidden="true"><b>{ui.reader.stamp}</b><small>{ui.reader.lap} 01</small></span>
          <p class="bubble tape" data-lines={JSON.stringify(ui.bubbles)} data-loop-line={ui.loopLine}><span>{ui.bubbles[0]}</span></p>
        </div>
      </div>
    </div>
  </div>

  <div class="reader" data-reader data-state="idle" data-msg={JSON.stringify(ui.reader)}>
    <p class="reader-call hand" aria-hidden="true">{h.scan}</p>
    <div class="reader-body glass" data-liquid>
      <button class="reader-pad" type="button" aria-label={ui.reader.btn} aria-describedby="reader-status">
        <span class="reader-window" aria-hidden="true">
          <span class="ring r1"></span><span class="ring r2"></span>
          <svg class="nfc" viewBox="0 0 48 48">
            <path d="M14 14 Q22 24 14 34" /><path d="M21 9 Q33 24 21 39" /><path d="M28 4 Q44 24 28 44" />
          </svg>
          <svg class="tick" viewBox="0 0 48 48"><path d="M12 25 L21 34 L37 15" /></svg>
        </span>
      </button>
      <p class="reader-status" id="reader-status" aria-live="polite">
        <span class="reader-name" aria-hidden="true">JLP · {ui.reader.label}</span>
        <span class="reader-line"><span class="led" aria-hidden="true"></span><span class="reader-text">{ui.reader.idle}</span></span>
        <span class="reader-sub">{ui.reader.sub}</span>
      </p>
    </div>
  </div>

  <button class="gate-skip hand" type="button">{ui.gateSkip}</button>

  <div class="intro" aria-hidden="true">
    <div class="intro-paper">
      <div class="intro-mark">
        <span class="intro-face"><Puppet pose="calm" view="430 640 820 900" live={false} /></span>
        <span class="intro-word">{'José Luis'.split('').map((c, i) => <span style={`--i:${i}`}>{c === ' ' ? ' ' : c}</span>)}<sup>®</sup></span>
      </div>
      <p class="intro-load"><span>{h.loading}</span><i></i></p>
      <svg class="intro-edge" viewBox="0 0 1440 120" preserveAspectRatio="none"><path d="M0 0 H1440 V60 C1200 120 960 0 720 60 C480 120 240 0 0 60 Z" /></svg>
    </div>
    <button class="intro-skip" type="button" tabindex="-1">{h.skipIntro}</button>
  </div>
</section>

<style>
  /* ---------- Navigation ---------- */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 18px;
    position: relative;
    z-index: 3;
  }

  /* The menu is a liquid-glass bar; inside it the links are plain handwriting that lights up. */
  .nav ul {
    display: flex;
    gap: clamp(2px, 0.6vw, 8px);
    align-items: center;
    padding: 5px;
    border-radius: 999px;
  }

  .nav :global(.sketch-pill)::before {
    border-color: transparent;
    border-radius: 999px;
    rotate: 0deg;
    inset: 0;
  }

  .nav :global(.sketch-pill):hover::before,
  .nav :global(.sketch-pill):focus-visible::before {
    inset: 0;
    rotate: 0deg;
    background: #ffffffb3;
    box-shadow: inset 0 1px 0 #fff, 0 4px 10px -4px #2a2a2e40;
  }

  .nav :global(.lang-switch) { background: #ffffff8c; }

  /* José's tag: his face and name in a box drawn with a pen. */
  .id {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 6px;
    text-decoration: none;
    isolation: isolate;
  }

  .id::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--paper);
    border: 2.5px solid var(--ink);
    border-radius: 10px 14px 9px 12px;
    box-shadow: 3px 3px 0 var(--ink);
    rotate: -1.2deg;
    transition: rotate 0.3s var(--ease-spring);
  }

  .id:hover::before {
    rotate: 1deg;
  }

  .id-face {
    display: block;
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--sky);
    flex: none;
    transition: transform 0.4s var(--ease-spring);
  }

  .id-face :global(.pp) {
    position: absolute;
    left: 50%;
    bottom: -30%;
    width: 140%;
    max-width: none;
    height: auto;
    translate: -50% 0;
    transition: opacity 0.15s;
  }

  .id-face :global(.f-joy) { opacity: 0; }
  .id:hover .id-face { transform: rotate(-8deg) scale(1.08); }
  .id:hover .id-face :global(.f-joy) { opacity: 1; }
  .id:hover .id-face :global(.f-calm) { opacity: 0; }

  .id-text {
    display: grid;
    line-height: 1.1;
  }

  .id-name {
    font-weight: 900;
    font-stretch: 125%;
    font-size: 16px;
    text-transform: uppercase;
  }

  .id-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--hand);
    font-size: 18px;
    font-weight: 600;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3fbf6f;
    animation: live 2s ease-out infinite;
  }

  @keyframes live {
    0% { box-shadow: 0 0 0 0 #3fbf6faa; }
    100% { box-shadow: 0 0 0 9px #3fbf6f00; }
  }

  .nav :global(.lang-switch) {
    box-shadow: inset 0 1px 0 #fff, 0 0 0 1px #2a2a2e1f;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--paper);
    font-weight: 800;
    font-size: 15px;
    text-decoration: none;
    box-shadow: 3px 3px 0 var(--red);
    transition: transform 0.25s var(--ease-spring), box-shadow 0.25s var(--ease-spring);
  }

  .nav-cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--red);
  }

  /* ---------- The lanyard and badge ---------- */
  .lanyard {
    position: absolute;
    z-index: 2;
    left: var(--anchor, 50%);
    top: 0;
    width: 0;
    height: 0;
    transition: left 1s var(--ease-out);
  }

  .swing {
    --len: var(--strap);
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    will-change: transform;
  }

  .strap {
    position: absolute;
    left: -15px;
    top: -20px;
    width: 30px;
    height: calc(var(--strap-len, var(--strap)) + 24px);
    transform-origin: 15px 20px;
    rotate: var(--sa, 0deg);
    background:
      linear-gradient(90deg, #00000026 0 3px, #0000 3px calc(100% - 3px), #00000026 0),
      repeating-linear-gradient(0deg, #ffffff12 0 2px, #0000 2px 5px),
      var(--red);
  }

  /* The badge reel at the end of the strap; past it, a thin cord pulls out. */
  .reel {
    position: absolute;
    left: -2px;
    top: calc(100% - 18px);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, #2a2a2e 0 4px, #0000 4.5px),
      radial-gradient(circle at 35% 30%, #fff 0, #e6e8ee 30%, #a9aeb9 75%, #8b919d);
    box-shadow: 0 0 0 3px var(--red), 0 4px 6px #0000004d;
  }

  /* Drawn from the reel to the clip, wherever the card has been pulled. */
  .cord {
    position: absolute;
    left: -1px;
    top: 0;
    width: 2px;
    height: 0;
    border-radius: 2px;
    background: #2a2a2e;
    transform-origin: 1px 0;
  }

  .clip {
    position: absolute;
    left: -21px;
    top: calc(var(--len) - 6px);
    width: 42px;
    max-width: none;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 3px 2px #0000002e);
  }

  .badge {
    position: absolute;
    left: calc(var(--badge-w) / -2);
    top: calc(var(--len) + 50px);
    width: var(--badge-w);
    height: var(--badge-h);
    transform-origin: 50% -30px;
    perspective: 900px;
    /* The card can be dragged on phones too (onto the reader); the page scrolls from anywhere else. */
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .badge.is-grabbed {
    cursor: grabbing;
  }

  /* ---------- The Creative ID: José's own card from his old portfolio ---------- */
  .cid {
    position: absolute;
    inset: 0;
    container-type: inline-size;
    border-radius: 5cqw;
    box-shadow:
      0 2px 0 #0000000d,
      0 30px 50px -18px #2a2a2e66,
      0 70px 90px -40px #2a2a2e40;
    transform-style: preserve-3d;
  }

  .cid img {
    width: 100%;
    height: 100%;
    border-radius: 5cqw;
    pointer-events: none;
    -webkit-user-drag: none;
  }

  /* A punched slot for the clip. */
  .slot {
    position: absolute;
    left: 50%;
    top: 1.6cqw;
    width: 15cqw;
    height: 2.4cqw;
    translate: -50% 0;
    border-radius: 99px;
    background: #2a2a2e;
    box-shadow: 0 1px 0 #fff8, inset 0 2px 3px #000;
  }

  /* The greeting is written on a piece of yellow tape stuck across the card's corner. */
  .bubble {
    position: absolute;
    z-index: 3;
    left: -6cqw;
    top: -4cqw;
    max-width: 60cqw;
    rotate: -6deg;
    font-size: clamp(18px, 4cqw, 26px);
    transform-origin: 10% 50%;
    transition: transform 0.4s var(--ease-spring), opacity 0.25s;
    pointer-events: none;
  }

  :global(.js) .bubble { opacity: 0; transform: scale(0.5); }
  :global(.js) .bubble.is-on { opacity: 1; transform: none; }

  /* The reader's laser sweeping over the card, twice. */
  .scan-beam {
    position: absolute;
    z-index: 4;
    left: -2cqw;
    right: -2cqw;
    top: 0;
    height: 1.1cqw;
    border-radius: 99px;
    background: #ff5a4f;
    box-shadow: 0 0 1.2cqw 0.4cqw #ff5a4fb3, 0 0 6cqw 1.6cqw #ff5a4f40;
    opacity: 0;
    pointer-events: none;
  }

  .cid.beam-on .scan-beam {
    animation: beam 0.55s ease-in-out 2 alternate;
  }

  @keyframes beam {
    0% { top: 4%; opacity: 1; }
    100% { top: 94%; opacity: 1; }
  }

  .cid.is-scanning {
    box-shadow:
      0 0 0 0.6cqw #ff5a4f40,
      0 30px 50px -18px #2a2a2e66,
      0 70px 90px -40px #2a2a2e40;
  }

  /* The access stamp, in green ink, slammed over the photo once the card is read. */
  .pass-stamp {
    position: absolute;
    z-index: 3;
    left: 8cqw;
    top: 52cqw;
    display: grid;
    justify-items: center;
    padding: 1cqw 3cqw 1.2cqw;
    border: 0.7cqw double #23864f;
    border-radius: 1.6cqw;
    color: #23864f;
    font-weight: 900;
    font-stretch: 125%;
    line-height: 1;
    rotate: -11deg;
    mix-blend-mode: multiply;
    opacity: 0;
    scale: 2.4;
    pointer-events: none;
  }

  .pass-stamp b { font-size: 5.4cqw; letter-spacing: 0.06em; }
  .pass-stamp small { font-size: 2.4cqw; font-weight: 800; letter-spacing: 0.18em; }

  .cid.is-stamped .pass-stamp {
    opacity: 0.88;
    scale: 1;
    transition: scale 0.28s cubic-bezier(0.5, 0, 0.75, 0), opacity 0.12s;
  }

  /* ---------- The access reader (liquid glass) ---------- */
  /* A glass pill at the bottom of the gate; the card is pulled straight down onto its top edge. */
  .reader {
    --ok: #23864f;
    --beam: #ff5a4f;
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: clamp(56px, 10svh, 110px);
    translate: -50% 0;
    width: max-content;
    max-width: calc(100% - 2 * var(--margin));
    transition: opacity 0.4s, translate 0.6s var(--ease-out), visibility 0s 0.6s;
  }

  .reader-body {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 30px 10px 10px;
    border-radius: 999px;
  }

  .reader-pad {
    flex: none;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 50%;
    cursor: pointer;
  }

  .reader-window {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(60px, 7svh, 76px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, #ffffffb3, #ffffff26 70%);
    box-shadow: inset 0 2px 6px #2a2a2e33, inset 0 -2px 0 #ffffffcc, 0 0 0 1px #2a2a2e14;
    transition: box-shadow 0.3s, background-color 0.3s, scale 0.35s var(--ease-spring);
  }

  .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--sky);
    opacity: 0;
    animation: ping 2.4s var(--ease-out) infinite;
  }

  .ring.r2 { animation-delay: 1.2s; }

  @keyframes ping {
    0% { scale: 0.7; opacity: 0.9; }
    100% { scale: 1.6; opacity: 0; }
  }

  .nfc, .tick {
    width: 46%;
    height: auto;
    fill: none;
    stroke: var(--ink);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    grid-area: 1 / 1;
    transition: opacity 0.25s, scale 0.35s var(--ease-spring);
  }

  .nfc { rotate: -90deg; }
  .nfc path { animation: wave 1.8s ease-in-out infinite; }
  .nfc path:nth-child(2) { animation-delay: 0.15s; }
  .nfc path:nth-child(3) { animation-delay: 0.3s; }

  @keyframes wave {
    0%, 60%, 100% { opacity: 1; }
    30% { opacity: 0.25; }
  }

  .tick { stroke: var(--ok); stroke-width: 5; opacity: 0; scale: 0.4; }

  .reader-status {
    display: grid;
    gap: 2px;
    line-height: 1.15;
    min-width: 0;
  }

  .reader-line {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: clamp(15px, 1.2vw, 17px);
  }

  .led {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--sky);
    box-shadow: 0 0 0 3px #7c90da33;
    transition: background-color 0.2s, box-shadow 0.2s;
  }

  .reader-sub {
    min-height: 1.2em;
    font-family: var(--hand);
    font-size: 19px;
    font-weight: 600;
    color: var(--muted);
  }

  .reader-name {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #2a2a2e80;
    margin-bottom: 2px;
  }

  .reader-pad:hover .reader-window { scale: 1.06; }

  .reader[data-state='near'] .reader-window {
    scale: 1.12;
    background-color: #ffe14d66;
    box-shadow: inset 0 2px 6px #2a2a2e33, 0 0 0 4px #ffe14d, 0 0 40px #ffe14d;
  }
  .reader[data-state='near'] .led { background: #e2b84a; box-shadow: 0 0 0 3px #e2b84a55; }

  .reader[data-state='scan'] .reader-window { box-shadow: inset 0 2px 6px #2a2a2e33, 0 0 0 3px var(--beam), 0 0 36px #ff5a4f99; }
  .reader[data-state='scan'] .led { background: var(--beam); animation: blink 0.2s steps(2) infinite; }
  .reader[data-state='scan'] .ring { border-color: var(--beam); animation-duration: 0.8s; }

  .reader[data-state='ok'] .reader-window { box-shadow: inset 0 2px 6px #2a2a2e33, 0 0 0 3px var(--ok), 0 0 36px #23864f66; }
  .reader[data-state='ok'] .led { background: var(--ok); box-shadow: 0 0 0 3px #23864f40; }
  .reader[data-state='ok'] .ring { border-color: var(--ok); animation-iteration-count: 2; }
  .reader[data-state='ok'] .nfc { opacity: 0; scale: 0.5; }
  .reader[data-state='ok'] .tick { opacity: 1; scale: 1; }
  .reader[data-state='ok'] .reader-line { color: var(--ok); }

  @keyframes blink { 50% { opacity: 0.2; } }

  .gate-skip {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: clamp(14px, 3svh, 32px);
    translate: -50% 0;
    padding: 6px 12px;
    border: 0;
    background: none;
    font-size: 20px;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    cursor: pointer;
    transition: opacity 0.3s, visibility 0s 0.3s;
  }

  .gate-skip:hover { color: var(--ink); }


  /* ---------- The stage ---------- */
  .hero {
    /* One letter unit: the size the Blender letters are laid out in. */
    --u: clamp(44px, min(11.2vw, 17.5svh), 172px);
    --strap: clamp(70px, 11svh, 130px);
    --badge-w: min(24vw, 380px, 40svh);
    --badge-h: calc(var(--badge-w) / 1.546);
    --anchor: 81%;
    --lr: clamp(64px, 8vw, 120px);
    position: relative;
    min-height: 100svh;
    color: var(--fg);
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
  }

  .stage {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    padding: clamp(24px, 4svh, 48px) var(--margin) clamp(40px, 9svh, 110px);
    transition: opacity 0.3s;
  }

  /* Until the script has set the scene, so the letters don't flash before they drop. */
  :global(html.js) .stage:not(.is-ready) {
    opacity: 0;
    animation: failsafe 0s 2.5s forwards;
  }

  @keyframes failsafe { to { opacity: 1; } }

  .name-wrap {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: start;
    gap: clamp(10px, 1.6svh, 18px);
    padding-left: clamp(0px, 3vw, 56px);
    max-width: 70%;
    /* Its box reaches over the reader on phones: only the real content takes touches. */
    pointer-events: none;
  }

  .name-wrap > :not(.card-zone) { pointer-events: auto; }

  .nav .id { color: var(--ink); }

  /* At the gate the menu is only the language switch: no empty glass bar. */
  :global(.gate) .nav ul {
    background: none;
    border-color: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  :global(.gate) .nav ul::before { display: none; }
  :global(.gate) .nav ul .gated { display: none; }

  .hello {
    font-size: clamp(24px, 2.6vw, 38px);
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
    rotate: -4deg;
    margin-bottom: calc(var(--u) * 0.04);
    text-shadow: 0 2px 0 #0b114033;
  }

  /* The name: one image per letter, each with its own size and baseline, set like type. */
  .name {
    display: grid;
    gap: calc(var(--u) * 0.16);
    line-height: 0;
    margin: 0;
  }

  .line {
    display: flex;
    align-items: flex-end;
  }

  .ch {
    flex: none;
    display: block;
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
    max-width: none;
    margin: 0 calc(var(--u) * -0.105) calc(var(--y0) * var(--u));
    transform-origin: 50% 88%;
    user-select: none;
    -webkit-user-drag: none;
    filter: drop-shadow(0 calc(var(--u) * 0.06) calc(var(--u) * 0.05) #0b11404d);
  }

  .line > .ch:first-child { margin-left: calc(var(--u) * -0.12); }
  .sp { flex: none; width: calc(var(--u) * 0.3); }

  /* A letter you touch wobbles like jelly. */
  .ch.is-wobble,
  .sticker img.is-wobble { animation: jelly 0.7s cubic-bezier(0.3, 0.7, 0.4, 1); }

  @keyframes jelly {
    0% { transform: none; }
    18% { transform: scale(1.14, 0.84); }
    36% { transform: scale(0.9, 1.12) translateY(-6%); }
    54% { transform: scale(1.06, 0.95); }
    72% { transform: scale(0.98, 1.03); }
    100% { transform: none; }
  }

  /* José's head is the O. */
  .face {
    position: relative;
    display: block;
  }

  .face-in {
    position: absolute;
    left: 50%;
    bottom: calc(var(--u) * 0.16);
    width: calc(var(--u) * 0.8);
    translate: -46% 0;
  }

  .face-in :global(.pp) {
    width: 100%;
    height: auto;
    max-width: none;
    overflow: visible;
    filter: drop-shadow(0 calc(var(--u) * 0.05) calc(var(--u) * 0.04) #0b11404d);
  }

  .role {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: calc(var(--u) * 0.06);
    font-weight: 800;
    font-stretch: 125%;
    font-size: clamp(13px, 1.15vw, 18px);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .role-name {
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--ink);
    box-shadow: inset 0 1.5px 0 #ffffffb3, inset 0 -2px 0 #0000001f, 0 6px 16px -6px #0b114080;
  }

  .role-place { opacity: 0.88; }

  .hero-tag {
    max-width: 34ch;
    font-size: var(--step-lead);
    line-height: 1.3;
    font-weight: 500;
    text-wrap: balance;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-actions .btn {
    background: var(--accent);
    color: var(--ink);
  }

  .hero-actions .btn:hover { background: #ffe066; }

  .btn-glass {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 26px;
    border-radius: var(--radius);
    color: var(--fg);
    font-weight: 700;
    font-size: var(--step-body);
    text-decoration: none;
    transition: transform 0.25s var(--ease-spring);
  }

  .btn-glass:hover { transform: translateY(-3px); }
  .hero .btn-glass.glass { background: linear-gradient(160deg, #ffffff40 0%, #ffffff12 50%, #ffffff26 100%); }

  /* ---------- Stickers ---------- */
  .stickers {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .sticker-li {
    position: absolute;
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
    width: min(calc(var(--s) * 1vw), calc(var(--s) * 1.75svh));
  }

  .sticker {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    pointer-events: auto;
    cursor: grab;
    touch-action: none;
    transform: translate(var(--dx, 0px), var(--dy, 0px)) rotate(calc(var(--r) + var(--dr, 0deg)));
    -webkit-tap-highlight-color: transparent;
  }

  .sticker img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ar);
    pointer-events: none;
    user-select: none;
    filter: drop-shadow(0 16px 14px #0b114059);
    animation: bob 5.5s ease-in-out infinite;
    animation-delay: calc(var(--d) * -1);
    transition: scale 0.45s cubic-bezier(0.34, 1.8, 0.5, 1), filter 0.3s;
  }

  @keyframes bob {
    50% { translate: 0 -7%; rotate: 4deg; }
  }

  .sticker:hover img,
  .sticker:focus-visible img { scale: 1.08; }

  .sticker.is-held { cursor: grabbing; z-index: 2; }

  .sticker.is-held img {
    scale: 1.14;
    animation-play-state: paused;
    filter: drop-shadow(0 34px 22px #0b114066);
  }

  .sticker:focus-visible { outline: 3px solid var(--accent); outline-offset: 6px; border-radius: 24px; }

  .sticker-tip {
    position: absolute;
    left: 50%;
    top: 96%;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px 6px 9px;
    border-radius: 999px;
    color: var(--ink);
    font-size: 13px;
    font-weight: 800;
    white-space: nowrap;
    translate: -50% 0;
    rotate: calc(var(--r) * -1 - var(--dr, 0deg));
    opacity: 0;
    scale: 0.7;
    transition: opacity 0.2s, scale 0.35s var(--ease-spring);
    pointer-events: none;
  }

  .sticker-tip::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c);
  }

  .hero .sticker-tip.glass { background: linear-gradient(160deg, #ffffffd9, #ffffffa6); }

  .sticker:hover .sticker-tip,
  .sticker:focus-visible .sticker-tip,
  .sticker.is-held .sticker-tip {
    opacity: 1;
    scale: 1;
  }

  /* ---------- The glass lens over the name ---------- */
  .lens {
    position: absolute;
    z-index: 4;
    left: 0;
    top: 0;
    width: calc(var(--lr) * 2);
    height: calc(var(--lr) * 2);
    margin: calc(var(--lr) * -1) 0 0 calc(var(--lr) * -1);
    border-radius: 50%;
    overflow: hidden;
    pointer-events: none;
    background: var(--scene-bg, #3e4fd0);
    box-shadow:
      inset 0 0 0 1.5px #ffffffd9,
      inset 0 12px 22px #ffffff59,
      inset 0 -16px 26px #0a12508c,
      0 26px 40px -16px #0a125099;
    opacity: 0;
    scale: 0.3;
    transition: opacity 0.25s, scale 0.5s cubic-bezier(0.34, 1.6, 0.5, 1);
    will-change: transform;
  }

  .lens.is-on { opacity: 1; scale: 1; }

  .lens.is-burst {
    opacity: 0;
    scale: 1.6;
    transition: opacity 0.3s ease-out, scale 0.3s ease-out;
  }

  .lens-in {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
  }

  .lens-in .name { pointer-events: none; }

  .lens-shine {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(58% 36% at 34% 18%, #ffffffa6, #fff0 70%),
      radial-gradient(closest-side, #fff0 82%, #ffffff3d 92%, #fff0 100%);
  }

  :global(.lens-drop) {
    position: absolute;
    z-index: 5;
    width: var(--sz, 14px);
    height: var(--sz, 14px);
    margin: calc(var(--sz, 14px) / -2) 0 0 calc(var(--sz, 14px) / -2);
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(circle at 35% 30%, #ffffffe6, #ffffff33 60%, #fff0);
    box-shadow: inset 0 0 0 1px #ffffffb3, 0 6px 10px -4px #0a125080;
    animation: lens-drop 0.75s cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
  }

  @keyframes lens-drop {
    0% { transform: translate(0, 0) scale(0.4); opacity: 1; }
    70% { opacity: 1; }
    100% { transform: translate(var(--tx), var(--ty)) scale(1); opacity: 0; }
  }

  /* ---------- José's cursor, showing what can be grabbed ---------- */
  .ghost {
    position: absolute;
    z-index: 5;
    left: 0;
    top: 0;
    display: flex;
    align-items: flex-start;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .ghost.is-on { opacity: 1; }

  .ghost svg {
    width: 26px;
    height: 26px;
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linejoin: round;
    filter: drop-shadow(0 3px 3px #0b114066);
  }

  .ghost-tag {
    margin: 20px 0 0 -6px;
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--ink);
    font-size: 13px;
    font-weight: 800;
    white-space: nowrap;
    box-shadow: inset 0 1px 0 #fff9, 0 6px 14px -6px #0b114099;
  }

  /* ---------- Intro ---------- */
  .intro {
    position: fixed;
    z-index: 300;
    inset: 0;
    display: none;
    cursor: pointer;
  }

  :global(html.intro) .intro { display: block; }

  .intro-paper {
    position: absolute;
    inset: 0 0 auto;
    height: 100%;
    display: grid;
    place-items: center;
    background-color: var(--ground);
    background-image: radial-gradient(circle at 1px 1px, #2a2a2e24 1px, transparent 1.4px);
    background-size: var(--grid) var(--grid);
    color: var(--ink);
    will-change: transform;
  }

  /* The paper's lower edge is a wave, so lifting it reads as liquid rising underneath. */
  .intro-edge {
    position: absolute;
    left: 0;
    top: calc(100% - 1px);
    width: 100%;
    height: 14svh;
    max-width: none;
    fill: var(--ground);
  }

  .intro-mark {
    display: flex;
    align-items: center;
    gap: 0.25em;
    font-size: clamp(30px, 4.4vw, 56px);
    font-weight: 900;
    font-stretch: 130%;
    letter-spacing: -0.02em;
  }

  .intro-face {
    display: block;
    width: 1.5em;
  }

  .intro-face :global(.pp) { width: 100%; height: auto; overflow: visible; }

  .intro-word span {
    display: inline-block;
    animation: wob 1.2s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.1s);
  }

  .intro-word sup {
    font-size: 0.36em;
    vertical-align: 1.3em;
  }

  @keyframes wob {
    50% { translate: 0 -0.1em; rotate: -5deg; }
  }

  .intro-load {
    position: absolute;
    left: 50%;
    bottom: 12svh;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 10px;
    font-family: var(--hand);
    font-size: 22px;
    font-weight: 600;
  }

  .intro-load i {
    position: relative;
    width: 160px;
    height: 5px;
    border-radius: 3px;
    background: #2a2a2e1f;
    overflow: hidden;
  }

  .intro-load i::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--ink);
    transform-origin: left;
    scale: var(--p, 0) 1;
  }

  .intro-skip {
    position: absolute;
    right: var(--margin);
    bottom: 18px;
    padding: 8px 12px;
    border: 0;
    background: none;
    color: var(--muted);
    font-size: 14px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  /* ---------- Placement of the card and the reader ---------- */
  .lanyard.is-waiting { visibility: hidden; }

  .reader {
    left: var(--anchor);
    bottom: clamp(40px, 8svh, 96px);
  }

  .reader-call {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    translate: -50% 0;
    font-size: 24px;
    font-weight: 700;
    white-space: nowrap;
    color: var(--fg);
    rotate: -2deg;
  }

  .gate-skip {
    left: var(--anchor);
    color: var(--fg);
    opacity: 0.8;
  }

  .gate-skip:hover { color: var(--accent); opacity: 1; }

  :global(html.intro) .reader,
  :global(html.intro) .gate-skip {
    opacity: 0;
    visibility: hidden;
  }

  .card-zone { display: none; }

  /* ---------- The gate (only with JS; html.gate is set in the head before paint) ---------- */
  :global(html.gate) { overflow: hidden; }
  :global(.gate) .hero { height: 100svh; }

  .gated {
    transition: opacity 0.6s var(--ease-out) calc(0.25s + var(--i, 0) * 0.12s), translate 0.8s var(--ease-out) calc(0.25s + var(--i, 0) * 0.12s), visibility 0s;
  }

  :global(.gate) .gated {
    opacity: 0;
    visibility: hidden;
    translate: 0 18px;
    transition: none;
  }

  :global(.gate) .reader,
  :global(.gate) .gate-skip {
    transition: opacity 0.4s;
  }

  :global(html:not(.gate)) .reader,
  :global(html:not(.gate)) .gate-skip {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  :global(html:not(.gate)) .reader { translate: -50% 40px; }

  @media (max-width: 1100px) {
    .hide-md { display: none; }
  }

  /* Narrow or tall screens: the name on top, the card under it, the reader at the bottom. */
  @media (max-width: 900px), (max-aspect-ratio: 1/1) {
    .hero {
      --u: min(13.4vw, 9svh, 110px);
      --anchor: 50%;
      --badge-w: min(70vw, 400px, 34svh);
      /* The strap runs down behind the name, so the card hangs just under it (fitStrap()
         measures the exact length; this is the guess before scripts). */
      --strap: calc(var(--u) * 2.6 + 190px);
    }

    .stage {
      align-items: flex-start;
      padding-top: clamp(8px, 2svh, 24px);
    }

    .name-wrap {
      max-width: none;
      width: 100%;
      justify-items: center;
      text-align: center;
      padding-left: 0;
    }

    .role { justify-content: center; }
    .hero-actions { justify-content: center; }
    /* The strap runs behind the name. */
    .lanyard { z-index: 1; }

    .card-zone {
      display: block;
      height: calc(var(--badge-h) + 70px);
    }

    .sticker-li {
      left: calc(var(--mx) * 1%);
      top: calc(var(--my) * 1%);
      width: calc(var(--ms) * 1vw);
    }

    .lens { display: none; }
  }

  @media (max-width: 760px) {
    .hide-sm { display: none; }
    .nav { padding-top: 12px; }
    .id-status { font-size: 16px; }
    .nav-cta { padding: 0 14px; font-size: 14px; }
    .reader-call { font-size: 20px; }
  }

  @media (max-width: 520px) {
    .id-text { display: none; }
    .id { padding: 5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticker img,
    .intro-word span { animation: none; }
  }

  /* ---------- Underwater gate (scripts/water.ts) ---------- */
  .water {
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, #4a8cf0 0%, #2f58d4 42%, #1d2c98 100%);
    will-change: transform;
  }

  :global(html:not(.gate)) .water:not(.is-draining),
  .water.is-gone { display: none; }

  .water-gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    mix-blend-mode: screen;
    opacity: 0.6;
  }

  .water.no-gl .water-gl { display: none; }

  /* Without WebGL: a slow shimmer of light instead of caustics. */
  .water.no-gl::before {
    content: '';
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(30% 20% at 30% 30%, #ffffff2e, #fff0 70%),
      radial-gradient(25% 18% at 70% 55%, #ffffff24, #fff0 70%),
      radial-gradient(35% 22% at 45% 80%, #ffffff1f, #fff0 70%);
    animation: shimmer 9s ease-in-out infinite alternate;
  }

  @keyframes shimmer { to { translate: 6% -4%; scale: 1.1; } }

  /* Light shafts from the surface. */
  .water-rays {
    position: absolute;
    inset: -10% -25% 25%;
    background: repeating-linear-gradient(104deg, #fff0 0 6%, #ffffff26 8.5%, #fff0 12%, #fff0 17%, #ffffff17 19%, #fff0 23%);
    filter: blur(8px);
    -webkit-mask-image: linear-gradient(#000, #0000 85%);
    mask-image: linear-gradient(#000, #0000 85%);
    mix-blend-mode: screen;
    animation: rays 11s ease-in-out infinite alternate;
  }

  @keyframes rays {
    0% { translate: -3% 0; opacity: 0.7; }
    100% { translate: 5% 0; opacity: 1; }
  }

  .bubs span {
    position: absolute;
    bottom: -40px;
    left: var(--x);
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, #ffffffe6 0 10%, #ffffff40 30%, #ffffff12 62%);
    box-shadow: inset 0 0 0 1px #ffffff80, inset -2px -3px 6px #ffffff26;
    animation: bub-rise var(--d) linear var(--dl) infinite;
  }

  @keyframes bub-rise {
    0% { transform: translate(0, 0) scale(0.6); opacity: 0; }
    8% { opacity: 1; }
    35% { transform: translate(var(--w), -38svh) scale(0.85, 1); }
    65% { transform: translate(calc(var(--w) * -0.6), -78svh) scale(1, 0.9); }
    100% { transform: translate(0, -120svh) scale(1.05); opacity: 0.25; }
  }

  /* A ring of light running out from the reader when the card is read. */
  .water-ring {
    position: absolute;
    left: var(--rx, 50%);
    top: var(--ry, 70%);
    width: 60px;
    height: 60px;
    margin: -30px 0 0 -30px;
    border-radius: 50%;
    border: 2px solid #ffffffb3;
    box-shadow: 0 0 24px #bfe6ff99, inset 0 0 18px #bfe6ff66;
    opacity: 0;
  }

  .water.is-rippling .water-ring { animation: water-ring 1.6s cubic-bezier(0.2, 0.7, 0.3, 1); }

  @keyframes water-ring {
    0% { transform: scale(0.3); opacity: 1; }
    100% { transform: scale(26); opacity: 0; }
  }

  .water.is-glow { filter: brightness(1.18) saturate(1.1); transition: filter 0.6s; }

  /* The surface: a wave along the water's top edge, sloshing sideways. It shows when the water drains. */
  .water-surface {
    position: absolute;
    left: 0;
    top: -44px;
    width: 200%;
    height: 46px;
    max-width: none;
    fill: #4a8cf0;
    animation: slosh 2.4s linear infinite;
  }

  @keyframes slosh { to { translate: -50% 0; } }

  .water.is-draining { animation: drain 1.3s cubic-bezier(0.6, 0, 0.35, 1) forwards; }

  @keyframes drain {
    0% { transform: translateY(0); }
    100% { transform: translateY(calc(100% + 60px)); }
  }

  :global(.bub-burst) {
    position: absolute;
    z-index: 6;
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(circle at 32% 28%, #ffffffee 0 10%, #ffffff4d 30%, #ffffff14 62%);
    box-shadow: inset 0 0 0 1px #ffffffa6;
    animation: bub-burst 1.4s cubic-bezier(0.2, 0.6, 0.3, 1) forwards;
  }

  @keyframes bub-burst {
    0% { transform: translate(0, 0) scale(0.3); opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; transform: translate(var(--dx), var(--dy)) scale(1); }
    100% { transform: translate(var(--dx), calc(var(--dy) - 20px)) scale(1.6); opacity: 0; }
  }

  .defs { position: absolute; width: 0; height: 0; }

  /* The card floats: it bobs and the water bends it. The laser calms it down to read it. */
  :global(html.gate) .badge { animation: buoy 5.5s ease-in-out infinite; }
  :global(html.gate) .cid:not(.is-scanning):not(.is-stamped) { filter: url(#underwater); }

  @keyframes buoy {
    50% { translate: 0 -12px; rotate: 1.6deg; }
  }

  /* At the gate the screen is empty but for the card, big and in the middle. */
  .badge { transition: width 0.9s var(--ease-out), height 0.9s var(--ease-out), left 0.9s var(--ease-out); }
  .stage.is-away { visibility: hidden; pointer-events: none; }

  :global(html.gate) .hero {
    --anchor: 50%;
    --badge-w: min(32vw, 470px, 50svh);
    --strap: calc(44svh - var(--badge-h) / 2 - 60px);
  }

  @media (max-width: 900px), (max-aspect-ratio: 1/1) {
    :global(html.gate) .hero {
      --badge-w: min(82vw, 440px, 40svh);
      --strap: calc(42svh - var(--badge-h) / 2 - 60px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .water-rays,
    .bubs span,
    .water-surface { animation: none; }
    :global(html.gate) .badge { animation: none; }
  }
</style>

<script>
  import { initLanyard } from '../scripts/lanyard';
  import { initScanner } from '../scripts/scanner';
  import { initLiquid } from '../scripts/liquid';
  import { initHero3d, fitStrap } from '../scripts/hero3d';
  fitStrap();
  initScanner(initLanyard());
  initLiquid();
  initHero3d();
  // The greeting on the tape, once the card has dropped in; a new lap gets a welcome back.
  const tape = document.querySelector<HTMLElement>('.badge .bubble');
  if (tape) {
    const lines: string[] = JSON.parse(tape.dataset.lines || '[]');
    const loopLine = tape.dataset.loopLine || '';
    const say = (t: string) => {
      tape.classList.remove('is-on');
      setTimeout(() => {
        tape.firstElementChild!.textContent = t;
        tape.classList.add('is-on');
      }, 160);
    };
    const greet = () => {
      const lap = Number(document.querySelector('[data-loop]')?.textContent || 1);
      setTimeout(() => say(lap > 1 && loopLine ? loopLine.replace('{name}', String(lap)) : lines[0]), 1100);
    };
    if (document.documentElement.classList.contains('intro')) window.addEventListener('jlp-drop', greet, { once: true });
    else greet();
    window.addEventListener('jlp-loop', (e) => setTimeout(() => say(loopLine.replace('{name}', String((e as CustomEvent<number>).detail))), 900));
  }
</script>
