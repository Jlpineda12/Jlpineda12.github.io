---
// The first screen is a gate. At first there is only José's Creative ID, hanging from a red lanyard
// on a retractable badge reel, and a glass reader below it. Drag the card down onto the reader (or
// tap either) and it is read and stamped with your lap: access granted. Then the gate opens: the
// card slides aside, his name and role play as a motion graphic made in Blender, and the menu and
// the way in appear. "Enter without scanning" opens it too, and nothing is gated without JS.
import Puppet from './Puppet.astro';
import { getData, t, type Lang } from '../i18n';
import LangSwitch from './LangSwitch.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { site } = getData(lang);
const ui = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// His pastel stars from the old portfolio, big and cropped, drifting behind everything.
const stars = [
  { x: -6, y: 10, s: 30, c: '#f4a7b9', r: -14, z: 1.4 },
  { x: 74, y: -12, s: 24, c: '#4cc3d9', r: 10, z: 0.8 },
  { x: 80, y: 50, s: 27, c: '#e2b84a', r: -22, z: 1.2 },
  { x: 4, y: 62, s: 19, c: '#a8d8b9', r: 16, z: 0.6 },
  { x: 44, y: -16, s: 13, c: '#a8d8b9', r: 32, z: 1 },
];
---
<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="stars" aria-hidden="true">
    {stars.map((st) => (
      <svg viewBox="0 0 100 100" style={`left:${st.x}%;top:${st.y}%;width:${st.s}vw;--r:${st.r}deg;--z:${st.z}`}>
        <path d="M50 4 L61.5 37.5 L97 38 L68.5 59.5 L79 94 L50 73.5 L21 94 L31.5 59.5 L3 38 L38.5 37.5 Z" fill={st.c} stroke={st.c} stroke-width="6" stroke-linejoin="round" />
      </svg>
    ))}
  </div>

  <header class="nav wrap">
    <a class="id" href="#inicio" aria-label={`José Luis Pineda, ${ui.home}`}>
      <span class="id-face" aria-hidden="true">
        <Puppet pose="calm" live={false} class="f-calm" />
        <Puppet pose="celebrate" live={false} class="f-joy" />
      </span>
      <span class="id-text">
        <span class="id-name">José Luis</span>
        <span class="id-status"><span class="dot" aria-hidden="true"></span>{ui.available}</span>
      </span>
    </a>
    <nav aria-label={ui.chapters}>
      <ul class="glass" data-liquid='{"bezel":16,"scale":30}'>
        <li class="hide-sm gated" style="--i:0"><a class="sketch-pill" href="#quien-soy">{ui.navAbout}</a></li>
        <li class="hide-sm gated" style="--i:1"><a class="sketch-pill" href="#proyectos">{ui.navWorlds}</a></li>
        <li class="hide-md gated" style="--i:2"><a class="sketch-pill" href="#como-trabajo">{ui.navProcess}</a></li>
        <li class="li-lang"><LangSwitch lang={lang} /></li>
        <li class="gated" style="--i:3"><a class="nav-cta" href="#contacto">{ui.writeMe}</a></li>
      </ul>
    </nav>
  </header>

  <div class="lanyard" data-lanyard>
    <div class="strap" aria-hidden="true"><span class="reel"></span></div>
    <span class="cord" aria-hidden="true"></span>
    <div class="swing">
      <svg class="clip" viewBox="0 0 60 92" aria-hidden="true">
        <rect x="16" y="0" width="28" height="18" rx="4" fill="#9aa0ad" />
        <circle cx="30" cy="30" r="13" fill="none" stroke="#b9bec8" stroke-width="7" />
        <path d="M22 40 L18 70 Q16 84 30 86 Q44 84 42 70 L38 40" fill="none" stroke="#c9cdd5" stroke-width="7" stroke-linecap="round" />
        <path d="M30 56 L30 74" stroke="#8b919d" stroke-width="5" stroke-linecap="round" />
      </svg>
      <div class="badge">
        <div class="badge-card cid">
          <img src={`${base}img/creative-id.webp`} width="889" height="575" fetchpriority="high" alt={ui.cidAlt} draggable="false" />
          <span class="slot" aria-hidden="true"></span>
          <span class="scan-beam" aria-hidden="true"></span>
          <span class="pass-stamp" aria-hidden="true"><b>{ui.reader.stamp}</b><small>{ui.reader.lap} 01</small></span>
          <p class="bubble tape" data-lines={JSON.stringify(ui.bubbles)} data-loop-line={ui.loopLine}><span>{ui.bubbles[0]}</span></p>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-copy wrap">
    <h1 class="hero-title" id="hero-title" style="--i:0">
      <span class="sr-only">{site.name.first} {site.name.last}, {site.role}.</span>
      <video class="title-mg" autoplay muted loop playsinline preload="auto" aria-hidden="true"
        poster={`${base}video/title-${lang}.jpg`} width="1440" height="720">
        <source src={`${base}video/title-${lang}.mp4`} type="video/mp4" />
      </video>
    </h1>
    <p class="hero-tag" style="--i:1">{ui.heroTag}</p>
    <p class="hero-actions" style="--i:2">
      <a class="btn" href="#quien-soy">{ui.start} <span class="arrow" aria-hidden="true">↓</span></a>
      <a class="btn-glass glass" href="#proyectos">{ui.navWorlds}</a>
    </p>
  </div>

  <div class="reader" data-reader data-state="idle" data-msg={JSON.stringify(ui.reader)}>
    <div class="reader-body glass" data-liquid>
      <button class="reader-pad" type="button" aria-label={ui.reader.btn} aria-describedby="reader-status">
        <span class="reader-window" aria-hidden="true">
          <span class="ring r1"></span><span class="ring r2"></span>
          <svg class="nfc" viewBox="0 0 48 48">
            <path d="M14 14 Q22 24 14 34" /><path d="M21 9 Q33 24 21 39" /><path d="M28 4 Q44 24 28 44" />
          </svg>
          <svg class="tick" viewBox="0 0 48 48"><path d="M12 25 L21 34 L37 15" /></svg>
        </span>
      </button>
      <p class="reader-status" id="reader-status" aria-live="polite">
        <span class="reader-name" aria-hidden="true">JLP · {ui.reader.label}</span>
        <span class="reader-line"><span class="led" aria-hidden="true"></span><span class="reader-text">{ui.reader.idle}</span></span>
        <span class="reader-sub">{ui.reader.sub}</span>
      </p>
    </div>
  </div>

  <button class="gate-skip hand" type="button">{ui.gateSkip}</button>
</section>

<style>
  .hero {
    --strap: clamp(84px, 13svh, 150px);
    --badge-w: min(34vw, 500px, 54svh);
    --badge-h: calc(var(--badge-w) / 1.546);
    position: relative;
    min-height: 100svh;
    color: var(--ink);
    overflow: hidden;
    isolation: isolate;
    /* Its own paper, so the title video can multiply onto it. */
    background-color: var(--ground);
    background-image: radial-gradient(circle at 1px 1px, #2a2a2e24 1px, transparent 1.4px);
    background-size: var(--grid) var(--grid);
    display: flex;
    flex-direction: column;
  }

  /* Pastel stars (his old portfolio's motif), drifting a little with the pointer. */
  .stars {
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
  }

  .stars svg {
    position: absolute;
    max-width: none;
    height: auto;
    rotate: var(--r);
    translate: calc(var(--px, 0) * var(--z) * 18px) calc(var(--py, 0) * var(--z) * 14px);
    animation: star-turn 28s ease-in-out infinite alternate;
    transition: translate 0.6s var(--ease-out);
  }

  .stars svg:nth-child(2n) { animation-duration: 36s; animation-direction: alternate-reverse; }

  @keyframes star-turn {
    to { rotate: calc(var(--r) + 14deg); }
  }

  /* ---------- Navigation ---------- */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 18px;
    position: relative;
    z-index: 3;
  }

  /* The menu is a liquid-glass bar; inside it the links are plain handwriting that lights up. */
  .nav ul {
    display: flex;
    gap: clamp(2px, 0.6vw, 8px);
    align-items: center;
    padding: 5px;
    border-radius: 999px;
  }

  .nav :global(.sketch-pill)::before {
    border-color: transparent;
    border-radius: 999px;
    rotate: 0deg;
    inset: 0;
  }

  .nav :global(.sketch-pill):hover::before,
  .nav :global(.sketch-pill):focus-visible::before {
    inset: 0;
    rotate: 0deg;
    background: #ffffffb3;
    box-shadow: inset 0 1px 0 #fff, 0 4px 10px -4px #2a2a2e40;
  }

  .nav :global(.lang-switch) { background: #ffffff8c; }

  /* José's tag: his face and name in a box drawn with a pen. */
  .id {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 6px;
    text-decoration: none;
    isolation: isolate;
  }

  .id::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--paper);
    border: 2.5px solid var(--ink);
    border-radius: 10px 14px 9px 12px;
    box-shadow: 3px 3px 0 var(--ink);
    rotate: -1.2deg;
    transition: rotate 0.3s var(--ease-spring);
  }

  .id:hover::before {
    rotate: 1deg;
  }

  .id-face {
    display: block;
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--sky);
    flex: none;
    transition: transform 0.4s var(--ease-spring);
  }

  .id-face :global(.pp) {
    position: absolute;
    left: 50%;
    bottom: -30%;
    width: 140%;
    max-width: none;
    height: auto;
    translate: -50% 0;
    transition: opacity 0.15s;
  }

  .id-face :global(.f-joy) { opacity: 0; }
  .id:hover .id-face { transform: rotate(-8deg) scale(1.08); }
  .id:hover .id-face :global(.f-joy) { opacity: 1; }
  .id:hover .id-face :global(.f-calm) { opacity: 0; }

  .id-text {
    display: grid;
    line-height: 1.1;
  }

  .id-name {
    font-weight: 900;
    font-stretch: 125%;
    font-size: 16px;
    text-transform: uppercase;
  }

  .id-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--hand);
    font-size: 18px;
    font-weight: 600;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3fbf6f;
    animation: live 2s ease-out infinite;
  }

  @keyframes live {
    0% { box-shadow: 0 0 0 0 #3fbf6faa; }
    100% { box-shadow: 0 0 0 9px #3fbf6f00; }
  }

  .nav :global(.lang-switch) {
    box-shadow: inset 0 1px 0 #fff, 0 0 0 1px #2a2a2e1f;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--paper);
    font-weight: 800;
    font-size: 15px;
    text-decoration: none;
    box-shadow: 3px 3px 0 var(--red);
    transition: transform 0.25s var(--ease-spring), box-shadow 0.25s var(--ease-spring);
  }

  .nav-cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--red);
  }

  /* ---------- The lanyard and badge ---------- */
  .lanyard {
    position: absolute;
    z-index: 2;
    left: var(--anchor, 50%);
    top: 0;
    width: 0;
    height: 0;
    transition: left 1s var(--ease-out);
  }

  .swing {
    --len: var(--strap);
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    will-change: transform;
  }

  .strap {
    position: absolute;
    left: -15px;
    top: -20px;
    width: 30px;
    height: calc(var(--strap-len, var(--strap)) + 24px);
    transform-origin: 15px 20px;
    rotate: var(--sa, 0deg);
    background:
      linear-gradient(90deg, #00000026 0 3px, #0000 3px calc(100% - 3px), #00000026 0),
      repeating-linear-gradient(0deg, #ffffff12 0 2px, #0000 2px 5px),
      var(--red);
  }

  /* The badge reel at the end of the strap; past it, a thin cord pulls out. */
  .reel {
    position: absolute;
    left: -2px;
    top: calc(100% - 18px);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, #2a2a2e 0 4px, #0000 4.5px),
      radial-gradient(circle at 35% 30%, #fff 0, #e6e8ee 30%, #a9aeb9 75%, #8b919d);
    box-shadow: 0 0 0 3px var(--red), 0 4px 6px #0000004d;
  }

  /* Drawn from the reel to the clip, wherever the card has been pulled. */
  .cord {
    position: absolute;
    left: -1px;
    top: 0;
    width: 2px;
    height: 0;
    border-radius: 2px;
    background: #2a2a2e;
    transform-origin: 1px 0;
  }

  .clip {
    position: absolute;
    left: -21px;
    top: calc(var(--len) - 6px);
    width: 42px;
    max-width: none;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 3px 2px #0000002e);
  }

  .badge {
    position: absolute;
    left: calc(var(--badge-w) / -2);
    top: calc(var(--len) + 50px);
    width: var(--badge-w);
    height: var(--badge-h);
    transform-origin: 50% -30px;
    perspective: 900px;
    /* The card can be dragged on phones too (onto the reader); the page scrolls from anywhere else. */
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .badge.is-grabbed {
    cursor: grabbing;
  }

  /* ---------- The Creative ID: José's own card from his old portfolio ---------- */
  .cid {
    position: absolute;
    inset: 0;
    container-type: inline-size;
    border-radius: 5cqw;
    box-shadow:
      0 2px 0 #0000000d,
      0 30px 50px -18px #2a2a2e66,
      0 70px 90px -40px #2a2a2e40;
    transform-style: preserve-3d;
  }

  .cid img {
    width: 100%;
    height: 100%;
    border-radius: 5cqw;
    pointer-events: none;
    -webkit-user-drag: none;
  }

  /* A punched slot for the clip. */
  .slot {
    position: absolute;
    left: 50%;
    top: 1.6cqw;
    width: 15cqw;
    height: 2.4cqw;
    translate: -50% 0;
    border-radius: 99px;
    background: #2a2a2e;
    box-shadow: 0 1px 0 #fff8, inset 0 2px 3px #000;
  }

  /* The greeting is written on a piece of yellow tape stuck across the card's corner. */
  .bubble {
    position: absolute;
    z-index: 3;
    left: -6cqw;
    top: -4cqw;
    max-width: 60cqw;
    rotate: -6deg;
    font-size: clamp(18px, 4cqw, 26px);
    transform-origin: 10% 50%;
    transition: transform 0.4s var(--ease-spring), opacity 0.25s;
    pointer-events: none;
  }

  :global(.js) .bubble { opacity: 0; transform: scale(0.5); }
  :global(.js) .bubble.is-on { opacity: 1; transform: none; }

  /* The reader's laser sweeping over the card, twice. */
  .scan-beam {
    position: absolute;
    z-index: 4;
    left: -2cqw;
    right: -2cqw;
    top: 0;
    height: 1.1cqw;
    border-radius: 99px;
    background: #ff5a4f;
    box-shadow: 0 0 1.2cqw 0.4cqw #ff5a4fb3, 0 0 6cqw 1.6cqw #ff5a4f40;
    opacity: 0;
    pointer-events: none;
  }

  .cid.beam-on .scan-beam {
    animation: beam 0.55s ease-in-out 2 alternate;
  }

  @keyframes beam {
    0% { top: 4%; opacity: 1; }
    100% { top: 94%; opacity: 1; }
  }

  .cid.is-scanning {
    box-shadow:
      0 0 0 0.6cqw #ff5a4f40,
      0 30px 50px -18px #2a2a2e66,
      0 70px 90px -40px #2a2a2e40;
  }

  /* The access stamp, in green ink, slammed over the photo once the card is read. */
  .pass-stamp {
    position: absolute;
    z-index: 3;
    left: 8cqw;
    top: 52cqw;
    display: grid;
    justify-items: center;
    padding: 1cqw 3cqw 1.2cqw;
    border: 0.7cqw double #23864f;
    border-radius: 1.6cqw;
    color: #23864f;
    font-weight: 900;
    font-stretch: 125%;
    line-height: 1;
    rotate: -11deg;
    mix-blend-mode: multiply;
    opacity: 0;
    scale: 2.4;
    pointer-events: none;
  }

  .pass-stamp b { font-size: 5.4cqw; letter-spacing: 0.06em; }
  .pass-stamp small { font-size: 2.4cqw; font-weight: 800; letter-spacing: 0.18em; }

  .cid.is-stamped .pass-stamp {
    opacity: 0.88;
    scale: 1;
    transition: scale 0.28s cubic-bezier(0.5, 0, 0.75, 0), opacity 0.12s;
  }

  /* ---------- The access reader (liquid glass) ---------- */
  /* A glass pill at the bottom of the gate; the card is pulled straight down onto its top edge. */
  .reader {
    --ok: #23864f;
    --beam: #ff5a4f;
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: clamp(56px, 10svh, 110px);
    translate: -50% 0;
    width: max-content;
    max-width: calc(100% - 2 * var(--margin));
    transition: opacity 0.4s, translate 0.6s var(--ease-out), visibility 0s 0.6s;
  }

  .reader-body {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 30px 10px 10px;
    border-radius: 999px;
  }

  .reader-pad {
    flex: none;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 50%;
    cursor: pointer;
  }

  .reader-window {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(60px, 7svh, 76px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, #ffffffb3, #ffffff26 70%);
    box-shadow: inset 0 2px 6px #2a2a2e33, inset 0 -2px 0 #ffffffcc, 0 0 0 1px #2a2a2e14;
    transition: box-shadow 0.3s, background-color 0.3s, scale 0.35s var(--ease-spring);
  }

  .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--sky);
    opacity: 0;
    animation: ping 2.4s var(--ease-out) infinite;
  }

  .ring.r2 { animation-delay: 1.2s; }

  @keyframes ping {
    0% { scale: 0.7; opacity: 0.9; }
    100% { scale: 1.6; opacity: 0; }
  }

  .nfc, .tick {
    width: 46%;
    height: auto;
    fill: none;
    stroke: var(--ink);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    grid-area: 1 / 1;
    transition: opacity 0.25s, scale 0.35s var(--ease-spring);
  }

  .nfc { rotate: -90deg; }
  .nfc path { animation: wave 1.8s ease-in-out infinite; }
  .nfc path:nth-child(2) { animation-delay: 0.15s; }
  .nfc path:nth-child(3) { animation-delay: 0.3s; }

  @keyframes wave {
    0%, 60%, 100% { opacity: 1; }
    30% { opacity: 0.25; }
  }

  .tick { stroke: var(--ok); stroke-width: 5; opacity: 0; scale: 0.4; }

  .reader-status {
    display: grid;
    gap: 2px;
    line-height: 1.15;
    min-width: 0;
  }

  .reader-line {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: clamp(15px, 1.2vw, 17px);
  }

  .led {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--sky);
    box-shadow: 0 0 0 3px #7c90da33;
    transition: background-color 0.2s, box-shadow 0.2s;
  }

  .reader-sub {
    min-height: 1.2em;
    font-family: var(--hand);
    font-size: 19px;
    font-weight: 600;
    color: var(--muted);
  }

  .reader-name {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #2a2a2e80;
    margin-bottom: 2px;
  }

  .reader-pad:hover .reader-window { scale: 1.06; }

  .reader[data-state='near'] .reader-window {
    scale: 1.12;
    background-color: #ffe14d66;
    box-shadow: inset 0 2px 6px #2a2a2e33, 0 0 0 4px #ffe14d, 0 0 40px #ffe14d;
  }
  .reader[data-state='near'] .led { background: #e2b84a; box-shadow: 0 0 0 3px #e2b84a55; }

  .reader[data-state='scan'] .reader-window { box-shadow: inset 0 2px 6px #2a2a2e33, 0 0 0 3px var(--beam), 0 0 36px #ff5a4f99; }
  .reader[data-state='scan'] .led { background: var(--beam); animation: blink 0.2s steps(2) infinite; }
  .reader[data-state='scan'] .ring { border-color: var(--beam); animation-duration: 0.8s; }

  .reader[data-state='ok'] .reader-window { box-shadow: inset 0 2px 6px #2a2a2e33, 0 0 0 3px var(--ok), 0 0 36px #23864f66; }
  .reader[data-state='ok'] .led { background: var(--ok); box-shadow: 0 0 0 3px #23864f40; }
  .reader[data-state='ok'] .ring { border-color: var(--ok); animation-iteration-count: 2; }
  .reader[data-state='ok'] .nfc { opacity: 0; scale: 0.5; }
  .reader[data-state='ok'] .tick { opacity: 1; scale: 1; }
  .reader[data-state='ok'] .reader-line { color: var(--ok); }

  @keyframes blink { 50% { opacity: 0.2; } }

  .gate-skip {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: clamp(14px, 3svh, 32px);
    translate: -50% 0;
    padding: 6px 12px;
    border: 0;
    background: none;
    font-size: 20px;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    cursor: pointer;
    transition: opacity 0.3s, visibility 0s 0.3s;
  }

  .gate-skip:hover { color: var(--ink); }

  /* ---------- After the gate: name, tagline and the way in ---------- */
  /* No z-index or transform here: the title video has to multiply onto the hero's paper. */
  .hero-copy {
    position: relative;
    margin-top: calc(var(--strap) + 50px + var(--badge-h) + 4px);
    padding-bottom: clamp(28px, 6svh, 64px);
    display: grid;
    justify-items: center;
    gap: clamp(12px, 2svh, 20px);
    text-align: center;
  }

  /* The name and role: a motion graphic made in Blender (3D, 2D, stop motion, looping). It is
     rendered on white and multiplied onto the page, so the white disappears and the shadows stay. */
  .hero-title {
    margin: 0;
    line-height: 0;
    width: min(100%, 620px);
  }

  .title-mg {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .hero-tag {
    max-width: 30ch;
    font-size: var(--step-lead);
    line-height: 1.3;
    font-weight: 500;
    text-wrap: balance;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .btn-glass {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 26px;
    border-radius: var(--radius);
    color: var(--ink);
    font-weight: 700;
    font-size: var(--step-body);
    text-decoration: none;
    transition: transform 0.25s var(--ease-spring);
  }

  .btn-glass:hover { transform: translateY(-3px); }

  /* ---------- The gate (only with JS; html.gate is set in the head before paint) ---------- */
  :global(html.gate) { overflow: hidden; }
  :global(.gate) .hero { height: 100svh; }

  .gated,
  .hero-copy > * {
    transition: opacity 0.6s var(--ease-out) calc(0.25s + var(--i, 0) * 0.12s), translate 0.8s var(--ease-out) calc(0.25s + var(--i, 0) * 0.12s), visibility 0s;
  }

  :global(.gate) .gated,
  :global(.gate) .hero-copy > * {
    opacity: 0;
    visibility: hidden;
    translate: 0 18px;
    transition: none;
  }

  :global(.gate) .reader,
  :global(.gate) .gate-skip {
    transition: opacity 0.4s;
  }

  :global(html:not(.gate)) .reader,
  :global(html:not(.gate)) .gate-skip {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  :global(html:not(.gate)) .reader { translate: -50% 40px; }

  /* Wide screens: once inside, the card slides right and the name takes the left. */
  @media (min-width: 1000px) and (min-aspect-ratio: 1/1) {
    :global(html:not(.gate)) .hero {
      --anchor: 71%;
    }

    .hero-copy {
      margin: auto 0;
      padding-block: 80px 40px;
      width: min(56%, 760px);
      justify-items: start;
      text-align: left;
    }

    .hero-title { width: 100%; }
    .title-mg { object-position: left center; }
    .hero-actions { justify-content: start; }
  }

  @media (max-width: 1100px) {
    .hide-md { display: none; }
  }

  /* Tablets standing up: more height to fill, so a bigger card and title. */
  @media (min-width: 761px) and (max-width: 1100px) and (min-aspect-ratio: 1/1.6) and (max-aspect-ratio: 1/1) {
    .hero {
      --strap: clamp(90px, 12svh, 160px);
      --badge-w: min(62vw, 560px, 44svh);
    }
  }

  @media (max-width: 760px) {
    .hide-sm { display: none; }

    .hero {
      --strap: clamp(64px, 13svh, 150px);
      --badge-w: min(92vw, 420px);
    }

    .nav { padding-top: 12px; }
    .id-status { font-size: 16px; }
    .nav-cta { padding: 0 14px; font-size: 14px; }
    .stars svg { scale: 1.7; }
    .hero-copy { margin-top: calc(var(--strap) + 50px + var(--badge-h) - 8px); }
    .hero-title { width: 100%; }
  }

  @media (max-width: 520px) {
    .id-text { display: none; }
    .id { padding: 5px; }
  }
</style>

<script>
  import { initLanyard } from '../scripts/lanyard';
  import { initScanner } from '../scripts/scanner';
  import { initLiquid } from '../scripts/liquid';
  initScanner(initLanyard());
  initLiquid();
  // The stars lean toward the pointer.
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    window.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      hero.style.setProperty('--px', ((e.clientX / innerWidth) * 2 - 1).toFixed(3));
      hero.style.setProperty('--py', ((e.clientY / innerHeight) * 2 - 1).toFixed(3));
    });
  }
  // The title loop plays only while it is on screen, and never with reduced motion.
  const mg = document.querySelector<HTMLVideoElement>('.title-mg');
  if (mg) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      mg.removeAttribute('autoplay');
      mg.pause();
    } else {
      new IntersectionObserver((e) => (e[0].isIntersecting ? mg.play().catch(() => {}) : mg.pause())).observe(mg);
    }
  }
  // The greeting on the tape; a new lap gets a welcome back. (The reader writes on it too.)
  const tape = document.querySelector<HTMLElement>('.badge .bubble');
  if (tape) {
    const lines: string[] = JSON.parse(tape.dataset.lines || '[]');
    const loopLine = tape.dataset.loopLine || '';
    const say = (t: string) => {
      tape.classList.remove('is-on');
      setTimeout(() => {
        tape.firstElementChild!.textContent = t;
        tape.classList.add('is-on');
      }, 160);
    };
    const lap = Number(document.querySelector('[data-loop]')?.textContent || 1);
    setTimeout(() => say(lap > 1 && loopLine ? loopLine.replace('{name}', String(lap)) : lines[0]), 1100);
    window.addEventListener('jlp-loop', (e) => setTimeout(() => say(loopLine.replace('{name}', String((e as CustomEvent<number>).detail))), 900));
  }
</script>
