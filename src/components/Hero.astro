---
// The first screen. An intro in the spirit of a title card: on cream, José's little mark wobbles
// while the world loads; then a cobalt liquid rises with a wavy edge and his name lands letter by
// letter, as puffy 3D letters made in Blender (blender/hero3d.py), with his own face as the "O".
// Glossy stickers for his worlds float around it; drag them, throw them, or tap one to open those
// projects. A glass lens follows the mouse over the name and bursts when clicked.
// The way in is one more sticker: his Creative ID. Carry it to the glass reader (or tap it): the
// laser reads it, the letters wobble like jelly as the access wave reaches them, and the page
// glides straight on to the next chapter.
// "Enter without scanning" opens it too, and nothing is gated without JS.
import Puppet from './Puppet.astro';
import { getData, t, type Lang } from '../i18n';
import LangSwitch from './LangSwitch.astro';
import h3d from '../data/hero3d.json';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { site, worlds } = getData(lang);
const ui = t(lang);
const h = ui.hero3d;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const L = h3d.letters as Record<string, { w: number; h: number; x0: number; y0: number }>;
const lines = [['J', 'O', 'S', 'E-acute', ' ', 'L', 'U', 'I', 'S'], ['P', 'I', 'N', 'E', 'D', 'A']];
const ls = (k: string) => `--w:${L[k].w};--h:${L[k].h};--y0:${L[k].y0}`;
const wname = Object.fromEntries(worlds.map((w) => [w.id, w.name]));
const wcol = Object.fromEntries(worlds.map((w) => [w.id, w.bg]));
// Where each sticker rests, in % of the stage, its turn and its width (vw on wide screens).
const stickers = [
  { id: 'mando', group: 'juegos', label: wname.juegos, x: 12, y: 14, r: -14, s: 12, d: 0, mx: 4, my: 2, ms: 22 },
  { id: 'visor', group: 'vr', label: wname.vr, x: 64, y: 10, r: 10, s: 11, d: 1.4, mx: 68, my: 1, ms: 22 },
  { id: 'gema', group: '3d', label: wname['3d'], x: 5, y: 50, r: 8, s: 9, d: 0.7, mx: 2, my: 34, ms: 16 },
  { id: 'chip', group: 'software', label: wname.software, x: 82, y: 58, r: -9, s: 9.5, d: 2.1, mx: 78, my: 35, ms: 17 },
  { id: 'claqueta', group: '3d', label: h.claqueta, x: 72, y: 76, r: 12, s: 9.5, d: 1, mx: 79, my: 60, ms: 17 },
];
const S = h3d.stickers as Record<string, { w: number; h: number }>;
---
<section class="hero" id="inicio" aria-labelledby="hero-title" data-scene="hero">
  <header class="nav wrap">
    <nav aria-label={ui.chapters}>
      <ul class="glass" data-liquid='{"bezel":16,"scale":30}'>
        <li class="li-lang"><LangSwitch lang={lang} /></li>
      </ul>
    </nav>
  </header>

  <div class="stage">
    <div class="name-wrap">
      <h1 class="name" id="hero-title" aria-label={`${site.name.first} ${site.name.last}`}>
        {lines.map((line) => (
          <span class="line" aria-hidden="true">
            {line.map((k) =>
              k === ' ' ? <span class="sp"></span>
              : k === 'O' ? (
                <span class="ch face" style={ls('O')}>
                  <span class="face-in"><Puppet pose="calm" view="450 660 780 700" class="face-pp" /></span>
                </span>
              ) : (
                <img class="ch" src={`${base}hero/l-${k}.webp`} style={ls(k)} alt="" draggable="false"
                  width={Math.round(L[k].w * 420)} height={Math.round(L[k].h * 420)} fetchpriority="high" />
              ))}
          </span>
        ))}
      </h1>
    </div>

    <ul class="stickers" aria-label={ui.navWorlds}>
      {stickers.map((s) => (
        <li class="sticker-li" style={`--x:${s.x};--y:${s.y};--mx:${s.mx};--my:${s.my};--ms:${s.ms};--r:${s.r}deg;--s:${s.s};--ar:${S[s.id].w / S[s.id].h};--d:${s.d}s;--c:${wcol[s.group]}`}>
          <button class="sticker" type="button" data-group={s.group} aria-label={`${h.open} ${s.label}`}>
            <img src={`${base}hero/s-${s.id}.webp`} alt="" draggable="false" loading="eager" />
            <span class="sticker-tip glass" aria-hidden="true">{s.label}</span>
          </button>
        </li>
      ))}
    </ul>

    <div class="lens" aria-hidden="true"><div class="lens-in"></div><span class="lens-shine"></span></div>
    <div class="ghost" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M4 2 L4 19 L8.5 15 L11.5 22 L14.5 20.7 L11.6 14 L18 14 Z" /></svg>
      <span class="ghost-tag" data-drag={h.drag} data-pass-hint={ui.reader.hintDrag}>{h.cursor}</span>
    </div>
  </div>

  <div class="pass" data-pass role="button" tabindex="0" aria-label={ui.reader.btn}>
    <div class="badge">
      <div class="badge-card cid">
        <img src={`${base}img/creative-id.webp`} width="889" height="575" alt={ui.cidAlt} draggable="false" />
        <span class="scan-beam" aria-hidden="true"></span>
        <span class="pass-stamp" aria-hidden="true"><b>{ui.reader.stamp}</b><small>{ui.reader.lap} 01</small></span>
        <p class="bubble tape" data-lines={JSON.stringify(ui.bubbles)} data-loop-line={ui.loopLine}><span>{ui.bubbles[0]}</span></p>
      </div>
    </div>
  </div>

  <div class="reader" data-reader data-state="idle" data-msg={JSON.stringify(ui.reader)}>
    <p class="reader-call hand" aria-hidden="true">{h.scan}</p>
    <div class="reader-body glass" data-liquid>
      <button class="reader-pad" type="button" aria-label={ui.reader.btn} aria-describedby="reader-status">
        <span class="reader-window" aria-hidden="true">
          <span class="ring r1"></span><span class="ring r2"></span>
          <svg class="nfc" viewBox="0 0 48 48">
            <path d="M14 14 Q22 24 14 34" /><path d="M21 9 Q33 24 21 39" /><path d="M28 4 Q44 24 28 44" />
          </svg>
          <svg class="tick" viewBox="0 0 48 48"><path d="M12 25 L21 34 L37 15" /></svg>
        </span>
      </button>
      <p class="reader-status" id="reader-status" aria-live="polite">
        <span class="reader-name" aria-hidden="true">JLP · {ui.reader.label}</span>
        <span class="reader-line"><span class="led" aria-hidden="true"></span><span class="reader-text">{ui.reader.idle}</span></span>
        <span class="reader-sub">{ui.reader.sub}</span>
      </p>
    </div>
  </div>

  <a class="enter-pill gated" href="#quien-soy" style="--i:1">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 2 L4 19 L8.5 15 L11.5 22 L14.5 20.7 L11.6 14 L18 14 Z" /></svg>
    <span>{ui.start} <span aria-hidden="true">↓</span></span>
  </a>

  <button class="gate-skip hand" type="button">{ui.gateSkip}</button>

  <div class="intro" aria-hidden="true">
    <div class="intro-paper">
      <div class="intro-mark">
        <span class="intro-face"><Puppet pose="calm" view="430 640 820 900" live={false} /></span>
        <span class="intro-word">{'José Luis Pineda'.split('').map((c, i) => <span style={`--i:${i}`}>{c === ' ' ? '\u00a0' : c}</span>)}<sup>®</sup></span>
      </div>
      <svg class="intro-edge" viewBox="0 0 1440 120" preserveAspectRatio="none"><path d="M0 0 H1440 V60 C1200 120 960 0 720 60 C480 120 240 0 0 60 Z" /></svg>
    </div>
    <button class="intro-skip" type="button" tabindex="-1">{h.skipIntro}</button>
  </div>
</section>

<style>
  /* ---------- Navigation ---------- */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 18px;
    position: relative;
    z-index: 3;
  }

  /* The menu is a liquid-glass bar; inside it the links are plain handwriting that lights up. */
  .nav ul {
    display: flex;
    gap: clamp(2px, 0.6vw, 8px);
    align-items: center;
    padding: 5px;
    border-radius: 999px;
  }

  .nav :global(.sketch-pill)::before {
    border-color: transparent;
    border-radius: 999px;
    rotate: 0deg;
    inset: 0;
  }

  .nav :global(.sketch-pill):hover::before,
  .nav :global(.sketch-pill):focus-visible::before {
    inset: 0;
    rotate: 0deg;
    background: #ffffffb3;
    box-shadow: inset 0 1px 0 #fff, 0 4px 10px -4px #2a2a2e40;
  }

  .nav :global(.lang-switch) { background: #ffffff8c; }

  /* José's tag: his face and name in a box drawn with a pen. */
  .id {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 6px;
    text-decoration: none;
    isolation: isolate;
  }

  .id::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--paper);
    border: 2.5px solid var(--ink);
    border-radius: 10px 14px 9px 12px;
    box-shadow: 3px 3px 0 var(--ink);
    rotate: -1.2deg;
    transition: rotate 0.3s var(--ease-spring);
  }

  .id:hover::before {
    rotate: 1deg;
  }

  .id-face {
    display: block;
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--sky);
    flex: none;
    transition: transform 0.4s var(--ease-spring);
  }

  .id-face :global(.pp) {
    position: absolute;
    left: 50%;
    bottom: -30%;
    width: 140%;
    max-width: none;
    height: auto;
    translate: -50% 0;
    transition: opacity 0.15s;
  }

  .id-face :global(.f-joy) { opacity: 0; }
  .id:hover .id-face { transform: rotate(-8deg) scale(1.08); }
  .id:hover .id-face :global(.f-joy) { opacity: 1; }
  .id:hover .id-face :global(.f-calm) { opacity: 0; }

  .id-text {
    display: grid;
    line-height: 1.1;
  }

  .id-name {
    font-weight: 900;
    font-stretch: 125%;
    font-size: 16px;
    text-transform: uppercase;
  }

  .id-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--hand);
    font-size: 18px;
    font-weight: 600;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3fbf6f;
    animation: live 2s ease-out infinite;
  }

  @keyframes live {
    0% { box-shadow: 0 0 0 0 #3fbf6faa; }
    100% { box-shadow: 0 0 0 9px #3fbf6f00; }
  }

  .nav :global(.lang-switch) {
    box-shadow: inset 0 1px 0 #fff, 0 0 0 1px #2a2a2e1f;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--paper);
    font-weight: 800;
    font-size: 15px;
    text-decoration: none;
    box-shadow: 3px 3px 0 var(--red);
    transition: transform 0.25s var(--ease-spring), box-shadow 0.25s var(--ease-spring);
  }

  .nav-cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--red);
  }

  /* ---------- The Creative ID: José's own card from his old portfolio ---------- */
  .cid {
    position: absolute;
    inset: 0;
    container-type: inline-size;
    border-radius: 5cqw;
    box-shadow:
      0 2px 0 #0000000d,
      0 30px 50px -18px #2a2a2e66,
      0 70px 90px -40px #2a2a2e40;
    transform-style: preserve-3d;
  }

  .cid img {
    width: 100%;
    height: 100%;
    border-radius: 5cqw;
    pointer-events: none;
    -webkit-user-drag: none;
  }

  /* A punched slot for the clip. */
  .slot {
    position: absolute;
    left: 50%;
    top: 1.6cqw;
    width: 15cqw;
    height: 2.4cqw;
    translate: -50% 0;
    border-radius: 99px;
    background: #2a2a2e;
    box-shadow: 0 1px 0 #fff8, inset 0 2px 3px #000;
  }

  /* The greeting is written on a piece of yellow tape stuck across the card's corner. */
  .bubble {
    position: absolute;
    z-index: 3;
    left: -6cqw;
    top: -4cqw;
    max-width: 60cqw;
    rotate: -6deg;
    font-size: clamp(18px, 4cqw, 26px);
    transform-origin: 10% 50%;
    transition: transform 0.4s var(--ease-spring), opacity 0.25s;
    pointer-events: none;
  }

  :global(.js) .bubble { opacity: 0; transform: scale(0.5); }
  :global(.js) .bubble.is-on { opacity: 1; transform: none; }

  /* The reader's laser sweeping over the card, twice. */
  .scan-beam {
    position: absolute;
    z-index: 4;
    left: -2cqw;
    right: -2cqw;
    top: 0;
    height: 1.1cqw;
    border-radius: 99px;
    background: #ff5a4f;
    box-shadow: 0 0 1.2cqw 0.4cqw #ff5a4fb3, 0 0 6cqw 1.6cqw #ff5a4f40;
    opacity: 0;
    pointer-events: none;
  }

  .cid.beam-on .scan-beam {
    animation: beam 0.55s ease-in-out 2 alternate;
  }

  @keyframes beam {
    0% { top: 4%; opacity: 1; }
    100% { top: 94%; opacity: 1; }
  }

  .cid.is-scanning {
    box-shadow:
      0 0 0 0.6cqw #ff5a4f40,
      0 30px 50px -18px #2a2a2e66,
      0 70px 90px -40px #2a2a2e40;
  }

  /* The access stamp, in green ink, slammed over the photo once the card is read. */
  .pass-stamp {
    position: absolute;
    z-index: 3;
    left: 8cqw;
    top: 52cqw;
    display: grid;
    justify-items: center;
    padding: 1cqw 3cqw 1.2cqw;
    border: 0.7cqw double #23864f;
    border-radius: 1.6cqw;
    color: #23864f;
    font-weight: 900;
    font-stretch: 125%;
    line-height: 1;
    rotate: -11deg;
    mix-blend-mode: multiply;
    opacity: 0;
    scale: 2.4;
    pointer-events: none;
  }

  .pass-stamp b { font-size: 5.4cqw; letter-spacing: 0.06em; }
  .pass-stamp small { font-size: 2.4cqw; font-weight: 800; letter-spacing: 0.18em; }

  .cid.is-stamped .pass-stamp {
    opacity: 0.88;
    scale: 1;
    transition: scale 0.28s cubic-bezier(0.5, 0, 0.75, 0), opacity 0.12s;
  }

  /* ---------- The access reader (liquid glass) ---------- */
  /* A glass pill at the bottom of the gate; the card is pulled straight down onto its top edge. */
  .reader {
    --ok: #23864f;
    --beam: #ff5a4f;
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: clamp(56px, 10svh, 110px);
    translate: -50% 0;
    width: max-content;
    max-width: calc(100% - 2 * var(--margin));
    transition: opacity 0.4s, translate 0.6s var(--ease-out), visibility 0s 0.6s;
  }

  .reader-body {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 30px 10px 10px;
    border-radius: 999px;
  }

  .reader-pad {
    flex: none;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 50%;
    cursor: pointer;
  }

  .reader-window {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(60px, 7svh, 76px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, #ffffffb3, #ffffff26 70%);
    box-shadow: inset 0 2px 6px #2a2a2e33, inset 0 -2px 0 #ffffffcc, 0 0 0 1px #2a2a2e14;
    transition: box-shadow 0.3s, background-color 0.3s, scale 0.35s var(--ease-spring);
  }

  .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--sky);
    opacity: 0;
    animation: ping 2.4s var(--ease-out) infinite;
  }

  .ring.r2 { animation-delay: 1.2s; }

  @keyframes ping {
    0% { scale: 0.7; opacity: 0.9; }
    100% { scale: 1.6; opacity: 0; }
  }

  .nfc, .tick {
    width: 46%;
    height: auto;
    fill: none;
    stroke: var(--ink);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    grid-area: 1 / 1;
    transition: opacity 0.25s, scale 0.35s var(--ease-spring);
  }

  .nfc { rotate: -90deg; }
  .nfc path { animation: wave 1.8s ease-in-out infinite; }
  .nfc path:nth-child(2) { animation-delay: 0.15s; }
  .nfc path:nth-child(3) { animation-delay: 0.3s; }

  @keyframes wave {
    0%, 60%, 100% { opacity: 1; }
    30% { opacity: 0.25; }
  }

  .tick { stroke: var(--ok); stroke-width: 5; opacity: 0; scale: 0.4; }

  .reader-status {
    display: grid;
    gap: 2px;
    line-height: 1.15;
    min-width: 0;
  }

  .reader-line {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: clamp(15px, 1.2vw, 17px);
  }

  .led {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--sky);
    box-shadow: 0 0 0 3px #7c90da33;
    transition: background-color 0.2s, box-shadow 0.2s;
  }

  .reader-sub {
    min-height: 1.2em;
    font-family: var(--hand);
    font-size: 19px;
    font-weight: 600;
    color: var(--muted);
  }

  .reader-name {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #2a2a2e80;
    margin-bottom: 2px;
  }

  .reader-pad:hover .reader-window { scale: 1.06; }

  .reader[data-state='near'] .reader-window {
    scale: 1.12;
    background-color: #ffe14d66;
    box-shadow: inset 0 2px 6px #2a2a2e33, 0 0 0 4px #ffe14d, 0 0 40px #ffe14d;
  }
  .reader[data-state='near'] .led { background: #e2b84a; box-shadow: 0 0 0 3px #e2b84a55; }

  .reader[data-state='scan'] .reader-window { box-shadow: inset 0 2px 6px #2a2a2e33, 0 0 0 3px var(--beam), 0 0 36px #ff5a4f99; }
  .reader[data-state='scan'] .led { background: var(--beam); animation: blink 0.2s steps(2) infinite; }
  .reader[data-state='scan'] .ring { border-color: var(--beam); animation-duration: 0.8s; }

  .reader[data-state='ok'] .reader-window { box-shadow: inset 0 2px 6px #2a2a2e33, 0 0 0 3px var(--ok), 0 0 36px #23864f66; }
  .reader[data-state='ok'] .led { background: var(--ok); box-shadow: 0 0 0 3px #23864f40; }
  .reader[data-state='ok'] .ring { border-color: var(--ok); animation-iteration-count: 2; }
  .reader[data-state='ok'] .nfc { opacity: 0; scale: 0.5; }
  .reader[data-state='ok'] .tick { opacity: 1; scale: 1; }
  .reader[data-state='ok'] .reader-line { color: var(--ok); }

  @keyframes blink { 50% { opacity: 0.2; } }

  .gate-skip {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: clamp(14px, 3svh, 32px);
    translate: -50% 0;
    padding: 6px 12px;
    border: 0;
    background: none;
    font-size: 20px;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    cursor: pointer;
    transition: opacity 0.3s, visibility 0s 0.3s;
  }

  .gate-skip:hover { color: var(--ink); }


  /* ---------- The stage ---------- */
  .hero {
    /* One letter unit: the size the Blender letters are laid out in. */
    --u: clamp(44px, min(12.6vw, 20svh), 196px);
    --strap: clamp(70px, 11svh, 130px);
    --badge-w: min(24vw, 380px, 40svh);
    --badge-h: calc(var(--badge-w) / 1.546);
    --anchor: 81%;
    --lr: clamp(64px, 8vw, 120px);
    position: relative;
    min-height: 100svh;
    color: var(--fg);
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
  }

  .stage {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(24px, 4svh, 48px) var(--margin) clamp(40px, 9svh, 110px);
    transition: opacity 0.3s;
  }

  /* Until the script has set the scene, so the letters don't flash before they drop. */
  :global(html.js) .stage:not(.is-ready) {
    opacity: 0;
    animation: failsafe 0s 2.5s forwards;
  }

  @keyframes failsafe { to { opacity: 1; } }

  .name-wrap {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: start;
    gap: clamp(10px, 1.6svh, 18px);
    justify-items: center;
    /* Its box reaches over the reader on phones: only the real content takes touches. */
    pointer-events: none;
  }

  .name-wrap > * { pointer-events: auto; }

  .nav .id { color: var(--ink); }

  /* At the gate the menu is only the language switch: no empty glass bar. */
  :global(.gate) .nav ul {
    background: none;
    border-color: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  :global(.gate) .nav ul::before { display: none; }
  :global(.gate) .nav ul .gated { display: none; }

  /* The name: one image per letter, each with its own size and baseline, set like type. */
  .name {
    display: grid;
    gap: calc(var(--u) * 0.16);
    line-height: 0;
    margin: 0;
  }

  .line {
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .ch {
    flex: none;
    display: block;
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
    max-width: none;
    margin: 0 calc(var(--u) * -0.105) calc(var(--y0) * var(--u));
    transform-origin: 50% 88%;
    user-select: none;
    -webkit-user-drag: none;
    filter: drop-shadow(0 calc(var(--u) * 0.06) calc(var(--u) * 0.05) #0b11404d);
  }

  .line > .ch:first-child { margin-left: calc(var(--u) * -0.12); }
  .sp { flex: none; width: calc(var(--u) * 0.3); }

  /* A letter you touch wobbles like jelly. */
  .ch.is-wobble,
  .sticker img.is-wobble { animation: jelly 0.7s cubic-bezier(0.3, 0.7, 0.4, 1); }

  @keyframes jelly {
    0% { transform: none; }
    18% { transform: scale(1.14, 0.84); }
    36% { transform: scale(0.9, 1.12) translateY(-6%); }
    54% { transform: scale(1.06, 0.95); }
    72% { transform: scale(0.98, 1.03); }
    100% { transform: none; }
  }

  /* José's head is the O. */
  .face {
    position: relative;
    display: block;
  }

  .face-in {
    position: absolute;
    left: 50%;
    bottom: calc(var(--u) * 0.15);
    width: calc(var(--u) * 0.74);
    translate: -40% 0;
