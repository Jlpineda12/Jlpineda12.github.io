---
// José's projects: a handheld console and a shelf of cartridges. Each cartridge is a real project, in
// the colour of its world. The first one is already in the console. Tap another on the shelf and it
// flies up into the slot, the console boots and the screen plays the project, while its card beside
// the console tells what it is. ← → (or the D-pad, or a swipe on the screen) switches projects;
// A plays it right there when it can (his digital human, a video) or opens it; B goes back to the
// cover.
import { getData, t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { projects, worlds } = getData(lang);
const ui = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// One colour per world, far apart on the wheel, so the groups read at a glance.
const CART: Record<string, { c: string; ink: string }> = {
  juegos: { c: '#c8372f', ink: '#ffffff' },
  vr: { c: '#4656d6', ink: '#ffffff' },
  '3d': { c: '#2f7a52', ink: '#ffffff' },
  software: { c: '#e2a91f', ink: '#2a2a2e' },
};
const groups = worlds.map((w) => w.id);
const list = groups.flatMap((g) => projects.filter((p) => p.world === g));
const world = Object.fromEntries(worlds.map((w) => [w.id, w]));
const total = list.length;
const num = (i: number) => String(i + 1).padStart(2, '0');
const first = list[0];
---
<section data-scene="projects" class="console-sec" id="proyectos" aria-labelledby="console-title" data-open={ui.projOpen}>
  <div class="pj">
    <header class="pj-head">
      <h2 class="c-head" id="console-title">{ui.consoleTitle}</h2>
    </header>

    <div class="pj-main">
      <!-- The console: the cartridge in its slot, the screen between the D-pad and A/B. -->
      <div class="device" data-device style={`--c:${CART[first.world].c}`}>
        <div class="slot" aria-hidden="true">
          <span class="slot-cart" style={`--c:${CART[first.world].c}`}>
            <span class="c-ridges"></span>
            <span class="c-label"><img src={`${base}${first.poster}`} width="1400" height="900" alt="" /></span>
          </span>
        </div>
        <div class="body">
          <div class="ctrl ctrl-l">
            <div class="dpad" role="group" aria-label={ui.pickCart}>
              <span class="dp-h" aria-hidden="true"></span>
              <span class="dp-v" aria-hidden="true"></span>
              <button class="dp-btn dp-l" type="button" data-step="-1" aria-label={ui.prev}><i aria-hidden="true"></i></button>
              <button class="dp-btn dp-r" type="button" data-step="1" aria-label={ui.next}><i aria-hidden="true"></i></button>
            </div>
            <span class="grille" aria-hidden="true"><i></i><i></i><i></i></span>
          </div>

          <div class="bezel">
            <p class="bz-top" aria-hidden="true"><span class="led"></span>JLP <b>STATION</b></p>
            <div class="screen" aria-live="polite">
              <img class="scr-img" src={`${base}${first.poster}`} width="1400" height="900" alt="" decoding="async" />
              <video class="scr-vid" muted loop playsinline preload="none" hidden></video>
              <div class="scr-embed"></div>
              <div class="scr-boot" aria-hidden="true"><span>JLP</span></div>
              <p class="scr-hud">
                <span class="scr-n">{num(0)}/{String(total).padStart(2, '0')}</span>
                <span class="scr-t">{first.name}</span>
                <span class="scr-a"><b>A</b> <span class="scr-a-l">{first.embed ? ui.projPlay : first.youtube ? ui.projVideo : ui.projOpen}</span></span>
              </p>
              <span class="scr-glass" aria-hidden="true"></span>
            </div>
          </div>

          <div class="ctrl ctrl-r">
            <div class="ab">
              <button class="bt bt-b" type="button" data-b aria-label={ui.btnB}>B</button>
              <button class="bt bt-a" type="button" data-a aria-label={ui.btnA}>A</button>
            </div>
            <span class="pills" aria-hidden="true"><i></i><i></i></span>
          </div>
        </div>
      </div>

      <!-- The card of the project in the console. -->
      <div class="infos">
        {list.map((p, i) => (
          <article class="info" data-i={i} hidden={i !== 0} aria-labelledby={`pj-${i}`} style={`--cc:${CART[p.world].c}`} data-fp-free>
            <p class="i-top">
              <span class="i-world"><i aria-hidden="true"></i>{world[p.world].name}</span>
              {p.isNew && <span class="i-new">{ui.newTag}</span>}
              <span class="i-num">{num(i)} / {String(total).padStart(2, '0')}</span>
            </p>
            <h3 class="i-name" id={`pj-${i}`}>{p.name}</h3>
            <p class="i-kind">{p.kind}{p.year && ` · ${p.year}`}{p.status && ` · ${p.status}`}</p>
            <p class="i-sum">{p.summary}</p>
            <button class="i-more" type="button" data-more={ui.projMore} data-less={ui.projLess}>{ui.projMore}</button>
            <ul class="i-stack">{p.stack.map((s) => <li>{s}</li>)}</ul>
            {p.models && (
              <ul class="i-models" aria-label={ui.pickModel}>
                {p.models.map((m) => (
                  <li><button type="button" data-model={m.uid} data-title={m.name} title={m.name}>
                    <img src={`${base}img/sketchfab/${m.uid}.jpg`} width="640" height="360" loading="lazy" alt={m.name} />
                  </button></li>
                ))}
              </ul>
            )}
            <div class="i-actions">
              {(p.embed || p.youtube) && (
                <button class="btn i-play" type="button" data-play>{p.embed ? ui.projPlay : ui.projVideo} <span aria-hidden="true">▶</span></button>
              )}
              <a class="btn i-cta" href={p.url} target="_blank" rel="noopener">{p.linkLabel} <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- The shelf: every project as a cartridge. -->
    <div class="shelf">
      <ul class="carts" aria-label={ui.pickCart}>
        {list.map((p, i) => (
          <li data-world={p.world}>
            <button
              class:list={['cart', { 'is-in': i === 0 }]}
              type="button"
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-label={p.name}
              title={p.name}
              data-i={i}
              data-name={p.name}
              data-poster={`${base}${p.poster}`}
              data-video={p.video ? `${base}${p.video}` : undefined}
              data-youtube={p.youtube}
              data-embed={p.embed}
              data-url={p.url}
              style={`--c:${CART[p.world].c};--cink:${CART[p.world].ink}`}
            >
              <span class="c-ridges" aria-hidden="true"></span>
              <span class="c-label" aria-hidden="true"><img src={`${base}${p.poster}`} width="1400" height="900" loading="lazy" alt="" draggable="false" /></span>
              <span class="c-num" aria-hidden="true">{num(i)}</span>
              {p.isNew && <span class="c-new" aria-hidden="true">★</span>}
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .console-sec { position: relative; }

  .pj {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(10px, 2svh, 22px);
    width: min(100% - 2 * var(--margin), 1180px);
    margin-inline: auto;
  }

  /* ---------- Heading and world tabs ---------- */
  .pj-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 10px 24px;
  }

  /* ---------- Console and card ---------- */
  .pj-main {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(16px, 3vw, 44px);
  }

  /* The console: a matte handheld, the cartridge standing in its slot on top. */
  .device {
    --c: #6b4fd8;
    position: relative;
    width: min(100%, calc((100svh - 362px) * 2.05));
    justify-self: center;
    padding-top: 8.2%;
  }

  .slot {
    position: absolute;
    left: 50%;
    top: 0;
    width: 15%;
    translate: -50% 0;
  }

  .slot-cart {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 0.86;
    border-radius: 10px 10px 6px 6px;
    background: linear-gradient(100deg, #ffffff40, #fff0 35%, #00000020), var(--c);
    clip-path: polygon(0 0, 84% 0, 100% 10%, 100% 100%, 0 100%);
    box-shadow: inset 0 3px 0 #ffffff40;
    transition: background-color 0.3s;
  }

  .body {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 21% minmax(0, 1fr) 21%;
    align-items: center;
    aspect-ratio: 2.15;
    margin-top: -1px;
    padding: 3.2% 1.6%;
    border-radius: 16% 16% 14% 14% / 36% 36% 32% 32%;
    background:
      radial-gradient(90% 70% at 30% 10%, #ffffff, #fff0 60%),
      linear-gradient(170deg, #f7f4ff, #e2dbf6);
    box-shadow:
      inset 0 3px 0 #fff,
      inset 0 -10px 18px -8px #b9acdf,
      0 2px 0 #cfc5ee,
      0 40px 60px -30px #4b2f9a73;
  }

  /* Its edge picks up the colour of the cartridge in it. */
  .body::after {
    content: '';
    position: absolute;
    inset: auto 18% -3px;
    height: 6px;
    border-radius: 0 0 99px 99px;
    background: var(--c);
    opacity: 0.85;
    transition: background-color 0.4s;
  }

  .ctrl { position: relative; display: grid; justify-items: center; align-content: center; gap: 14%; height: 100%; }

  /* D-pad: a cross; left and right switch projects. */
  .dpad { position: relative; width: 62%; aspect-ratio: 1; }
  .dp-h, .dp-v { position: absolute; border-radius: 7px; background: linear-gradient(#3a3846, #24222e); box-shadow: 0 3px 0 #14131a, inset 0 1px 0 #ffffff1f; }
  .dp-h { left: 0; right: 0; top: 33%; height: 34%; }
  .dp-v { top: 0; bottom: 0; left: 33%; width: 34%; }

  .dp-btn {
    position: absolute;
    top: 33%;
    width: 36%;
    height: 34%;
    padding: 0;
    border: 0;
    border-radius: 7px;
    background: transparent;
    cursor: pointer;
  }

  .dp-l { left: 0; }
  .dp-r { right: 0; }
  .dp-btn i { position: absolute; left: 50%; top: 50%; width: 0; height: 0; translate: -50% -50%; border: 5px solid transparent; }
  .dp-l i { border-right-color: #ffffff70; border-left-width: 0; }
  .dp-r i { border-left-color: #ffffff70; border-right-width: 0; }
  .dp-btn:active, .dp-btn.is-down { background: #ffffff1a; translate: 0 2px; }
  .dp-btn:focus-visible { outline: 2px solid var(--c); outline-offset: 2px; }

  .grille { display: flex; gap: 6%; width: 46%; justify-content: center; rotate: -20deg; }
  .grille i { width: 4px; height: 22px; border-radius: 4px; background: #c9bfe6; box-shadow: inset 0 1px 1px #8f82b8; }

  /* A and B. */
  .ab { display: flex; align-items: center; gap: 10%; width: 84%; justify-content: center; rotate: -18deg; }

  .bt {
    display: grid;
    place-items: center;
    width: 40%;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: #ffffffd9;
    font: inherit;
    font-size: clamp(11px, 1.2vw, 16px);
    font-weight: 900;
    cursor: pointer;
    rotate: 18deg;
    transition: translate 0.1s, box-shadow 0.1s;
  }

  .bt-a { margin-top: -26%; background: radial-gradient(circle at 35% 30%, color-mix(in oklab, var(--c) 70%, #fff), var(--c)); box-shadow: 0 4px 0 color-mix(in oklab, var(--c) 60%, #000), inset 0 1px 0 #ffffff60; }
  .bt-b { margin-top: 26%; background: radial-gradient(circle at 35% 30%, #5a5868, #2f2d3a); box-shadow: 0 4px 0 #17161d, inset 0 1px 0 #ffffff30; }
  .bt:active, .bt.is-down { translate: 0 3px; box-shadow: 0 1px 0 #0006; }
  .bt:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  .pills { display: flex; gap: 12%; width: 60%; justify-content: center; rotate: -18deg; }
  .pills i { width: 34%; height: 7px; border-radius: 9px; background: #c4b9e2; box-shadow: inset 0 1px 1px #8f82b8; }

  /* The screen. */
  .bezel {
    padding: 3% 4% 4.5%;
    border-radius: 14px 14px 18px 18px;
    background: linear-gradient(#26242f, #1a1922);
    box-shadow: inset 0 0 0 1px #ffffff12, 0 1px 0 #fff;
  }

  .bz-top {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 3%;
    font-size: clamp(8px, 0.7vw, 10px);
    font-weight: 900;
    letter-spacing: 0.2em;
    color: #ffffff59;
  }

  .bz-top b { color: var(--c); transition: color 0.4s; }
  .led { width: 6px; height: 6px; border-radius: 50%; background: #3fdc7a; box-shadow: 0 0 8px #3fdc7a; }

  .screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 6px;
    background: #0d0c12;
    container-type: inline-size;
  }

  .scr-img,
  .scr-vid,
  .scr-embed,
  .scr-embed :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }

  .scr-embed:empty { display: none; }
  .scr-embed { z-index: 2; background: #000; }

  .scr-hud {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 18px 10px 8px;
    background: linear-gradient(#0000, #000000b3);
    color: #fff;
    font-size: clamp(10px, 2.4cqi, 14px);
    font-weight: 800;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .scr-embed:not(:empty) ~ .scr-hud { opacity: 0; }
  .scr-n { padding: 2px 6px; border-radius: 4px; background: #ffffff26; font-variant-numeric: tabular-nums; }
  .scr-t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .scr-a { display: inline-flex; align-items: center; gap: 5px; opacity: 0.85; }
  .scr-a b { display: grid; place-items: center; width: 1.6em; height: 1.6em; border-radius: 50%; background: var(--c); font-size: 0.85em; }

  .scr-glass {
    position: absolute;
    z-index: 4;
    inset: 0;
    background: linear-gradient(115deg, #ffffff1c, #fff0 35%);
    pointer-events: none;
  }

  /* Booting: a flash and the logo, then the game. */
  .scr-boot {
    position: absolute;
    z-index: 5;
    inset: 0;
    display: grid;
    place-items: center;
    background: #f7f4ff;
    color: var(--c);
    font-size: clamp(22px, 11cqi, 64px);
    font-weight: 900;
    font-stretch: 125%;
    letter-spacing: -0.03em;
    opacity: 0;
    pointer-events: none;
  }

  .screen.is-booting .scr-boot { animation: boot 0.75s ease-out; }
  .screen.is-booting .scr-boot span { animation: bootlogo 0.75s cubic-bezier(0.3, 1.5, 0.5, 1); }

  @keyframes boot {
    0% { opacity: 1; background: #fff; }
    55% { opacity: 1; }
    100% { opacity: 0; }
  }

  @keyframes bootlogo {
    0% { translate: 0 -60%; opacity: 0; }
    35% { translate: 0 0; opacity: 1; }
    100% { opacity: 1; }
  }

  /* ---------- The project's card ---------- */
  .infos { position: relative; min-width: 0; }

  .info {
    max-height: calc(100svh - 385px);
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding: clamp(16px, 2vw, 26px);
    border-radius: 24px;
    background: #ffffffc7;
    box-shadow: inset 0 1px 0 #fff, 0 20px 40px -26px #4b2f9a66;
    color: var(--ink);
  }

  .info:not([hidden]) { animation: info-in 0.45s cubic-bezier(0.3, 0.9, 0.3, 1); }
  @keyframes info-in { from { opacity: 0; translate: 16px 0; } }

  .i-top { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; font-size: 12px; font-weight: 800; }
  .i-world { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 99px; background: color-mix(in oklab, var(--cc) 14%, #fff); color: color-mix(in oklab, var(--cc) 80%, #000); }
  .i-world i { width: 8px; height: 8px; border-radius: 50%; background: var(--cc); }
  .i-new { padding: 4px 9px; border-radius: 99px; background: #ffd23f; color: #2a2a2e; }
  .i-num { margin-left: auto; color: #2a2a2e80; font-variant-numeric: tabular-nums; }

  .i-name { font-size: clamp(1.4rem, 1rem + 1.4vw, 2.2rem); font-weight: 900; font-stretch: 112%; letter-spacing: -0.02em; line-height: 1.05; }
  .i-kind { margin-top: 4px; font-size: 14px; font-weight: 700; color: #2a2a2e99; }

  .i-sum {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.5;
    color: #2a2a2ed0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .info.is-open .i-sum { -webkit-line-clamp: unset; display: block; }

  .i-more { margin-top: 4px; padding: 0; border: 0; background: none; color: var(--cc); font: inherit; font-size: 13px; font-weight: 800; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }

  .i-stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .i-stack li { padding: 4px 10px; border-radius: 99px; background: #2a2a2e0d; font-size: 12px; font-weight: 700; }

  .i-models { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 12px; }
  .i-models button { display: block; width: 100%; padding: 0; border: 2px solid transparent; border-radius: 10px; overflow: hidden; background: none; cursor: pointer; transition: border-color 0.2s, translate 0.2s; }
  .i-models button:hover { border-color: var(--cc); translate: 0 -2px; }
  .i-models img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }

  .i-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }

  .i-play,
  .i-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    cursor: pointer;
    transition: translate 0.2s, box-shadow 0.2s;
  }

  .i-cta { background: var(--ink); color: #fff; box-shadow: 0 4px 0 #000; }
  .i-play { background: var(--cc); color: #fff; box-shadow: 0 4px 0 color-mix(in oklab, var(--cc) 60%, #000); }
  .i-play:hover, .i-cta:hover { translate: 0 -2px; }
  .i-play:active, .i-cta:active { translate: 0 3px; box-shadow: none; }

  /* ---------- The shelf ---------- */
  .shelf { display: grid; justify-items: center; gap: 6px; min-width: 0; container-type: inline-size; }

  .carts {
    display: flex;
    justify-content: safe center;
    gap: clamp(6px, 0.9vw, 12px);
    max-width: 100%;
    margin: 0;
    padding: 14px 6px 10px;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    /* The shelf itself: a soft ledge under the cartridges. */
    background: linear-gradient(#0000 70%, #ffffff8c 70%, #ffffff40);
    border-radius: 0 0 18px 18px;
  }

  .carts::-webkit-scrollbar { display: none; }
  .carts li { flex: none; }

  .cart {
    position: relative;
    display: block;
    width: clamp(54px, min(6.5cqi, 9svh), 86px);
    aspect-ratio: 0.86;
    padding: 0;
    border: 0;
    border-radius: 9px 9px 6px 6px;
    background: linear-gradient(100deg, #ffffff40, #fff0 35%, #00000024), var(--c);
    clip-path: polygon(0 0, 84% 0, 100% 10%, 100% 100%, 0 100%);
    box-shadow: inset 0 -6px 0 #00000030, inset 0 2px 0 #ffffff40;
    cursor: pointer;
    transition: translate 0.25s cubic-bezier(0.3, 1.5, 0.5, 1), opacity 0.3s, filter 0.3s;
  }

  .cart:hover { translate: 0 -8px; }
  .cart:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }

  /* The one in the console leaves an empty place on the shelf. */
  .cart.is-in { opacity: 0.25; filter: grayscale(0.6); translate: 0 6px; }

  .c-ridges {
    position: absolute;
    left: 14%;
    right: 22%;
    top: 5%;
    height: 7%;
    border-radius: 3px;
    background: repeating-linear-gradient(90deg, #00000030 0 3px, #0000 3px 7px);
  }

  .c-label {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 18%;
    bottom: 18%;
    overflow: hidden;
    border-radius: 4px;
    background: #fff;
    box-shadow: 0 0 0 2px #ffffffd9;
  }

  .c-label img { width: 100%; height: 100%; object-fit: cover; }

  .c-num { position: absolute; left: 10%; bottom: 4%; font-size: 9px; font-weight: 900; color: var(--cink); opacity: 0.85; }
  .c-new { position: absolute; right: 8%; bottom: 3%; font-size: 10px; color: #ffd23f; text-shadow: 0 1px 0 #0006; }

  .slot-cart .c-label { bottom: 46%; }


  /* ---------- Tablets and phones: console on top, card under it, shelf at the bottom ---------- */
  @media (max-aspect-ratio: 1/1), (max-width: 900px) {
    .pj-main { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .device { width: min(100%, 560px, calc((100svh - 450px) * 2)); }
    .info { max-height: none; }
    .infos { max-height: min(32svh, 320px); overflow: hidden; display: grid; }
    .info { overflow-y: auto; }
    .i-sum { -webkit-line-clamp: 3; font-size: 14px; }
  }

  @media (max-width: 700px) {
    .pj-head { gap: 8px; }
    .info { padding: 14px 16px; border-radius: 18px; }
    .i-name { font-size: 1.3rem; }
    .i-kind { font-size: 12px; }
    .i-stack { display: none; }
    .i-actions { margin-top: 10px; }
    .i-play, .i-cta { min-height: 38px; padding: 0 13px; font-size: 13px; }
    .carts { justify-content: flex-start; padding-top: 10px; }
    .grille { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .info:not([hidden]) { animation: none; }
    .screen.is-booting .scr-boot, .screen.is-booting .scr-boot span { animation: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const sec = document.querySelector<HTMLElement>('.console-sec');
  const device = sec?.querySelector<HTMLElement>('[data-device]');
  const screen = sec?.querySelector<HTMLElement>('.screen');
  if (sec && device && screen) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const slotCart = device.querySelector<HTMLElement>('.slot-cart')!;
    const slotImg = slotCart.querySelector<HTMLImageElement>('img')!;
    const img = screen.querySelector<HTMLImageElement>('.scr-img')!;
    const vid = screen.querySelector<HTMLVideoElement>('.scr-vid')!;
    const embed = screen.querySelector<HTMLElement>('.scr-embed')!;
    const hudN = screen.querySelector<HTMLElement>('.scr-n')!;
    const hudT = screen.querySelector<HTMLElement>('.scr-t')!;
    const hudA = screen.querySelector<HTMLElement>('.scr-a-l')!;
    const carts = [...sec.querySelectorAll<HTMLButtonElement>('.carts .cart')];
    const infos = [...sec.querySelectorAll<HTMLElement>('.info')];
    const total = carts.length;
    const pad = (n: number) => String(n).padStart(2, '0');
    let active = 0;
    let busy = false;

    // A little sound: a click as the cartridge goes in, two notes as the console boots.
    let ac: AudioContext | null = null;
    const sfx = (kind: 'in' | 'boot') => {
      try {
        ac ??= new AudioContext();
        const t = ac.currentTime;
        const tone = (at: number, f: number, d: number, v: number) => {
          const o = ac!.createOscillator();
          const g = ac!.createGain();
          o.type = 'square';
          o.frequency.value = f;
          g.gain.setValueAtTime(v, t + at);
          g.gain.exponentialRampToValueAtTime(0.0001, t + at + d);
          o.connect(g).connect(ac!.destination);
          o.start(t + at);
          o.stop(t + at + d);
        };
        if (kind === 'in') tone(0, 140, 0.05, 0.05);
        else { tone(0, 988, 0.08, 0.03); tone(0.09, 1319, 0.16, 0.03); }
      } catch {}
    };

    const stopMedia = () => {
      embed.innerHTML = '';
      vid.pause();
    };

    // What the screen shows for a project: its animated cover if it has one, its picture if not.
    const paint = (i: number) => {
      stopMedia();
      const c = carts[i];
      img.src = c.dataset.poster || '';
      if (c.dataset.video) {
        vid.src = c.dataset.video;
        vid.hidden = false;
        vid.play().catch(() => {});
      } else {
        vid.removeAttribute('src');
        vid.hidden = true;
      }
      hudN.textContent = `${pad(i + 1)}/${pad(total)}`;
      hudT.textContent = c.dataset.name || '';
      const info = infos[i];
      const play = info.querySelector('.i-play');
      hudA.textContent = play ? (play.textContent || '').replace('▶', '').trim() : sec.dataset.open || hudA.textContent;
    };

    const setSlot = (i: number) => {
      const c = carts[i];
      const col = c.style.getPropertyValue('--c');
      slotCart.style.setProperty('--c', col);
      device.style.setProperty('--c', col);
      slotImg.src = c.dataset.poster || '';
    };

    const setInfo = (i: number) => {
      infos.forEach((a, k) => {
        a.hidden = k !== i;
        if (k === i) {
          a.scrollTop = 0;
          a.classList.remove('is-open');
          const more = a.querySelector<HTMLElement>('.i-more');
          if (more) more.textContent = more.dataset.more || '';
        }
      });
    };

    const boot = () => {
      screen.classList.remove('is-booting');
      void screen.offsetWidth;
      screen.classList.add('is-booting');
      sfx('boot');
    };

    const bump = () => gsap.fromTo(device, { y: 0 }, { y: 3, duration: 0.07, yoyo: true, repeat: 1, ease: 'power1.out' });

    const mark = (i: number) =>
      carts.forEach((c, k) => {
        c.classList.toggle('is-in', k === i);
        c.setAttribute('aria-pressed', String(k === i));
      });

    // Putting a project in the console: from the shelf it flies up into the slot; from the D-pad
    // the cartridge in the slot pops out and the next one drops in.
    const select = (i: number, how: 'fly' | 'swap' | 'none' = 'swap') => {
      if (busy || (i === active && how !== 'none')) return;
      active = i;
      mark(i);
      setInfo(i);
      const done = () => {
        bump();
        sfx('in');
        boot();
        paint(i);
        busy = false;
      };
      if (reduced || how === 'none') {
        setSlot(i);
        paint(i);
        return;
      }
      busy = true;
      const to = slotCart.getBoundingClientRect();
      if (how === 'fly') {
        const from = carts[i].getBoundingClientRect();
        const ghost = carts[i].cloneNode(true) as HTMLElement;
        ghost.classList.remove('is-in');
        ghost.setAttribute('aria-hidden', 'true');
        Object.assign(ghost.style, { position: 'fixed', left: `${from.left}px`, top: `${from.top}px`, width: `${from.width}px`, height: `${from.height}px`, zIndex: '200', margin: '0', translate: 'none', pointerEvents: 'none' });
        document.body.appendChild(ghost);
        const tl = gsap.timeline();
        tl.to(slotCart, { y: -to.height * 0.9, opacity: 0, duration: 0.22, ease: 'power2.in' }, 0)
          .to(ghost, {
            x: to.left - from.left + (to.width - from.width) / 2,
            y: to.top - from.top - to.height * 0.7 + (to.height - from.height) / 2,
            scale: to.width / from.width,
            rotate: -6,
            duration: 0.5,
            ease: 'power3.inOut',
          }, 0.05)
          .to(ghost, { rotate: 0, duration: 0.12 }, 0.55)
          .call(() => {
            setSlot(i);
            gsap.set(slotCart, { y: -to.height * 0.7, opacity: 1 });
            ghost.remove();
          }, [], 0.62)
          .to(slotCart, { y: 0, duration: 0.18, ease: 'power2.in' }, 0.62)
          .call(done, [], 0.8);
      } else {
        gsap.timeline()
          .to(slotCart, { y: -to.height * 0.75, duration: 0.18, ease: 'power2.in' })
          .call(() => setSlot(i))
          .to(slotCart, { y: 0, duration: 0.18, ease: 'power2.in' })
          .call(done);
      }
    };

    const shown = () => carts.map((c) => Number(c.dataset.i));
    const step = (k: number) => {
      const list = shown();
      if (!list.length) return;
      const at = list.indexOf(active);
      const next = list[(((at < 0 ? 0 : at + k) % list.length) + list.length) % list.length];
      select(next, 'swap');
      carts[next].scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    };

    carts.forEach((c) => c.addEventListener('click', () => select(Number(c.dataset.i), 'fly')));

    const press = (el: Element | null) => {
      if (!el) return;
      el.classList.add('is-down');
      setTimeout(() => el.classList.remove('is-down'), 140);
    };
    sec.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => step(Number(b.dataset.step))));

    // A: play it right here when it can be (his digital human, a video), otherwise open it.
    const play = () => {
      const c = carts[active];
      if (c.dataset.embed) {
        vid.pause();
        embed.innerHTML = `<iframe title="${c.dataset.name}" allow="autoplay; fullscreen" src="${c.dataset.embed}"></iframe>`;
      } else if (c.dataset.youtube) {
        vid.pause();
        embed.innerHTML = `<iframe title="${c.dataset.name}" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen
          src="https://www.youtube-nocookie.com/embed/${c.dataset.youtube}?autoplay=1&rel=0&modestbranding=1&playsinline=1"></iframe>`;
      } else if (c.dataset.url) {
        window.open(c.dataset.url, '_blank', 'noopener');
      }
    };
    sec.querySelector('[data-a]')?.addEventListener('click', play);
    sec.querySelector('[data-b]')?.addEventListener('click', () => paint(active));
    infos.forEach((info) => {
      info.querySelector('[data-play]')?.addEventListener('click', play);
      const more = info.querySelector<HTMLElement>('.i-more');
      const sum = info.querySelector<HTMLElement>('.i-sum');
      // "Read more" only where the text is really cut.
      if (more && sum) {
        const check = () => (more.hidden = !info.classList.contains('is-open') && sum.scrollHeight <= sum.clientHeight + 2);
        more.addEventListener('click', () => {
          info.classList.toggle('is-open');
          more.textContent = info.classList.contains('is-open') ? more.dataset.less || '' : more.dataset.more || '';
        });
        new ResizeObserver(check).observe(sum);
      }
      // 3D models load in the screen.
      info.querySelectorAll<HTMLButtonElement>('[data-model]').forEach((m) =>
        m.addEventListener('click', () => {
          vid.pause();
          embed.innerHTML = `<iframe title="${m.dataset.title} 3D" allow="autoplay; fullscreen; xr-spatial-tracking" allowfullscreen
            src="https://sketchfab.com/models/${m.dataset.model}/embed?autostart=1&ui_theme=dark&ui_hint=2&dnt=1"></iframe>`;
        }),
      );
    });

    // Keys: ← → switch projects, Enter/A plays (only while this chapter is on screen).
    addEventListener('keydown', (e) => {
      if (document.documentElement.dataset.slide !== 'proyectos' || e.metaKey || e.ctrlKey || e.altKey) return;
      const inField = !!(e.target as Element).closest('input, textarea, select, [contenteditable="true"]');
      if (inField) return;
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        e.preventDefault();
        press(sec.querySelector(e.key === 'ArrowLeft' ? '.dp-l' : '.dp-r'));
        step(e.key === 'ArrowLeft' ? -1 : 1);
      } else if ((e.target as Element).closest('button, a')) {
        return;
      } else if (e.key.toLowerCase() === 'a') {
        press(sec.querySelector('.bt-a'));
        play();
      } else if (e.key.toLowerCase() === 'b') {
        press(sec.querySelector('.bt-b'));
        paint(active);
      }
    });

    // A swipe across the screen switches projects too.
    let sx = 0, sy = 0;
    screen.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
    screen.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      const dy = e.changedTouches[0].clientY - sy;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.4 && !embed.innerHTML) step(dx < 0 ? 1 : -1);
    }, { passive: true });

    // Arriving: the console boots (the cartridge transition says when its cartridge has gone in);
    // leaving: the screen goes quiet.
    let bootTimer = 0;
    addEventListener('fp-enter-proyectos', () => {
      clearTimeout(bootTimer);
      bootTimer = window.setTimeout(() => { boot(); paint(active); }, 1000);
    });
    addEventListener('proj-inserted', () => {
      clearTimeout(bootTimer);
      bump();
      sfx('in');
      boot();
      paint(active);
    });
    addEventListener('fp-change', (e) => {
      if ((e as CustomEvent<{ id: string }>).detail.id !== 'proyectos') {
        clearTimeout(bootTimer);
        stopMedia();
      }
    });
    paint(0);
  }
</script>
