</style>

<script>
  import { gsap } from 'gsap';
  import { mountPuppet, type Anim } from '../scripts/puppet';

  const sec = document.querySelector<HTMLElement>('.console-sec');
  const consoleEl = sec?.querySelector<HTMLElement>('[data-console]');
  const screen = sec?.querySelector<HTMLElement>('.screen');
  const carts = [...(sec?.querySelectorAll<HTMLButtonElement>('.cart') ?? [])];
  const manuals = [...(sec?.querySelectorAll<HTMLElement>('.manual') ?? [])];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (sec && consoleEl && screen && carts.length) {
    const img = screen.querySelector<HTMLImageElement>('.scr-img')!;
    const vid = screen.querySelector<HTMLVideoElement>('.scr-vid')!;
    const embed = screen.querySelector<HTMLElement>('.scr-embed')!;
    const boot = screen.querySelector<HTMLElement>('.scr-boot')!;
    const title = screen.querySelector<HTMLElement>('.scr-title')!;
    const slotCart = consoleEl.querySelector<HTMLElement>('.slot-cart')!;
    const aBtn = consoleEl.querySelector<HTMLButtonElement>('[data-a]')!;
    const bBtn = consoleEl.querySelector<HTMLButtonElement>('[data-b]')!;
    const peekSvg = sec.querySelector<SVGSVGElement>('.peek svg.pp')!;
    const peek = sec.querySelector<HTMLElement>('.peek')!;
    const puppet = mountPuppet(peekSvg, 'idle');
    const REACT: Record<string, Anim> = { juegos: 'play', vr: 'vr', '3d': 'sculpt', software: 'code' };
    const n = carts.length;
    let active = -1; // the console starts empty
    let busy = false;
    let seen = false;

    const pad = (i: number) => String(i + 1).padStart(2, '0');

    // Copies of a cartridge (the one flying, the one in the slot) need its world colours.
    const dress = (el: HTMLElement, i: number) => {
      const li = carts[i].closest('li')!;
      for (const v of ['--c', '--cink', '--c2']) el.style.setProperty(v, li.style.getPropertyValue(v));
    };
    const copyOf = (i: number) => {
      const k = carts[i].cloneNode(true) as HTMLElement;
      k.classList.remove('is-in');
      // Drop its data and labels, but keep Astro's scoping attribute so it keeps its styles.
      for (const a of [...k.attributes]) {
        if ((a.name.startsWith('data-') && !a.name.startsWith('data-astro-cid')) || a.name.startsWith('aria-')) k.removeAttribute(a.name);
      }
      k.tabIndex = -1;
      k.style.transform = 'none';
      return k;
    };
    const setSlot = (c: HTMLButtonElement) => {
      const i = carts.indexOf(c);
      slotCart.replaceChildren(copyOf(i));
      dress(slotCart, i);
    };

    // The console's sounds: a plastic click out, a clack in, and a two-note boot. Short and quiet,
    // and only ever after someone has touched something.
    let ac: AudioContext | null = null;
    const sfx = (kind: 'out' | 'in' | 'boot') => {
      try {
        ac ??= new AudioContext();
        const t0 = ac.currentTime;
        const noise = (dur: number, freq: number, vol: number) => {
          const b = ac!.createBuffer(1, Math.ceil(ac!.sampleRate * dur), ac!.sampleRate);
          const d = b.getChannelData(0);
          for (let k = 0; k < d.length; k++) d[k] = (Math.random() * 2 - 1) * (1 - k / d.length) ** 3;
          const src = ac!.createBufferSource();
          const f = ac!.createBiquadFilter();
          const g = ac!.createGain();
          src.buffer = b;
          f.type = 'bandpass';
          f.frequency.value = freq;
          g.gain.value = vol;
          src.connect(f).connect(g).connect(ac!.destination);
          src.start(t0);
        };
        const tone = (at: number, freq: number, dur: number, vol: number, type: OscillatorType = 'square') => {
          const o = ac!.createOscillator();
          const g = ac!.createGain();
          o.type = type;
          o.frequency.setValueAtTime(freq, t0 + at);
          g.gain.setValueAtTime(vol, t0 + at);
          g.gain.exponentialRampToValueAtTime(0.0001, t0 + at + dur);
          o.connect(g).connect(ac!.destination);
          o.start(t0 + at);
          o.stop(t0 + at + dur + 0.02);
        };
        if (kind === 'out') noise(0.05, 3200, 0.5);
        if (kind === 'in') {
          noise(0.06, 1600, 0.9);
          tone(0, 110, 0.1, 0.25, 'sine');
        }
        if (kind === 'boot') {
          tone(0, 1047, 0.08, 0.035);
          tone(0.09, 2093, 0.4, 0.035);
        }
      } catch {}
    };
    const buzz = (p: number | number[]) => {
      try {
        navigator.vibrate?.(p);
      } catch {}
    };
    const rig3d = consoleEl.parentElement!;
    const bump = () => gsap.fromTo(rig3d, { y: 0 }, { y: 4, duration: 0.06, yoyo: true, repeat: 1, ease: 'power1.out' });

    const stopMedia = () => {
      vid.pause();
      embed.innerHTML = '';
    };

    // Put cartridge i's content on the screen.
    const paint = (i: number) => {
      const c = carts[i];
      stopMedia();
      consoleEl.classList.remove('is-empty');
      img.hidden = false;
      if (c.dataset.poster) img.src = c.dataset.poster;
      if (c.dataset.video && !reduced) {
        vid.hidden = false;
        if (vid.dataset.src !== c.dataset.video) {
          vid.dataset.src = c.dataset.video;
          vid.poster = c.dataset.poster || '';
          vid.src = c.dataset.video;
        }
        vid.play().catch(() => {});
      } else {
        vid.hidden = true;
      }
      title.textContent = c.dataset.name || '';
      aBtn.setAttribute('aria-label', c.dataset.label || aBtn.getAttribute('aria-label') || 'A');
      manuals.forEach((m, k) => m.classList.toggle('is-on', k === i));
      carts.forEach((b, k) => {
        b.classList.toggle('is-in', k === i);
        b.setAttribute('aria-pressed', String(k === i));
      });
      setSlot(c);
      peek.classList.add('is-up');
      puppet.play((c.dataset.react as Anim) || REACT[c.dataset.world || ''] || 'happy');
    };

    // Static, the console's boot screen, then the game.
    const bootUp = (i: number, quick = false) =>
      new Promise<void>((done) => {
        if (reduced) {
          paint(i);
          return done();
        }
        screen.classList.add('is-static');
        setTimeout(() => {
          screen.classList.remove('is-static');
          paint(i);
          boot.hidden = false;
          sfx('boot');
          gsap.fromTo(boot.children, { y: -30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.35, stagger: 0.08, ease: 'back.out(2)' });
          setTimeout(() => {
            gsap.to(boot, {
              opacity: 0,
              duration: 0.25,
              onComplete: () => {
                boot.hidden = true;
                boot.style.opacity = '';
                done();
              },
            });
          }, quick ? 380 : 750);
        }, 220);
      });

    // Slotting a cartridge in, the way it feels with a real one: the old one clicks out, the new one
    // arcs over and lines up above the slot, slides in with a little friction and seats with a clack
    // (the console jolts, phones buzz), the power light comes on and the console boots.
    const insert = async (i: number) => {
      i = ((i % n) + n) % n;
      if (busy || i === active) return;
      busy = true;
      const from = carts[i];
      const cr = consoleEl.getBoundingClientRect();
      if (cr.top < 0 || cr.bottom > innerHeight) {
        consoleEl.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
        // Let the page arrive before the cartridge flies, so it lands in the slot.
        if (!reduced) await new Promise((r) => setTimeout(r, 480));
      }

      // Out with the old one.
      if (active >= 0) {
        stopMedia();
        screen.classList.add('is-off');
        consoleEl.classList.remove('is-on');
        // Nothing of the old game is left on the screen.
        img.hidden = true;
        vid.hidden = true;
        title.textContent = '';
        if (!reduced) {
          sfx('out');
          buzz(8);
          await gsap.to(slotCart, { '--seat': -150, duration: 0.3, ease: 'back.in(1.7)' }).then();
        }
      }
      gsap.set(slotCart, { opacity: 0, '--seat': -150 });
      slotCart.classList.remove('is-out');
      setSlot(from);

      if (reduced) {
        from.classList.add('is-in');
        gsap.set(slotCart, { opacity: 1, '--seat': -46 });
      } else {
        // In flight: from where it is to just above the slot, at the size it will have there.
        const r = from.getBoundingClientRect();
        const s = slotCart.getBoundingClientRect();
        const fly = copyOf(i);
        dress(fly, i);
        fly.classList.add('cart-fly');
        fly.setAttribute('aria-hidden', 'true');
        Object.assign(fly.style, { left: `${r.left}px`, top: `${r.top}px`, width: `${r.width}px`, height: `${r.height}px` });
        document.body.appendChild(fly);
        from.classList.add('is-in');
        const top = Math.min(r.top, s.top) - Math.min(120, innerHeight * 0.12);
        await gsap
          .timeline()
          .to(fly, { left: (r.left + s.left) / 2, top, width: (r.width + s.width) / 2, height: (r.height + s.height) / 2, rotate: -9, duration: 0.34, ease: 'power2.out' })
          .to(fly, { left: s.left, top: s.top, width: s.width, height: s.height, rotate: 0, duration: 0.3, ease: 'power2.inOut' })
          .then();
        // Hand over to the cartridge standing in the slot, which can go behind the shell.
        gsap.set(slotCart, { opacity: 1 });
        fly.remove();
        await gsap
          .timeline()
          .to(slotCart, { '--seat': -62, duration: 0.34, ease: 'power1.in' })
          .call(() => {
            sfx('in');
            buzz(18);
            bump();
            consoleEl.classList.add('is-on');
          })
          .to(slotCart, { '--seat': -40, duration: 0.06, ease: 'power2.out' })
          .to(slotCart, { '--seat': -46, duration: 0.16, ease: 'power2.out' })
          .then();
      }

      consoleEl.classList.add('is-on');
      screen.classList.remove('is-off');
      if (wrapD(i - goal) !== 0 && !held) spinTo(Math.round(goal) + wrapD(i - goal));
      active = i;
      await bootUp(i, true);
      busy = false;
    };

    // ---------- The carousel ----------
    const car = sec.querySelector<HTMLElement>('[data-carousel]')!;
    const ring = car.querySelector<HTMLElement>('.turntable')!;
    const items = [...ring.querySelectorAll<HTMLElement>(':scope > li')];
    const STEP = 32; // degrees between cartridges
    let pos = n > 1 ? 1 : 0; // the carousel's angle, in cartridges; start with the next one in front
    let vel = 0;
    let goal = pos;
    let spinRaf = 0;
    let held: { i: number; x: number; y: number; dx: number; dy: number } | null = null;

    const wrapD = (d: number) => ((((d + n / 2) % n) + n) % n) - n / 2;
    const front = () => ((Math.round(pos) % n) + n) % n;

    const dots = [...sec.querySelectorAll<HTMLElement>('.pager li')];
    const chips = [...sec.querySelectorAll<HTMLButtonElement>('.chip')];
    let shown = -1;
    let smear = 0;
    const layout = () => {
      const f = front();
      // Smear follows the speed with a little lag, so it eases in and wobbles out.
      const want = reduced ? 0 : Math.max(-1, Math.min(1, vel * 5));
      smear += (want - smear) * 0.25;
      if (Math.abs(smear) < 0.002) smear = 0;
      if (f !== shown) {
        shown = f;
        car.style.setProperty('--fc', getComputedStyle(items[f]).getPropertyValue('--c'));
        dots.forEach((d, k) => d.classList.toggle('is-on', k === f));
        chips.forEach((c) => c.classList.toggle('is-on', c.dataset.group === carts[f].dataset.world));
      }
      const w = items[0].offsetWidth;
      const R = w * 1.5;
      items.forEach((li, i) => {
        const d = wrapD(i - pos);
        const a = d * STEP;
        const hidden = Math.abs(a) > 105;
        const x = R * Math.sin(a * Math.PI / 180);
        // The one in front steps forward off the turntable.
        const z = R * (Math.cos(a * Math.PI / 180) - 1) + Math.max(0, 1 - Math.abs(d)) * w * 0.18;
        let extra = '';
        if (held && held.i === i) {
          const tilt = Math.max(-18, Math.min(18, held.dx * 0.04));
          extra = ` translate3d(${held.dx}px, ${held.dy}px, 60px) rotate(${tilt}deg) scale(1.04)`;
        }
        // Liquid: while the turntable spins, the cartridges lean and stretch into the motion,
        // the further from the front the more, and settle back like jelly when it stops.
        const lean = smear * (0.35 + Math.min(1, Math.abs(d)));
        const goo = lean ? ` skewY(${(lean * 9).toFixed(2)}deg) scale(${(1 + Math.abs(lean) * 0.1).toFixed(3)}, ${(1 - Math.abs(lean) * 0.06).toFixed(3)})` : '';
        li.style.transform = `translate(-50%, -50%)${extra} translate3d(${x.toFixed(1)}px, 0, ${z.toFixed(1)}px) rotateY(${a.toFixed(2)}deg)${goo}`;
        li.style.zIndex = String(held?.i === i ? 200 : 100 - Math.round(Math.abs(d) * 10));
        li.style.opacity = hidden ? '0' : '1';
        li.style.pointerEvents = hidden ? 'none' : '';
        li.style.filter = `brightness(${(1 - Math.min(3, Math.abs(d)) * 0.1).toFixed(2)})`;
        const isFront = Math.abs(d) < 0.5;
        li.classList.toggle('is-front', isFront);
        li.querySelector('button')!.tabIndex = isFront ? 0 : -1;
      });
    };

    // A spring carries the carousel to the nearest cartridge once it is let go.
    const spin = () => {
      spinRaf = 0;
      if (!spinning) {
        const f = (goal - pos) * 0.16;
        vel = vel * 0.72 + f;
        pos += vel;
        if (Math.abs(goal - pos) < 0.001 && Math.abs(vel) < 0.001) {
          pos = goal;
          vel = 0;
        }
      }
      // Carrying near the top or bottom of the screen scrolls the page (the console may be below).
      if (held && mode === 'carry') {
        const edge = 90;
        const k = lastY > innerHeight - edge ? (lastY - (innerHeight - edge)) / edge : lastY < edge ? (lastY - edge) / edge : 0;
        if (k) window.scrollBy(0, k * 16);
        held.dy = lastY - downY + (scrollY - downScroll);
        consoleEl.classList.toggle('is-target', overConsole(lastX, lastY));
      }
      layout();
      if (spinning || held || pos !== goal || smear) spinRaf = requestAnimationFrame(spin);
    };
    const kick = () => {
      if (!spinRaf) spinRaf = requestAnimationFrame(spin);
    };
    // The highlight on the front cartridge follows the pointer.
    ring.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const fc = carts[front()];
      const r = fc.getBoundingClientRect();
      fc.style.setProperty('--gx', `${(((e.clientX - r.left) / r.width) * 100).toFixed(1)}%`);
      fc.style.setProperty('--gy', `${(((e.clientY - r.top) / r.height) * 100).toFixed(1)}%`);
    });
    const spinTo = (g: number) => {
      goal = g;
      if (reduced) pos = g;
      kick();
      layout();
    };
    const spinBy = (k: number) => spinTo(Math.round(goal) + k);

    // A world's chip turns the carousel to that world's first cartridge, the short way round.
    chips.forEach((c) =>
      c.addEventListener('click', () => spinTo(Math.round(goal) + wrapD(Number(c.dataset.first) - goal))),
    );

    car.querySelectorAll<HTMLButtonElement>('[data-spin]').forEach((b) =>
      b.addEventListener('click', () => spinBy(Number(b.dataset.spin))),
    );

    // Drag: sideways on the carousel turns it; the cartridge in front can be picked up and carried.
    // On touch, the front cartridge is carried when the finger moves more down/up than sideways.
    let spinning = false;
    let downX = 0, downY = 0, downScroll = 0, lastY = 0, startPos = 0, lastX = 0, lastT = 0, mode: '' | 'spin' | 'carry' | 'pending' = '';
    let downItem = -1;
    let moved = 0;
    const fine = matchMedia('(pointer: fine)').matches;

    const overConsole = (x: number, y: number) => {
      const r = consoleEl.getBoundingClientRect();
      return x > r.left - 30 && x < r.right + 30 && y > r.top - 60 && y < r.bottom + 30;
    };

    ring.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || busy) return;
      const li = (e.target as HTMLElement).closest<HTMLElement>('li');
      downItem = li ? items.indexOf(li) : -1;
      downX = lastX = e.clientX;
      downY = lastY = e.clientY;
      downScroll = scrollY;
      lastT = performance.now();
      startPos = pos;
      moved = 0;
      mode = 'pending';
      ring.setPointerCapture(e.pointerId);
    });

    ring.addEventListener('pointermove', (e) => {
      if (!mode) return;
      const dx = e.clientX - downX, dy = e.clientY - downY;
      moved = Math.max(moved, Math.hypot(dx, dy));
      if (mode === 'pending' && moved > 6) {
        const onFront = downItem >= 0 && downItem === front() && !carts[downItem].classList.contains('is-in');
        if (onFront && (fine || Math.abs(dy) > Math.abs(dx))) {
          mode = 'carry';
          held = { i: downItem, x: downX, y: downY, dx: 0, dy: 0 };
          items[downItem].classList.add('is-held');
          car.classList.add('is-carrying');
        } else {
          mode = 'spin';
          spinning = true;
          car.classList.add('is-spinning');
        }
        kick();
      }
      if (mode === 'spin') {
        const w = items[0].offsetWidth;
        const now = performance.now();
        const p = startPos - dx / (w * 0.75);
        vel = (p - pos) / Math.max(1, (now - lastT) / 16);
        pos = p;
        lastX = e.clientX;
        lastT = now;
      } else if (mode === 'carry' && held) {
        held.dx = dx;
        lastX = e.clientX;
        lastY = e.clientY;
      }
    });

    const end = (e: PointerEvent) => {
      if (!mode) return;
      const was = mode;
      mode = '';
      if (was === 'spin') {
        spinning = false;
        car.classList.remove('is-spinning');
        // Let it coast a little, then settle on a cartridge.
        spinTo(Math.round(pos + vel * 6));
      } else if (was === 'carry' && held) {
        const i = held.i;
        const drop = overConsole(e.clientX, e.clientY);
        consoleEl.classList.remove('is-target');
        car.classList.remove('is-carrying');
        if (drop) {
          // It flies from where it was let go.
          insert(i).then(() => {
            held = null;
            items[i].classList.remove('is-held');
            layout();
          });
          setTimeout(() => {
            held = null;
            items[i].classList.remove('is-held');
            layout();
          }, 30);
        } else {
          // Not in the slot: it springs back onto the carousel.
          items[i].classList.remove('is-held');
          const li = items[i];
          li.style.transition = 'transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1)';
          held = null;
          layout();
          setTimeout(() => (li.style.transition = ''), 360);
        }
      } else if (was === 'pending' && downItem >= 0) {
        // A tap: the one in front goes in, one at the side turns to the front.
        const d = wrapD(downItem - pos);
        if (Math.abs(d) < 0.5) {
          if (!carts[downItem].classList.contains('is-in')) insert(downItem);
        } else spinTo(Math.round(pos + d));
      }
    };
    ring.addEventListener('pointerup', end);
    ring.addEventListener('pointercancel', end);

    // Keyboard: the front cartridge is a button; Enter or Space slots it in.
    carts.forEach((c, i) =>
      c.addEventListener('click', (e) => {
        if ((e as PointerEvent).pointerType) return; // pointer taps are handled above
        insert(i);
      }),
    );
    ring.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        e.stopPropagation();
        spinBy(e.key === 'ArrowRight' ? 1 : -1);
        requestAnimationFrame(() => carts[((Math.round(goal) % n) + n) % n].focus({ preventScroll: true }));
      }
    });

    new ResizeObserver(layout).observe(ring);
    layout();

    // The console leans a little towards the pointer.
    const rig = sec.querySelector<HTMLElement>('.rig')!;
    if (!reduced) {
      rig.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        const r = rig.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        consoleEl.style.setProperty('--ry', `${(-10 + x * 10).toFixed(2)}deg`);
        consoleEl.style.setProperty('--rx', `${(-20 - y * 6).toFixed(2)}deg`);
      });
      rig.addEventListener('pointerleave', () => {
        consoleEl.style.removeProperty('--ry');
        consoleEl.style.removeProperty('--rx');
      });
    }

    // The ghost hand: once the section is in view and nothing has been played yet, it grabs the
    // front cartridge and carries it to the glowing slot, twice. Any touch of the carousel stops it.
    const hand = sec.querySelector<HTMLElement>('.demo-hand')!;
    let touched = false;
    let demoTl: gsap.core.Timeline | null = null;
    // Whatever the visitor does first, the hand steps aside.
    const stopDemo = () => {
      touched = true;
      demoTl?.kill();
      gsap.to(hand, { opacity: 0, duration: 0.2 });
    };
    sec.addEventListener('pointerdown', stopDemo, { capture: true });
    sec.addEventListener('keydown', stopDemo, { capture: true });
    function demo() {
      if (reduced || touched || active >= 0) return;
      const st = sec!.querySelector<HTMLElement>('.stage')!.getBoundingClientRect();
      const fr = carts[front()].getBoundingClientRect();
      const sl = consoleEl!.querySelector<HTMLElement>('.slot-hole')!.getBoundingClientRect();
      const from = { x: fr.left + fr.width * 0.5 - st.left, y: fr.top + fr.height * 0.55 - st.top };
      const to = { x: sl.left + sl.width / 2 - st.left, y: sl.top - st.top - 10 };
      demoTl = gsap.timeline({ repeat: 1, repeatDelay: 0.6 })
        .set(hand, { x: from.x, y: from.y + 30, opacity: 0, scale: 1 })
        .to(hand, { y: from.y, opacity: 1, duration: 0.35, ease: 'power2.out' })
        .to(hand, { scale: 0.88, duration: 0.15 })
        .to(hand, { x: to.x, y: to.y, duration: 1.1, ease: 'power2.inOut' })
        .to(hand, { scale: 1, duration: 0.15 })
        .to(hand, { opacity: 0, duration: 0.3, delay: 0.2 });
    }

    const press = (el: HTMLElement) => {
      el.classList.add('is-press');
      setTimeout(() => el.classList.remove('is-press'), 140);
    };

    // The d-pad changes the game; with the console empty it turns the carousel.
    const step = (k: number) => (active < 0 ? spinBy(k) : insert(active + k));
    sec.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => step(Number(b.dataset.step))),
    );

    // A: play it. 3D models and reels open right on the screen; everything else opens its link.
    const loadModel = (uid: string, name: string) => {
      stopMedia();
      embed.innerHTML = `<iframe title="${name} 3D" allow="autoplay; fullscreen; xr-spatial-tracking" allowfullscreen
        src="https://sketchfab.com/models/${uid}/embed?autostart=1&ui_theme=dark&ui_hint=2&dnt=1"></iframe>`;
    };
    aBtn.addEventListener('click', () => {
      // Empty: A slots in the cartridge in front.
      if (active < 0) return insert(front());
      const c = carts[active];
      if (c.dataset.embed) {
        stopMedia();
        embed.innerHTML = `<iframe title="${c.dataset.name}" allow="autoplay; fullscreen" src="${c.dataset.embed}"></iframe>`;
      } else if (c.dataset.model) loadModel(c.dataset.model, c.dataset.modelName || '');
      else if (c.dataset.youtube) {
        stopMedia();
        embed.innerHTML = `<iframe title="${c.dataset.name}" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen
          src="https://www.youtube-nocookie.com/embed/${c.dataset.youtube}?autoplay=1&rel=0&modestbranding=1&playsinline=1"></iframe>`;
      } else if (c.dataset.url) window.open(c.dataset.url, '_blank', 'noopener');
    });
    // B: back to the cover.
    bBtn.addEventListener('click', () => active >= 0 && paint(active));

    sec.querySelectorAll<HTMLButtonElement>('[data-model]').forEach((m) =>
      m.addEventListener('click', () => {
        loadModel(m.dataset.model!, m.dataset.title || '');
        m.closest('.m-models')?.querySelectorAll('button').forEach((x) => x.classList.toggle('is-on', x === m));
        screen.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
      }),
    );

    // Arrow keys and A/B on the keyboard while the console is on screen.
    let inView = false;
    new IntersectionObserver(
      (e) => {
        inView = e[0].isIntersecting;
        if (inView && !seen && active < 0) {
          seen = true;
          setTimeout(demo, 900);
        }
        if (!inView) vid.pause();
        else if (!vid.hidden && !reduced) vid.play().catch(() => {});
      },
      { threshold: 0.45 },
    ).observe(consoleEl);

    window.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (!inView || e.metaKey || e.ctrlKey || e.altKey || t.closest('input, textarea, select, [contenteditable]')) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); press(sec.querySelector('.d-right')!); step(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); press(sec.querySelector('.d-left')!); step(-1); }
    });

    // Swipe the screen sideways on a phone.
    let sx = 0, sy = 0;
    screen.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
    screen.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      const dy = e.changedTouches[0].clientY - sy;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.4 && !embed.innerHTML) step(dx < 0 ? 1 : -1);
    });

    peek.classList.remove('is-up');
  }
</script>
