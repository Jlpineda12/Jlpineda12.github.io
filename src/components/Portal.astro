---
// The way from one chapter into the next. The screen holds still while you scroll: a shape grows
// out of the middle in the next chapter's colour (a circle, a cartridge, a drop, a spark, a speech
// bubble, a pixel), points of light rush past like stars, and the next chapter's name flies
// towards you and you go through it. When the shape fills the screen the next chapter is there.
// scripts/portals.ts drives it from the scroll; with reduced motion it is simply skipped.
interface Props {
  shape: 'circle' | 'cartridge' | 'drop' | 'spark' | 'bubble' | 'pixel';
  from: string;
  to: string;
  title: string;
  ink?: string;
  n: number;
}
const { shape, from, to, title, ink = '#2a2a2e', n } = Astro.props;
const SHAPES: Record<string, string> = {
  circle: 'M0 -40 A40 40 0 1 1 -0.01 -40 Z',
  cartridge: 'M-32 -40 H14 L32 -24 V36 A4 4 0 0 1 28 40 H-28 A4 4 0 0 1 -32 36 Z',
  drop: 'M0 -44 C14 -24 32 -6 32 12 A32 32 0 0 1 -32 12 C-32 -6 -14 -24 0 -44 Z',
  spark: 'M0 -46 C5 -12 12 -5 46 0 C12 5 5 12 0 46 C-5 12 -12 5 -46 0 C-12 -5 -5 -12 0 -46 Z',
  bubble: 'M-36 -30 H36 A8 8 0 0 1 44 -22 V14 A8 8 0 0 1 36 22 H-8 L-26 38 V22 H-36 A8 8 0 0 1 -44 14 V-22 A8 8 0 0 1 -36 -30 Z',
  pixel: 'M-12 -40 H12 V-28 H28 V-12 H40 V12 H28 V28 H12 V40 H-12 V28 H-28 V12 H-40 V-12 H-28 V-28 H-12 Z',
};
// Points of light at fixed angles and depths.
const stars = Array.from({ length: 22 }, (_, i) => {
  const a = (i * 137.5) % 360;
  return { a, d: 0.25 + ((i * 53) % 70) / 100, s: 2 + (i % 4) };
});
---
<div class="portal" data-portal aria-hidden="true" style={`--from:${from};--to:${to};--ink:${ink}`}>
  <div class="pin">
    <div class="stars">
      {stars.map((st) => <i style={`--a:${st.a}deg;--d:${st.d};--sz:${st.s}px`}></i>)}
    </div>
    <svg class="shape" viewBox="-50 -50 100 100"><path d={SHAPES[shape]} /></svg>
    <p class="num">{String(n).padStart(2, '0')}</p>
    <p class="title">{title}</p>
  </div>
</div>

<style>
  .portal {
    position: relative;
    height: 190svh;
    background: var(--from);
  }

  .pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: grid;
    place-items: center;
    contain: paint;
  }

  /* The shape: tiny at first, then it swallows the screen. */
  .shape {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22vmin;
    height: 22vmin;
    margin: -11vmin 0 0 -11vmin;
    overflow: visible;
    transform: scale(var(--s, 0.04)) rotate(var(--r, 0deg));
    will-change: transform;
  }

  .shape path { fill: var(--to); }

  /* Stars rush outwards from the middle, growing as they come closer. */
  .stars i {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--sz);
    height: var(--sz);
    border-radius: 50%;
    background: var(--to);
    box-shadow: 0 0 10px var(--to);
    transform: rotate(var(--a)) translateX(calc(var(--z, 0) * var(--d) * 70vmax)) scale(calc(0.5 + var(--z, 0) * 3));
    opacity: calc(var(--z, 0) * 2);
  }

  /* The next chapter's name, flying at you. */
  .title {
    position: relative;
    z-index: 2;
    font-size: clamp(2.6rem, 1.4rem + 6vw, 7rem);
    font-weight: 900;
    font-stretch: 125%;
    letter-spacing: -0.03em;
    line-height: 1;
    text-align: center;
    /* White, inverted against whatever is behind: readable on the old colour and on the new one. */
    color: #fff;
    mix-blend-mode: difference;
    transform: scale(var(--ts, 0.7));
    opacity: var(--to-o, 0);
    will-change: transform, opacity;
  }

  .num {
    position: absolute;
    top: calc(50% - clamp(2.6rem, 1.4rem + 6vw, 7rem));
    left: 50%;
    translate: -50% 0;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.3em;
    color: #fff;
    mix-blend-mode: difference;
    opacity: calc(var(--to-o, 0) * 0.7);
  }

  @media (prefers-reduced-motion: reduce) {
    .portal { display: none; }
  }
</style>
