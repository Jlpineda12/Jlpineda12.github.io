---
// José's tools as the stickers on his laptop lid. Every tool is a die-cut sticker in the colour of
// its field (games, 3D, design, code, web, AI). Drag them around to rearrange the lid; tap one and it
// lifts while the tag on the lid says what it is; the chips underneath light up a field's stickers.
import { getData, t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { tools } = getData(lang);
const ui = t(lang);
const c = ui.candid;
const COLORS = ['#e5483b', '#22a06b', '#e3a21a', '#4656d6', '#a8459c', '#e0567a'];
// Each tool's mark, drawn simply in its brand colours (24px grid): a stroked shape or its letters.
type Mark = { bg: string; fg: string; d?: string; t?: string; fill?: string };
const MARKS: Record<string, Mark> = {
  unity: { bg: '#1f1f24', fg: '#fff', d: 'M12 3l8 4.5v9L12 21l-8-4.5v-9zM12 12l8-4.5M12 12v9M12 12L4 7.5' },
  'c#': { bg: '#68217a', fg: '#fff', t: 'C#' },
  blender: { bg: '#e87d0d', fg: '#fff', d: 'M14 16.5a5 5 0 1 0 0-.01M3 9.5h8M6 6.5l6.5 5', fill: 'M14 18a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2z' },
  maya: { bg: '#0f8f9e', fg: '#fff', d: 'M5 18V7l7 7 7-7v11' },
  'three.js': { bg: '#111', fg: '#fff', d: 'M4 20L8 4l12 12zM6 12l8 2M10 18l2-8M8 4l4 6' },
  photoshop: { bg: '#001e36', fg: '#31a8ff', t: 'Ps' },
  procreate: { bg: '#121212', fg: '#fff', d: 'M5 19c2 0 3-1 3-3s1.5-3 3-3l6-8 2 2-8 6c0 1.5-1 3-3 3s-3 1-3 3z' },
  'ui/ux': { bg: '#f24e1e', fg: '#fff', d: 'M7 4l11 7-5 1.5L10.5 18z' },
  java: { bg: '#f89820', fg: '#fff', d: 'M5 11h11v4a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5zM16 12h1.5a2.5 2.5 0 0 1 0 5H16M9 3c-1 1.5 1 2.5 0 4M12.5 3c-1 1.5 1 2.5 0 4' },
  'c++': { bg: '#00599c', fg: '#fff', t: 'C++' },
  python: { bg: '#3776ab', fg: '#ffd43b', t: 'Py' },
  javascript: { bg: '#f7df1e', fg: '#1a1a1a', t: 'JS' },
  typescript: { bg: '#3178c6', fg: '#fff', t: 'TS' },
  'node.js': { bg: '#5fa04e', fg: '#fff', d: 'M12 2.8l8 4.6v9.2l-8 4.6-8-4.6V7.4zM14.5 9.5c-.5-1-1.5-1.3-2.5-1.3-1.5 0-2.5.7-2.5 1.8 0 2.6 5.2 1.4 5.2 4 0 1.1-1.1 1.9-2.7 1.9-1.3 0-2.3-.5-2.8-1.5' },
  express: { bg: '#111', fg: '#fff', t: 'ex' },
  prisma: { bg: '#2d3748', fg: '#fff', d: 'M12 2.5L4 17.5l9 4 7-3.5zM12 2.5l1 19' },
  'react native': { bg: '#20232a', fg: '#61dafb', d: 'M12 8.2c5 0 9 1.7 9 3.8s-4 3.8-9 3.8-9-1.7-9-3.8 4-3.8 9-3.8zM8.7 10.1c2.5-4.3 6-7 7.8-5.9s1.2 5.5-1.3 9.8-6 7-7.8 5.9-1.2-5.5 1.3-9.8zM8.7 13.9c-2.5-4.3-3-8.7-1.3-9.8s5.3 1.6 7.8 5.9 3 8.7 1.3 9.8-5.3-1.6-7.8-5.9z', fill: 'M12 13.6a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2z' },
  tensorflow: { bg: '#ff6f00', fg: '#fff', t: 'TF' },
  keras: { bg: '#d00000', fg: '#fff', t: 'K' },
  flask: { bg: '#111', fg: '#fff', d: 'M9.5 3h5M10.5 3v6L5 19a1.5 1.5 0 0 0 1.3 2h11.4a1.5 1.5 0 0 0 1.3-2l-5.5-10V3M7.5 15h9' },
};
const markOf = (name: string): Mark => MARKS[name.toLowerCase()] ?? { bg: '#2a2a2e', fg: '#fff', t: name.slice(0, 2) };
const SHAPES = ['round', 'pill', 'badge', 'tag', 'pill', 'round', 'tag'];
// Every tool once (C# shows up under games and code), short names only.
const seen = new Set<string>();
const stickers = tools.flatMap((g, gi) =>
  g.items
    .split(',')
    .map((x) => x.trim())
    .filter((x) => x && x.length < 20 && !seen.has(x.toLowerCase()) && (seen.add(x.toLowerCase()), true))
    .map((name, k) => ({ name, group: g.group, gi, big: k === 0 })),
);
// Shuffled the same way every build, so the lid looks lived in rather than sorted.
const hash = (s: string) => [...s].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) >>> 0, 7);
const lid = stickers
  .map((s, i) => ({ ...s, h: hash(s.name), shape: SHAPES[(hash(s.name) + i) % SHAPES.length] }))
  .sort((a, b) => a.h - b.h);
const mid = Math.floor(lid.length / 2);
---
<section class="tools" id="inventario" data-scene="inventory" aria-labelledby="tools-title">
  <div class="st-wrap">
    <h2 class="c-head" id="tools-title">{c.tools}</h2>

    <div class="laptop">
      <div class="lid" data-lid>
        <span class="cam" aria-hidden="true"></span>
        <p class="lid-tag" aria-live="polite" data-idle=""></p>
        <ul class="stickers" role="list">
          {lid.map((s, i) => (
            <>
              {i === mid && <li class="logo" aria-hidden="true"><span>JLP</span></li>}
              <li class="st-li">
                <button
                  class={`st st-${s.shape}`}
                  type="button"
                  data-g={s.gi}
                  data-tool={s.name}
                  data-group={s.group}
                  data-fp-drag
                  style={`--c:${COLORS[s.gi % COLORS.length]};--r:${(s.h % 17) - 8}deg;--dy:${(s.h % 11) - 5}px;--k:${s.big ? 1.3 : 0.9 + (s.h % 4) * 0.06}`}
                >
                  {(() => {
                    const m = markOf(s.name);
                    return (
                      <span class="mk" style={`--mb:${m.bg};--mf:${m.fg}`} aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                          {m.d && <path d={m.d} />}
                          {m.fill && <path class="mk-fill" d={m.fill} />}
                          {m.t && <text x="12" y="12.5" dominant-baseline="middle" text-anchor="middle" font-size={m.t.length > 2 ? 9 : 11.5}>{m.t}</text>}
                        </svg>
                      </span>
                    );
                  })()}
                  <span>{s.name}</span>
                </button>
              </li>
            </>
          ))}
        </ul>
      </div>
      <div class="base" aria-hidden="true"><i></i></div>
    </div>

    <div class="chips" role="group" aria-label={c.tools}>
      <button class="chip is-on" type="button" data-chip="all" aria-pressed="true">{c.keysAll}</button>
      {tools.map((g, gi) => (
        <button class="chip" type="button" data-chip={gi} aria-pressed="false" style={`--c:${COLORS[gi % COLORS.length]}`}>{g.group}</button>
      ))}
    </div>
  </div>
</section>

<style>
  .tools { position: relative; }

  .st-wrap {
    display: grid;
    justify-items: center;
    gap: clamp(8px, 1.6svh, 18px);
    width: min(100% - 2 * var(--margin), 980px);
    margin-inline: auto;
  }

  /* ---------- The laptop ---------- */
  .laptop { width: min(100%, 860px, calc((100svh - 368px) * 1.6)); min-width: min(100%, 420px); }

  .lid {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    padding: 6% 4% 4%;
    border-radius: 22px 22px 8px 8px;
    background:
      radial-gradient(120% 90% at 20% 0%, #ffffff1c, #fff0 55%),
      linear-gradient(160deg, #3a3a48, #23232d);
    box-shadow: inset 0 1px 0 #ffffff26, inset 0 -3px 0 #00000040, 0 30px 50px -30px #6b1f3a99;
  }

  .base {
    position: relative;
    height: clamp(10px, 1.6vw, 16px);
    margin-inline: -4%;
    border-radius: 2px 2px 18px 18px;
    background: linear-gradient(#cfd0d8, #9c9eaa);
    box-shadow: 0 16px 24px -14px #6b1f3a80;
  }

  .base i { position: absolute; left: 42%; right: 42%; top: 0; height: 40%; border-radius: 0 0 8px 8px; background: #8a8c97; }

  /* The tag on the lid: what the sticker you tapped is. */
  .lid-tag {
    position: absolute;
    left: 4%;
    top: 4%;
    z-index: 5;
    max-width: 70%;
    padding: 4px 12px 6px;
    background: #fffdf6;
    color: var(--ink);
    font-family: var(--hand);
    font-size: clamp(16px, 2.8cqi, 26px);
    font-weight: 700;
    line-height: 1.1;
    rotate: -3deg;
    box-shadow: 0 6px 10px -6px #0008;
    pointer-events: none;
  }

  .lid-tag:empty { visibility: hidden; }

  /* A strip of tape holding it. */
  .lid-tag::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -8px;
    width: 46px;
    height: 16px;
    translate: -50% 0;
    background: #ffffff8c;
    rotate: 4deg;
  }

  .stickers {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: center;
    justify-content: center;
    gap: 2cqi 1.6cqi;
    width: 100%;
    max-width: 96cqi;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .st-li { display: contents; }

  /* The logo in the middle of the lid, glowing a little. */
  .logo {
    display: grid;
    place-items: center;
    width: 12cqi;
    aspect-ratio: 1;
    margin-inline: 1cqi;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #ffffff60, #fff0 60%), #ffd23f;
    box-shadow: 0 0 0 0.6cqi #ffffff22, 0 0 40px #ffd23f66;
    color: #2a2a2e;
    font-size: 3cqi;
    font-weight: 900;
    font-stretch: 125%;
  }

  /* ---------- A sticker: colour, white die-cut border, a soft shadow ---------- */
  .st {
    --x: 0px;
    --y: 0px;
    --lift: 0;
    --edge: 0.55cqi;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.7cqi;
    padding: 1.2cqi 2cqi;
    border: 0;
    background: var(--c);
    color: #fff;
    font: inherit;
    font-size: clamp(11px, calc(1.8cqi * var(--k, 1)), 22px);
    font-weight: 900;
    font-stretch: 112%;
    line-height: 1;
    white-space: nowrap;
    cursor: grab;
    touch-action: none;
    user-select: none;
    translate: var(--x) calc(var(--y) + var(--dy) - var(--lift) * 6px);
    rotate: var(--r);
    scale: calc(1 + var(--lift) * 0.08);
    box-shadow: 0 0 0 var(--edge) #fff, 0 calc(2px + var(--lift) * 14px) calc(4px + var(--lift) * 18px) calc(var(--lift) * -4px) #0000008c;
    transition: scale 0.2s, translate 0.2s, box-shadow 0.2s, opacity 0.25s, filter 0.25s;
    z-index: 1;
  }

  /* The tool's mark: a little app-style tile in its brand colours. */
  .mk {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.7em;
    height: 1.7em;
    border-radius: 0.42em;
    background: var(--mb);
    box-shadow: 0 0 0 1.5px #ffffffcc, inset 0 1px 0 #ffffff30;
  }

  .mk svg { width: 78%; height: 78%; overflow: visible; }
  .mk path { fill: none; stroke: var(--mf); stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .mk .mk-fill { fill: var(--mf); stroke: none; }
  .mk text { fill: var(--mf); font-family: var(--font); font-weight: 900; letter-spacing: -0.04em; }

  .st-round .mk { width: 2.2em; height: 2.2em; }

  .st-round {
    flex-direction: column;
    justify-content: center;
    gap: 0.3em;
    width: calc(6.3em + 1cqi);
    aspect-ratio: 1;
    padding: 0.6em;
    border-radius: 50%;
    font-size: clamp(10px, calc(1.6cqi * var(--k, 1)), 20px);
    white-space: normal;
    text-align: center;
  }
  .st-pill { border-radius: 999px; }
  .st-tag { border-radius: 8px; }
  .st-badge {
    border-radius: 14px 14px 14px 4px;
    background: #fffdf6;
    color: var(--c);
    box-shadow: 0 0 0 var(--edge) var(--c), 0 0 0 calc(var(--edge) * 2) #fff, 0 calc(2px + var(--lift) * 14px) calc(4px + var(--lift) * 18px) calc(var(--lift) * -4px) #0000008c;
  }

  /* A glossy sheen. */
  .st::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(120deg, #ffffff40, #fff0 40%);
    pointer-events: none;
  }

  .st:hover,
  .st.is-on { --lift: 1; z-index: 3; }
  .st.is-dragging { --lift: 1.4; cursor: grabbing; transition: scale 0.2s, box-shadow 0.2s; z-index: 4; }
  .st:focus-visible { outline: 3px solid #fff; outline-offset: 6px; }

  .lid.is-filtered .st:not(.is-match) { opacity: 0.22; filter: grayscale(1); }

  /* ---------- The field chips ---------- */
  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 8px; }

  .chip {
    --c: var(--ink);
    padding: 6px 12px;
    border: 2px solid color-mix(in oklab, var(--c) 50%, transparent);
    border-radius: 999px;
    background: #ffffffa0;
    color: var(--ink);
    font: inherit;
    font-size: var(--step-small);
    font-weight: 800;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }

  .chip:hover { border-color: var(--c); }
  .chip.is-on { background: var(--c); border-color: var(--c); color: #fff; }
  .chip:focus-visible { outline: 3px solid var(--c); outline-offset: 2px; }


  /* The tablet's camera, only on narrow screens. */
  .cam { display: none; }

  /* Narrow screens: a laptop would be too small, so it is his tablet instead (seen from the back,
     3:4, camera in the corner), and the stickers still fit. */
  @media (max-aspect-ratio: 1/1) {
    .laptop { width: min(100%, 420px, calc(56svh * 0.75)); }
    .base { display: none; }
    .lid {
      aspect-ratio: 3 / 4;
      padding: 18% 5% 6%;
      border-radius: 30px;
      box-shadow: inset 0 0 0 2px #ffffff14, inset 0 1px 0 #ffffff26, 0 24px 40px -24px #6b1f3a99;
    }
    .cam {
      position: absolute;
      right: 6%;
      top: 4%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3px;
      width: 15cqi;
      aspect-ratio: 1;
      padding: 2.4cqi;
      border-radius: 4cqi;
      background: #2c2c36;
      box-shadow: inset 0 0 0 1px #ffffff1a, 0 2px 4px #0006;
    }
    .cam::before,
    .cam::after {
      content: '';
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #5a6a9a, #0c0c12 60%);
      box-shadow: 0 0 0 1px #00000080;
    }
    .lid-tag { max-width: 68%; }
    .stickers { gap: 2.8cqi 2.2cqi; }
    .st { --edge: 1cqi; font-size: clamp(10px, calc(3cqi * var(--k, 1)), 17px); padding: 1.8cqi 2.6cqi; }
    .st-round { padding: 0.5em; font-size: clamp(9px, 2.6cqi, 14px); width: calc(5.6em + 1cqi); }
    .mk { width: 1.5em; height: 1.5em; }
    .logo { width: 18cqi; font-size: 4.6cqi; }
    .chip { padding: 4px 10px; font-size: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .st { transition: none; }
  }
</style>

<script>
  const lid = document.querySelector<HTMLElement>('[data-lid]');
  const tag = lid?.querySelector<HTMLElement>('.lid-tag');
  const stickers = [...(lid?.querySelectorAll<HTMLButtonElement>('.st') ?? [])];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.tools .chip')];
  if (lid && tag && stickers.length) {
    const idle = tag.dataset.idle || '';
    const pick = (s: HTMLButtonElement | null) => {
      stickers.forEach((x) => x.classList.toggle('is-on', x === s));
      tag.textContent = s ? `${s.dataset.tool} · ${s.dataset.group}` : idle;
    };

    // Drag to move a sticker (it stays where you leave it, on the lid); a tap without moving picks it.
    stickers.forEach((s) => {
      let sx = 0, sy = 0, ox = 0, oy = 0, id = -1, moved = false;
      s.addEventListener('pointerdown', (e) => {
        id = e.pointerId;
        s.setPointerCapture(id);
        sx = e.clientX;
        sy = e.clientY;
        ox = parseFloat(s.style.getPropertyValue('--x')) || 0;
        oy = parseFloat(s.style.getPropertyValue('--y')) || 0;
        moved = false;
      });
      s.addEventListener('pointermove', (e) => {
        if (e.pointerId !== id) return;
        const dx = e.clientX - sx;
        const dy = e.clientY - sy;
        if (!moved && Math.hypot(dx, dy) < 6) return;
        moved = true;
        s.classList.add('is-dragging');
        const r = lid.getBoundingClientRect();
        s.style.setProperty('--x', `${Math.round(Math.max(-r.width / 2, Math.min(r.width / 2, ox + dx)))}px`);
        s.style.setProperty('--y', `${Math.round(Math.max(-r.height / 2, Math.min(r.height / 2, oy + dy)))}px`);
      });
      const end = (e: PointerEvent) => {
        if (e.pointerId !== id) return;
        id = -1;
        s.classList.remove('is-dragging');
        if (moved) pick(s);
      };
      s.addEventListener('pointerup', end);
      s.addEventListener('pointercancel', end);
      s.addEventListener('click', (e) => {
        if (moved) {
          e.preventDefault();
          moved = false;
          return;
        }
        pick(s.classList.contains('is-on') ? null : s);
      });
    });

    // Fields: light up one field's stickers.
    chips.forEach((ch) =>
      ch.addEventListener('click', () => {
        const g = ch.dataset.chip;
        chips.forEach((x) => {
          x.classList.toggle('is-on', x === ch);
          x.setAttribute('aria-pressed', String(x === ch));
        });
        lid.classList.toggle('is-filtered', g !== 'all');
        stickers.forEach((s) => s.classList.toggle('is-match', s.dataset.g === g));
        pick(null);
        if (g !== 'all') tag.textContent = ch.textContent || '';
      }),
    );
  }
</script>
