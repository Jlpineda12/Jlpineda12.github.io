---
// José's tools as round stickers with their official logos, loose inside his laptop's lid. They have
// weight: as the chapter opens they rain down, bounce, roll and pile up at the bottom. Grab one and
// throw it; tap one and it hops while the tag on the lid says what it is; tap the lid itself and
// everything gets tossed. (On narrow screens the laptop is his tablet.) A small 2D physics loop of
// its own (circles, gravity, bounces), running only while something moves and the chapter is shown.
import { getData, t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { tools } = getData(lang);
const ui = t(lang);
const c = ui.candid;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Each tool's logo file (public/logos, from the Devicon set; Procreate drawn here).
const LOGO: Record<string, string> = {
  unity: 'unity', 'c#': 'csharp', blender: 'blender', maya: 'maya', 'three.js': 'threejs',
  photoshop: 'photoshop', procreate: 'procreate', 'ui/ux': 'figma', java: 'java', 'c++': 'cplusplus',
  python: 'python', javascript: 'javascript', typescript: 'typescript', 'node.js': 'nodejs',
  express: 'express', prisma: 'prisma', 'react native': 'react', tensorflow: 'tensorflow',
  keras: 'keras', flask: 'flask',
};
// Every tool once (C# shows up under games and code), short names only; the first of each field is
// a bigger sticker.
const seen = new Set<string>();
const stickers = tools.flatMap((g) =>
  g.items
    .split(',')
    .map((x) => x.trim())
    .filter((x) => x && x.length < 20 && !seen.has(x.toLowerCase()) && (seen.add(x.toLowerCase()), true))
    .map((name, k) => ({ name, group: g.group, big: k === 0, logo: LOGO[name.toLowerCase()] })),
);
---
<section class="tools" id="inventario" data-scene="inventory" aria-labelledby="tools-title">
  <div class="st-wrap">
    <h2 class="c-head" id="tools-title">{c.tools}</h2>

    <div class="laptop">
      <div class="lid" data-lid>
        <span class="cam" aria-hidden="true"></span>
        <span class="logo" aria-hidden="true">JLP</span>
        <p class="lid-tag" aria-live="polite"></p>
        <ul class="pit" role="list" data-pit>
          {stickers.map((s) => (
            <li class="st-li">
              <button class:list={['st', { 'is-big': s.big }]} type="button" data-tool={s.name} data-group={s.group} data-fp-drag aria-label={`${s.name} · ${s.group}`}>
                {s.logo && <img src={`${base}logos/${s.logo}.svg`} width="128" height="128" alt="" loading="lazy" decoding="async" draggable="false" />}
                <span class="st-name">{s.name}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
      <div class="base" aria-hidden="true"><i></i></div>
    </div>
  </div>
</section>

<style>
  .tools { position: relative; }

  .st-wrap {
    display: grid;
    justify-items: center;
    gap: clamp(10px, 2svh, 22px);
    width: min(100% - 2 * var(--margin), 980px);
    margin-inline: auto;
  }

  /* ---------- The laptop ---------- */
  .laptop { width: min(100%, 900px, calc((100svh - 260px) * 1.6)); min-width: min(100%, 420px); }

  .lid {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 16 / 10;
    border-radius: 22px 22px 8px 8px;
    background:
      radial-gradient(120% 90% at 20% 0%, #ffffff1c, #fff0 55%),
      linear-gradient(160deg, #3a3a48, #23232d);
    box-shadow: inset 0 1px 0 #ffffff26, inset 0 -3px 0 #00000040, 0 30px 50px -30px #6b1f3a99;
    overflow: hidden;
    cursor: pointer;
  }

  .base {
    position: relative;
    height: clamp(10px, 1.6vw, 16px);
    margin-inline: -4%;
    border-radius: 2px 2px 18px 18px;
    background: linear-gradient(#cfd0d8, #9c9eaa);
    box-shadow: 0 16px 24px -14px #6b1f3a80;
  }

  .base i { position: absolute; left: 42%; right: 42%; top: 0; height: 40%; border-radius: 0 0 8px 8px; background: #8a8c97; }

  /* The logo printed on the lid, glowing a little; the stickers fall in front of it. */
  .logo {
    position: absolute;
    left: 50%;
    top: 42%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 13cqi;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #ffffff60, #fff0 60%), #ffd23f;
    box-shadow: 0 0 0 0.6cqi #ffffff22, 0 0 40px #ffd23f55;
    color: #2a2a2e;
    font-size: 3.2cqi;
    font-weight: 900;
    font-stretch: 125%;
    pointer-events: none;
  }

  /* The tag on the lid: what the sticker you tapped is. */
  .lid-tag {
    position: absolute;
    left: 4%;
    top: 5%;
    z-index: 5;
    max-width: 70%;
    padding: 4px 12px 6px;
    background: #fffdf6;
    color: var(--ink);
    font-family: var(--hand);
    font-size: clamp(16px, 2.8cqi, 26px);
    font-weight: 700;
    line-height: 1.1;
    rotate: -3deg;
    box-shadow: 0 6px 10px -6px #0008;
    pointer-events: none;
  }

  .lid-tag:empty { visibility: hidden; }

  .lid-tag::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -8px;
    width: 46px;
    height: 16px;
    translate: -50% 0;
    background: #ffffff8c;
    rotate: 4deg;
  }

  /* ---------- The stickers: placed by the physics loop ---------- */
  .pit {
    position: absolute;
    inset: 3.5cqi;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .st-li { display: contents; }

  .st {
    --d: 10.5cqi;
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 4%;
    width: var(--d);
    height: var(--d);
    padding: calc(var(--d) * 0.14);
    border: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 28%, #ffffff, #f1eef7);
    box-shadow: 0 0 0 0.35cqi #ffffffe6, 0 6px 10px -4px #0000008c, inset 0 -3px 6px #00000014;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    will-change: transform;
    /* Until the loop places them: out of sight above the lid. */
    transform: translate3d(0, -200%, 0);
  }

  .st.is-big { --d: 13cqi; }

  .st img { width: calc(var(--d) * 0.46); height: auto; pointer-events: none; }

  .st-name {
    max-width: 100%;
    overflow: hidden;
    font-size: calc(var(--d) * 0.115);
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
    text-overflow: clip;
    color: #2a2a2e;
    pointer-events: none;
  }

  .st.is-held { cursor: grabbing; box-shadow: 0 0 0 0.35cqi #fff, 0 18px 26px -8px #000000a6; z-index: 3; }
  .st.is-on { box-shadow: 0 0 0 0.35cqi #ffd23f, 0 8px 14px -4px #0000008c; z-index: 2; }
  .st:focus-visible { outline: 3px solid #ffd23f; outline-offset: 3px; }

  /* The tablet's camera, only on narrow screens. */
  .cam { display: none; }

  /* Narrow screens: a laptop would be too small, so it is his tablet (seen from the back, 3:4). */
  @media (max-aspect-ratio: 1/1) {
    .laptop { width: min(100%, 460px, calc((100svh - 230px) * 0.75)); min-width: 0; }
    .base { display: none; }
    .lid { aspect-ratio: 3 / 4; border-radius: 30px; box-shadow: inset 0 0 0 2px #ffffff14, inset 0 1px 0 #ffffff26, 0 24px 40px -24px #6b1f3a99; }
    .pit { inset: 4cqi; }
    .logo { width: 20cqi; font-size: 5cqi; top: 40%; }
    .st { --d: 17cqi; }
    .st.is-big { --d: 20cqi; }
    .st img { width: calc(var(--d) * 0.6); }
    .st-name { display: none; }
    .lid-tag { top: 4%; max-width: 64%; }
    .cam {
      position: absolute;
      right: 6%;
      top: 4%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3px;
      width: 15cqi;
      aspect-ratio: 1;
      padding: 2.4cqi;
      border-radius: 4cqi;
      background: #2c2c36;
      box-shadow: inset 0 0 0 1px #ffffff1a, 0 2px 4px #0006;
    }
    .cam::before,
    .cam::after {
      content: '';
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #5a6a9a, #0c0c12 60%);
      box-shadow: 0 0 0 1px #00000080;
    }
  }
</style>

<script>
  const lid = document.querySelector<HTMLElement>('[data-lid]');
  const pit = lid?.querySelector<HTMLElement>('[data-pit]');
  const tag = lid?.querySelector<HTMLElement>('.lid-tag');
  const slide = lid?.closest<HTMLElement>('[data-slide]');
  const els = [...(pit?.querySelectorAll<HTMLButtonElement>('.st') ?? [])];
  if (lid && pit && tag && els.length) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    type Body = { el: HTMLButtonElement; r: number; x: number; y: number; vx: number; vy: number; a: number; held: boolean };
    const bodies: Body[] = els.map((el) => ({ el, r: 20, x: 0, y: -100, vx: 0, vy: 0, a: 0, held: false }));
    let W = 1, H = 1, G = 2000;
    const E = 0.38; // bounciness

    const measure = () => {
      W = pit.clientWidth;
      H = pit.clientHeight;
      G = Math.max(900, H * 4.2);
      bodies.forEach((b) => {
        b.r = b.el.offsetWidth / 2 || b.r;
        b.x = Math.max(b.r, Math.min(W - b.r, b.x));
        if (b.y > H - b.r) b.y = H - b.r;
      });
    };

    const render = () => {
      for (const b of bodies) b.el.style.transform = `translate3d(${(b.x - b.r).toFixed(1)}px, ${(b.y - b.r).toFixed(1)}px, 0) rotate(${b.a.toFixed(1)}deg)`;
    };

    const step = (dt: number) => {
      for (const b of bodies) {
        if (b.held) continue;
        b.vy += G * dt;
        b.x += b.vx * dt;
        b.y += b.vy * dt;
        b.a += ((b.vx * dt) / b.r) * 57.3;
      }
      // Pushing apart whatever overlaps, a few times over so the pile settles.
      for (let it = 0; it < 4; it++) {
        for (let i = 0; i < bodies.length; i++) {
          const p = bodies[i];
          for (let j = i + 1; j < bodies.length; j++) {
            const q = bodies[j];
            const dx = q.x - p.x, dy = q.y - p.y;
            const min = p.r + q.r;
            const d2 = dx * dx + dy * dy;
            if (d2 >= min * min || d2 === 0) continue;
            const d = Math.sqrt(d2);
            const nx = dx / d, ny = dy / d;
            const over = min - d;
            const wp = p.held ? 0 : q.held ? 1 : 0.5;
            const wq = q.held ? 0 : p.held ? 1 : 0.5;
            p.x -= nx * over * wp;
            p.y -= ny * over * wp;
            q.x += nx * over * wq;
            q.y += ny * over * wq;
            const vn = (q.vx - p.vx) * nx + (q.vy - p.vy) * ny;
            if (vn < 0) {
              const imp = -(1 + E) * vn;
              p.vx -= nx * imp * wp;
              p.vy -= ny * imp * wp;
              q.vx += nx * imp * wq;
              q.vy += ny * imp * wq;
            }
          }
        }
        // The lid's sides and bottom (open at the top, so they can rain in).
        for (const b of bodies) {
          if (b.held) continue;
          if (b.x < b.r) { b.x = b.r; b.vx = Math.abs(b.vx) * E; }
          if (b.x > W - b.r) { b.x = W - b.r; b.vx = -Math.abs(b.vx) * E; }
          if (b.y > H - b.r) {
            b.y = H - b.r;
            if (b.vy > 0) b.vy = -b.vy * E;
            if (Math.abs(b.vy) < 40) b.vy = 0;
            b.vx *= 0.9;
          }
          if (b.y < -H * 1.5) { b.y = -H * 1.5; b.vy = Math.abs(b.vy); }
        }
      }
    };

    // The loop: fixed steps, only while something moves and the chapter is shown.
    let raf = 0, last = 0, still = 0;
    const shown = () => !slide || slide.classList.contains('is-current');
    const frame = (now: number) => {
      raf = 0;
      if (!shown()) return;
      const dt = Math.min(0.05, (now - last) / 1000 || 0.016);
      last = now;
      const n = Math.max(1, Math.round(dt / (1 / 120)));
      for (let i = 0; i < n; i++) step(dt / n);
      render();
      const moving = bodies.some((b) => b.held || Math.abs(b.vx) > 8 || Math.abs(b.vy) > 8);
      still = moving ? 0 : still + 1;
      if (still < 30) raf = requestAnimationFrame(frame);
    };
    const wake = () => {
      still = 0;
      if (!raf && shown()) {
        last = performance.now();
        raf = requestAnimationFrame(frame);
      }
    };

    // They rain in from above the lid.
    const rain = () => {
      measure();
      bodies.forEach((b, i) => {
        b.x = b.r + Math.random() * Math.max(1, W - 2 * b.r);
        b.y = -b.r - i * (b.r * 0.9) - Math.random() * b.r * 2;
        b.vx = (Math.random() - 0.5) * 160;
        b.vy = Math.random() * 120;
        b.a = Math.random() * 360;
        b.held = false;
      });
      if (reduced) {
        for (let i = 0; i < 1500; i++) step(1 / 120);
        render();
        return;
      }
      render();
      wake();
    };

    // Grab, drag and throw; a tap makes it hop and says what it is.
    bodies.forEach((b) => {
      let ox = 0, oy = 0, px = 0, py = 0, pt = 0, sx = 0, sy = 0, moved = false, id = -1;
      const at = (e: PointerEvent) => {
        const r = pit.getBoundingClientRect();
        return { x: e.clientX - r.left, y: e.clientY - r.top };
      };
      b.el.addEventListener('pointerdown', (e) => {
        e.stopPropagation();
        id = e.pointerId;
        b.el.setPointerCapture(id);
        const p = at(e);
        ox = b.x - p.x;
        oy = b.y - p.y;
        px = sx = p.x;
        py = sy = p.y;
        pt = performance.now();
        moved = false;
      });
      b.el.addEventListener('pointermove', (e) => {
        if (e.pointerId !== id) return;
        const p = at(e);
        if (!moved && Math.hypot(p.x - sx, p.y - sy) < 6) return;
        if (!moved) {
          moved = true;
          b.held = true;
          b.el.classList.add('is-held');
        }
        const now = performance.now();
        const dt = Math.max(0.008, (now - pt) / 1000);
        b.vx = (p.x - px) / dt;
        b.vy = (p.y - py) / dt;
        px = p.x;
        py = p.y;
        pt = now;
        b.x = Math.max(b.r, Math.min(W - b.r, p.x + ox));
        b.y = Math.min(H - b.r, p.y + oy);
        wake();
      });
      const end = (e: PointerEvent) => {
        if (e.pointerId !== id) return;
        id = -1;
        b.el.classList.remove('is-held');
        if (b.held) {
          b.held = false;
          b.vx = Math.max(-2200, Math.min(2200, b.vx));
          b.vy = Math.max(-2600, Math.min(2200, b.vy));
        }
        wake();
      };
      b.el.addEventListener('pointerup', end);
      b.el.addEventListener('pointercancel', end);
      b.el.addEventListener('click', (e) => {
        e.stopPropagation();
        if (moved) { moved = false; return; }
        bodies.forEach((o) => o.el.classList.toggle('is-on', o === b));
        tag.textContent = `${b.el.dataset.tool} · ${b.el.dataset.group}`;
        b.vy = -Math.max(500, H * 2.4);
        b.vx += (Math.random() - 0.5) * 300;
        wake();
      });
    });

    // A tap on the lid itself tosses everything up.
    lid.addEventListener('click', () => {
      bodies.forEach((b) => {
        b.vy -= H * (2 + Math.random() * 1.6);
        b.vx += (Math.random() - 0.5) * W * 1.2;
      });
      wake();
    });

    addEventListener('fp-enter-inventario', rain);
    new ResizeObserver(() => {
      measure();
      render();
      wake();
    }).observe(pit);
    // Outside the deck, or arriving straight here: they fall the first time the lid is seen.
    if (!document.documentElement.classList.contains('fp') || slide?.classList.contains('is-current')) requestAnimationFrame(rain);
  }
</script>
