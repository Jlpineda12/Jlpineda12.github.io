---
// A project's picture: a looping cover, a still, a YouTube reel or a Sketchfab 3D viewer.
// Embeds load only when someone asks for them, so the page stays light.
import type { Project } from '../data/site';
import { t, fill, type Lang } from '../i18n';
interface Props {
  p: Project;
  lang: Lang;
  feature?: boolean;
}
const { p, lang, feature = false } = Astro.props;
const ui = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const poster = `${base}${p.poster}`;
---
{p.models ? (
  <div class:list={['media', 'viewer', { feature }]} data-viewer>
    <div class="viewer-stage">
      <img src={poster} width="1400" height="933" loading="lazy" alt={fill(ui.sheetAlt, p.name)} />
      <button class="play" type="button" data-load-model={p.models[0].uid} data-title={p.models[0].name}>
        <span class="play-icon" aria-hidden="true">3D</span> {fill(ui.explore3d, p.models[0].name)}
      </button>
    </div>
    <ul class="thumbs" aria-label={ui.pickModel}>
      {p.models.map((m) => (
        <li>
          <button type="button" data-load-model={m.uid} data-title={m.name} aria-label={fill(ui.see3d, m.name)}>
            <img src={`${base}img/sketchfab/${m.uid}.jpg`} width="640" height="360" loading="lazy" alt="" />
            <span>{m.name}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>
) : p.youtube ? (
  <div class:list={['media', 'reel', { feature }]}>
    <img src={poster} width="1400" height="788" loading="lazy" alt={fill(ui.reelAlt, p.name)} />
    <button class="play" type="button" data-load-youtube={p.youtube} data-title={p.name}>
      <span class="play-icon tri" aria-hidden="true"></span> {ui.watchReel}
    </button>
  </div>
) : p.video ? (
  <a class:list={['media', { feature }]} href={p.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
    <video muted loop playsinline preload="none" poster={poster} width="640" height="800">
      <source src={`${base}${p.video}`} type="video/mp4" />
    </video>
  </a>
) : (
  <a class:list={['media', { feature }]} href={p.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
    <img src={poster} width="1400" height="900" loading="lazy" alt="" />
  </a>
)}

<style>
  .media {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 24px;
    background: var(--w-soft, var(--ground));
    aspect-ratio: 16 / 10;
  }

  .media.feature {
    aspect-ratio: 4 / 3;
    border-radius: 28px;
  }

  .media > :is(img, video),
  .viewer-stage > img,
  .viewer-stage :global(iframe),
  .reel :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
    transition: transform 0.6s var(--ease-out);
  }

  a.media:hover > :is(img, video) {
    transform: scale(1.04);
  }

  .viewer {
    aspect-ratio: auto;
    overflow: visible;
    background: none;
  }

  .viewer-stage {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: inherit;
    overflow: hidden;
    background: #fff;
  }

  .viewer-stage > img {
    object-fit: contain;
  }

  .play {
    position: absolute;
    left: 50%;
    bottom: 20px;
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 22px 0 8px;
    border: 0;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--on-dark);
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.3s var(--ease-spring);
  }

  .play:hover {
    transform: translateY(-3px) scale(1.03);
  }

  .play-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--w-accent, var(--red));
    color: var(--ink);
    font-size: 13px;
    font-weight: 900;
  }

  .play-icon.tri::before {
    content: '';
    width: 13px;
    height: 15px;
    margin-left: 3px;
    background: var(--ink);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .thumbs {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
    margin-top: 10px;
  }

  .thumbs button {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 3px solid transparent;
    border-radius: 14px;
    overflow: hidden;
    background: none;
    cursor: pointer;
    aspect-ratio: 1;
    transition: transform 0.3s var(--ease-spring), border-color 0.2s;
  }

  .thumbs button:hover,
  .thumbs button.is-on {
    transform: translateY(-3px);
    border-color: var(--w-accent, var(--red));
  }

  .thumbs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbs span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  @media (max-width: 600px) {
    .thumbs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .media.feature {
      aspect-ratio: 4 / 3.4;
    }
  }
</style>

<script>
  // Load embeds on request: a Sketchfab model or a YouTube reel replaces its poster.
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const model = t.closest<HTMLButtonElement>('[data-load-model]');
    const yt = t.closest<HTMLButtonElement>('[data-load-youtube]');
    if (model) {
      const viewer = model.closest('[data-viewer]')!;
      const stage = viewer.querySelector<HTMLElement>('.viewer-stage')!;
      stage.innerHTML = `<iframe title="${model.dataset.title} 3D" allow="autoplay; fullscreen; xr-spatial-tracking" allowfullscreen
        src="https://sketchfab.com/models/${model.dataset.loadModel}/embed?autostart=1&ui_theme=dark&ui_hint=2&dnt=1"></iframe>`;
      viewer.querySelectorAll('.thumbs button').forEach((b) => b.classList.toggle('is-on', b === model));
    }
    if (yt) {
      const box = yt.closest('.reel')!;
      box.innerHTML = `<iframe title="${yt.dataset.title}" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen
        src="https://www.youtube-nocookie.com/embed/${yt.dataset.loadYoutube}?autoplay=1&rel=0&modestbranding=1&playsinline=1"></iframe>`;
    }
  });
</script>
