---
import Puppet from './Puppet.astro';
import { getData, t, achievements, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { site, softSkills } = getData(lang);
const ui = t(lang);
const driveColor = ['var(--red)', 'var(--sky)', '#2f6e4a'];
---
<section class="about wrap" id="quien-soy" aria-labelledby="about-title">
  <!-- Who: the story on the left, the player card on the right. -->
  <div class="grid about-top">
    <div class="about-intro">
      <h2 class="section-head reveal" id="about-title">{ui.aboutTitle}</h2>
      <p class="statement reveal" style="--d:80ms"><strong>{ui.aboutLead}</strong> {ui.aboutRest}</p>
      <div class="about-copy reveal" style="--d:160ms">
        <p class="about-lead">{ui.moreLead}</p>
        <p>{ui.moreText}</p>
      </div>
      <div class="perks reveal" style="--d:220ms">
        <h3 class="mini-head">{ui.perks}</h3>
        <ul>{softSkills.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>

    <article class="card reveal" style="--d:120ms" aria-label={ui.card}>
      <div class="card-art">
        <Puppet pose="calm" class="card-puppet" label={ui.cardCanvas} />
      </div>
      <dl class="card-plate">
        <div class="plate-name"><dt class="sr">{ui.player}</dt><dd>{site.name.first} {site.name.last}</dd></div>
        <div><dt>{ui.klass}</dt><dd>{site.role}</dd></div>
        {site.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
      </dl>
    </article>
  </div>

  <!-- Why: three drives, each in its own colour. -->
  <div class="drives">
    <h3 class="sub-head reveal">{ui.drivesTitle}</h3>
    <ul>
      {ui.drives.map((d, i) => (
        <li class={`drive drive-${d.anim} reveal`} style={`--d:${i * 90}ms; --c:${driveColor[i]}`} data-anim={d.anim} tabindex="0">
          <span class="drive-art">
            <span class="drive-face">
              <Puppet pose={d.anim} />
              {d.anim === 'learn' && (
                <svg class="book" viewBox="0 0 120 60" aria-hidden="true">
                  <path d="M6 14 Q33 4 60 14 Q87 4 114 14 V56 Q87 46 60 56 Q33 46 6 56 Z" fill="#b02e2e" />
                  <path d="M10 12 Q34 2 58 12 V50 Q34 40 10 50 Z M62 12 Q86 2 110 12 V50 Q86 40 62 50 Z" fill="#fff" />
                  <path d="M18 18 Q34 12 50 18 M18 26 Q34 20 50 26 M18 34 Q34 28 46 33 M70 18 Q86 12 102 18 M70 26 Q86 20 102 26 M70 34 Q86 28 98 33" stroke="#363636" stroke-width="2.4" stroke-linecap="round" fill="none" opacity=".55" />
                </svg>
              )}
            </span>
            {d.prop && <span class="drive-prop" aria-hidden="true">{d.prop}</span>}
          </span>
          <strong>{d.title}</strong>
          <span class="drive-text">{d.text}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Proof: real milestones that unlock as they scroll in. -->
  <div class="trophies">
    <div class="trophies-head">
      <h3 class="sub-head reveal">{ui.achievements}</h3>
      <a class="btn reveal" href="#proyectos">{ui.visitWorlds} <span class="arrow" aria-hidden="true">↓</span></a>
    </div>
    <ul>
      {achievements[lang].map((a, i) => (
        <li class="trophy reveal" style={`--d:${80 + i * 70}ms`}>
          <span class="cup" aria-hidden="true"><span class="star"></span></span>
          <span class="trophy-text">
            <strong>{a.title}</strong>
            <span>{a.text}</span>
          </span>
          <span class="unlock" aria-hidden="true">{ui.unlocked}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding-top: var(--section);
    padding-bottom: var(--section);
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- Who ---------- */

  .about-top {
    align-items: center;
    row-gap: 48px;
  }

  .about-intro {
    grid-column: 1 / span 7;
    display: grid;
    gap: 28px;
  }

  .statement {
    font-size: clamp(24px, 2.4vw, 36px);
    line-height: 1.18;
    letter-spacing: -0.01em;
    max-width: 30ch;
  }

  .statement strong {
    font-weight: 800;
  }

  .about-copy {
    display: grid;
    gap: 14px;
    max-width: 56ch;
    font-size: 17px;
  }

  .about-lead {
    font-size: clamp(19px, 1.5vw, 22px);
    font-weight: 600;
    line-height: 1.35;
  }

  .mini-head {
    font-size: var(--step-small);
    font-weight: 700;
    margin-bottom: 12px;
  }

  .perks ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .perks li {
    padding: 7px 14px;
    border-radius: var(--radius);
    border: 2px solid var(--ink);
    background: var(--paper);
    font-weight: 600;
    font-size: 15px;
    transition: transform 0.3s var(--ease-spring), background-color 0.2s, color 0.2s;
  }

  .perks li:hover {
    transform: translateY(-3px) rotate(-2deg);
    background: var(--red);
    color: var(--on-dark);
  }

  /* The player card: José on sky blue, the complement of the peach ground. He watches the cursor. */
  .card {
    grid-column: 9 / span 4;
    background: var(--paper);
    border-radius: 24px;
    overflow: hidden;
    transform: rotate(1.5deg);
    transition: transform 0.5s var(--ease-spring);
    border: 3px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
  }

  .card:hover {
    transform: rotate(0deg) translateY(-6px);
  }

  .card-art {
    position: relative;
    background: var(--sky);
    aspect-ratio: 420 / 400;
    overflow: hidden;
  }

  /* The camera flash when he poses for the card photo. */
  .card-art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
    pointer-events: none;
  }

  .card-art.flash::after {
    animation: flash-photo 0.6s ease-out;
  }

  @keyframes flash-photo {
    0% { opacity: 0.85; }
    100% { opacity: 0; }
  }

  .card-art :global(.card-puppet) {
    position: absolute;
    left: 50%;
    bottom: 0;
    height: 104%;
    width: auto;
    max-width: none;
    aspect-ratio: 420 / 520;
    translate: -50% 0;
  }

  .card-plate {
    margin: 0;
    padding: 20px 22px 24px;
    background: var(--paper);
    display: grid;
    gap: 9px;
  }

  .card-plate div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 15px;
  }

  .card-plate dt {
    font-weight: 700;
  }

  .card-plate dd {
    margin: 0;
    text-align: right;
  }

  .plate-name dd {
    font-size: 22px;
    font-weight: 900;
    font-stretch: 125%;
    text-transform: uppercase;
    text-align: left;
    color: var(--red);
  }

  /* ---------- Why ---------- */

  .sub-head {
    font-size: clamp(28px, 2.6vw, 40px);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.05;
  }

  .drives {
    margin-top: clamp(64px, 8vw, 128px);
  }

  .drives ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    margin-top: 24px;
  }

  .drive {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 24px 24px 28px;
    border-radius: 22px;
    border: 2.5px solid var(--ink);
    box-shadow: 5px 5px 0 var(--ink);
    background: var(--paper);
    outline: none;
    transition: transform 0.35s var(--ease-spring), background-color 0.3s, color 0.3s;
  }

  .drive:hover,
  .drive:focus-visible,
  .drive.is-on {
    transform: translateY(-8px) rotate(-1deg);
    background: var(--c);
    color: var(--on-dark);
  }

  .drive:focus-visible {
    box-shadow: 5px 5px 0 var(--ink), 0 0 0 5px var(--yellow);
  }

  .drive-art {
    position: relative;
    justify-self: start;
    margin-bottom: 8px;
  }

  .drive-face {
    position: relative;
    display: block;
    width: clamp(88px, 7.5vw, 112px);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--c);
    box-shadow: 0 0 0 4px var(--paper);
  }

  /* Props that come with each gesture: a speech bubble for the story, a book and "+1 level" for learning. */
  .book {
    position: absolute;
    left: 50%;
    bottom: -4%;
    width: 78%;
    translate: -50% 110%;
    transition: translate 0.45s var(--ease-spring);
  }

  .drive.is-on .book {
    translate: -50% 0;
  }

  .drive-prop {
    position: absolute;
    left: calc(100% + 10px);
    top: 2%;
    padding: 7px 13px;
    border-radius: 16px 16px 16px 4px;
    background: var(--ink);
    color: var(--on-dark);
    font-size: 15px;
    font-weight: 800;
    white-space: nowrap;
    opacity: 0;
    transform: scale(0.5) translateY(8px);
    transform-origin: 0 100%;
    transition: transform 0.4s var(--ease-spring), opacity 0.2s;
    pointer-events: none;
  }

  .drive-story.is-on .drive-prop,
  .drive-learn.is-aha .drive-prop {
    opacity: 1;
    transform: none;
  }

  .drive-learn .drive-prop {
    background: #f2c14e;
    color: var(--ink);
  }

  .drive.is-on .drive-prop {
    background: var(--paper);
    color: var(--ink);
  }

  .drive-learn.is-on .drive-prop {
    background: #f2c14e;
  }

  .drive-face :global(.pp) {
    position: absolute;
    left: 50%;
    bottom: -26%;
    width: 128%;
    height: auto;
    translate: -50% 0;
  }

  .drive strong {
    font-size: clamp(24px, 2.2vw, 34px);
    font-weight: 900;
    font-stretch: 125%;
    text-transform: uppercase;
    line-height: 1;
  }

  .drive-text {
    font-size: 17px;
    max-width: 30ch;
  }

  /* ---------- Proof ---------- */

  .trophies {
    margin-top: clamp(56px, 7vw, 112px);
  }

  .trophies-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px 24px;
  }

  .trophies ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 28px;
  }

  .trophy {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: center;
    padding: 16px 18px;
    border-radius: 16px;
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    background: var(--paper);
    transition: transform 0.3s var(--ease-spring);
  }

  .trophy:hover {
    transform: translateY(-3px) rotate(-0.6deg);
  }

  .cup {
    position: relative;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #f2c14e;
    border: 3px solid #e2a53a;
  }

  .star {
    width: 20px;
    height: 20px;
    background: var(--paper);
    clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  }

  :global(.js) .trophy.reveal.is-in .cup {
    animation: unlock 0.7s var(--ease-spring) both;
    animation-delay: calc(var(--d, 0ms) + 200ms);
  }

  @keyframes unlock {
    0% { transform: scale(0.4) rotate(-40deg); }
    100% { transform: none; }
  }

  .trophy-text {
    display: grid;
    gap: 2px;
    line-height: 1.25;
  }

  .trophy-text strong {
    font-size: 17px;
    font-weight: 800;
  }

  .trophy-text span {
    font-size: 15px;
  }

  .unlock {
    position: absolute;
    right: 10px;
    top: -10px;
    padding: 3px 10px;
    border-radius: var(--radius);
    background: var(--ink);
    color: #f2c14e;
    font-size: 13px;
    font-weight: 800;
    visibility: hidden;
  }

  :global(.js) .trophy.reveal.is-in .unlock {
    animation: flash 2.2s var(--ease-out) both;
    animation-delay: calc(var(--d, 0ms) + 260ms);
  }

  @keyframes flash {
    0% { visibility: visible; transform: translateY(6px) scale(0.8); }
    15% { visibility: visible; transform: none; }
    85% { visibility: visible; transform: none; }
    100% { visibility: hidden; transform: translateY(-6px); }
  }

  /* ---------- Smaller screens ---------- */

  @media (max-width: 1100px) {
    .about-intro {
      grid-column: 1 / span 7;
    }

    .card {
      grid-column: 8 / span 5;
    }

    .trophies ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .statement {
      font-size: 24px;
    }

    .card-plate div {
      font-size: 14px;
    }

    .drives ul {
      grid-template-columns: minmax(0, 1fr);
    }

    .drive {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 18px;
      align-items: center;
      padding: 16px 20px 16px 16px;
    }

    .drive-art {
      grid-row: span 2;
      margin: 0;
    }

    .drive-face {
      width: 84px;
    }

    .drive-prop {
      left: 62px;
      top: -14px;
      font-size: 13px;
    }

    .drive strong {
      font-size: 24px;
      align-self: end;
    }

    .drive-text {
      align-self: start;
      font-size: 16px;
    }
  }

  @media (max-width: 700px) {
    .about-intro,
    .card {
      grid-column: 1 / -1;
    }

    .card {
      width: min(100%, 400px);
      justify-self: center;
      transform: rotate(1deg);
    }
  }

  @media (max-width: 600px) {
    .trophies ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import { mountPuppet, type Anim } from '../scripts/puppet';

  // The card portrait watches the cursor and laughs when you come close.
  const card = document.querySelector<HTMLElement>('.about .card');
  const canvas = card?.querySelector<SVGSVGElement>('svg.card-puppet');
  if (card && canvas) {
    const p = mountPuppet(canvas, 'idle', { follow: true });
    const art = card.querySelector<HTMLElement>('.card-art')!;
    canvas.addEventListener('pp-beat', () => {
      art.classList.remove('flash');
      void art.offsetWidth;
      art.classList.add('flash');
    });
    card.addEventListener('pointerenter', () => p.play('pose'));
    card.addEventListener('pointerleave', () => p.play('idle'));
  }

  // Each "what drives me" portrait acts out its drive while hovered or focused
  // (on touch screens, while the card sits in the middle of the screen).
  const touch = matchMedia('(pointer: coarse)').matches;
  document.querySelectorAll<HTMLElement>('.drive').forEach((li) => {
    const svg = li.querySelector<SVGSVGElement>('svg.pp');
    if (!svg) return;
    const d = mountPuppet(svg, 'idle');
    let aha = 0;
    const on = () => { li.classList.add('is-on'); d.play(li.dataset.anim as Anim); };
    const off = () => { li.classList.remove('is-on', 'is-aha'); d.play('idle'); };
    svg.addEventListener('pp-beat', () => {
      li.classList.add('is-aha');
      clearTimeout(aha);
      aha = window.setTimeout(() => li.classList.remove('is-aha'), 1300);
    });
    li.addEventListener('mouseenter', on);
    li.addEventListener('focus', on);
    li.addEventListener('mouseleave', off);
    li.addEventListener('blur', off);
    if (touch) {
      new IntersectionObserver((e) => (e[0].isIntersecting ? on() : off()), { rootMargin: '-35% 0px -35% 0px' }).observe(li);
    }
  });
</script>
