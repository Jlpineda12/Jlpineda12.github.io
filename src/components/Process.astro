---
// How José works, as a comic sketchbook. It arrives closed (a comic cover); each scroll, or a click
// on a page, opens it and turns a page. Every phase is a panel: a pencil sketch about the craft
// (headphones, a target, a light bulb, a controller and a 3D cube, a bug under a magnifier, a
// rocket) that draws itself, the phase's line in a speech bubble and a handwritten caption. Tap a
// drawing and it reacts with its sound effect. Wide screens open it like a book (pages turn left);
// narrow ones like a notepad bound at the top (pages flip up).
// The deck (scripts/fullpage.ts) drives the steps; without scripts the six pages are simply listed.
import Puppet from './Puppet.astro';
import { getData, t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { process } = getData(lang);
const ui = t(lang);
const lab = ui.lab;
const pages = [
  ...process.map((s) => ({ name: s.name, title: s.title, text: s.text })),
  { name: lab.launchName, title: lab.launchTitle, text: ui.outro },
];

// The sketches (viewBox 0 0 200 120). `.fx` is the part that reacts when poked; `.f` are colour fills.
const ART = [
  // Empathise: José with headphones, listening to someone.
  `<path d="M38 70a22 22 0 1 0 44 0a22 22 0 1 0 -44 0"/><path d="M52 66v4M66 66v4M52 78q7 6 14 0"/>
   <path d="M33 68a27 31 0 0 1 54 0"/><path d="M28 61h9v17h-9zM83 61h9v17h-9z"/><path d="M38 118q22 -30 44 0"/>
   <path d="M125 72a20 20 0 1 0 40 0a20 20 0 1 0 -40 0"/><path d="M138 68v4M152 68v4M141 81a4 3 0 1 0 8 0a4 3 0 1 0 -8 0"/>
   <path d="M126 118q19 -26 38 0"/>
   <g class="fx"><path d="M114 64q-6 9 0 18M106 58q-10 15 0 30M98 52q-14 21 0 42"/></g>
   <path d="M128 8h52a8 8 0 0 1 8 8v16a8 8 0 0 1 -8 8h-26l-10 10l0 -10h-16a8 8 0 0 1 -8 -8v-16a8 8 0 0 1 8 -8z"/>
   <g class="fx beat"><path class="f red" d="M154 20c-3 -5 -11 -2 -8 4l8 8l8 -8c3 -6 -5 -9 -8 -4z"/></g>`,
  // Define: a tangle under the magnifier becomes a straight arrow into a target.
  `<path d="M16 80c4 -16 24 -22 32 -10s-8 24 -18 16s-2 -28 16 -30s24 14 14 26s-28 6 -24 -8s20 -18 28 -6s-4 20 -14 18"/>
   <path d="M14 40a16 16 0 1 0 32 0a16 16 0 1 0 -32 0M42 52l12 12"/>
   <path d="M80 64h34M106 56l8 8l-8 8"/>
   <path d="M130 64a30 30 0 1 0 60 0a30 30 0 1 0 -60 0M141 64a19 19 0 1 0 38 0a19 19 0 1 0 -38 0"/>
   <path class="f red" d="M152 64a8 8 0 1 0 16 0a8 8 0 1 0 -16 0"/>
   <g class="fx dart"><path d="M160 64l26 -26M184 34l8 -2l-2 8M180 30l4 4"/></g>`,
  // Ideate: a light bulb among sticky notes and storyboard frames.
  `<path d="M18 30l36 -4l4 34l-36 4z"/><path d="M26 40l22 -2M27 48l16 -2"/>
   <path d="M146 66l38 4l-4 34l-38 -4z"/><path d="M156 80l4 8l9 -12"/>
   <path d="M14 84h30v24h-30zM48 84h30v24h-30z"/><path d="M22 102l7 -9l7 9M58 98a5 5 0 1 0 10 0a5 5 0 1 0 -10 0"/>
   <path class="f yellow glow" d="M100 18a26 26 0 0 0 -15 47v10h30v-10a26 26 0 0 0 -15 -47z"/>
   <path d="M100 18a26 26 0 0 0 -15 47v10h30v-10a26 26 0 0 0 -15 -47zM88 82h24M91 89h18"/><path d="M93 58l4 -10l3 8l3 -8l4 10"/>
   <g class="fx rays"><path d="M100 10v-8M72 22l-6 -6M128 22l6 -6M66 46h-8M134 46h8"/></g>`,
  // Prototype: a wireframe cube, code and a game controller.
  `<g class="fx cube"><path d="M18 52l25 -14l25 14v30l-25 14l-25 -14zM18 52l25 14l25 -14M43 66v30"/></g>
   <path d="M98 14l-9 9l9 9M146 14l9 9l-9 9M128 10l-12 26"/>
   <g class="fx pad"><path d="M90 74c0 -14 10 -18 20 -18h44c10 0 20 4 20 18c0 16 -4 32 -14 32c-8 0 -10 -10 -18 -10h-20c-8 0 -10 10 -18 10c-10 0 -14 -16 -14 -32z"/>
   <path d="M106 72h14M113 65v14"/><path class="f red" d="M150 66a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"/><path class="f blue" d="M142 76a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"/>
   <path d="M150 66a4 4 0 1 0 8 0a4 4 0 1 0 -8 0M142 76a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"/></g>`,
  // Test: QA. A checklist, and a bug under the magnifier.
  `<path d="M18 22h56v88h-56zM34 16h24v10h-24z"/><path d="M26 42h8v8h-8zM26 62h8v8h-8zM26 82h8v8h-8z"/>
   <path d="M40 46h26M40 66h26M40 86h20"/><path d="M27 46l3 3l6 -7M27 66l3 3l6 -7"/>
   <g class="fx tick"><path d="M27 86l3 3l6 -7"/></g>
   <g class="fx bug"><path class="f green" d="M140 72a14 18 0 1 0 28 0a14 18 0 1 0 -28 0"/>
   <path d="M140 72a14 18 0 1 0 28 0a14 18 0 1 0 -28 0M148 52a6 6 0 1 0 12 0a6 6 0 1 0 -12 0M154 56v32"/>
   <path d="M141 64l-10 -6M140 74h-12M141 84l-10 6M167 64l10 -6M168 74h12M167 84l10 6M151 47l-4 -8M157 47l4 -8"/></g>
   <path d="M118 70a36 36 0 1 0 72 0a36 36 0 1 0 -72 0M128 96l-18 20"/>`,
  // Launch: a rocket taking off.
  `<path d="M36 26v10M31 31h10M164 38v10M159 43h10M150 12v6M147 15h6M56 64v6M53 67h6"/>
   <g class="fx rocket"><path class="f orange" d="M92 74q8 30 8 30q0 0 8 -30z"/>
   <path d="M100 10c15 12 19 36 14 62h-28c-5 -26 -1 -50 14 -62zM86 62l-12 16l12 -4M114 62l12 16l-12 -4"/>
   <path class="f blue" d="M93 38a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"/><path d="M93 38a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"/></g>
   <path d="M46 114c-9 0 -10 -13 1 -12c2 -10 17 -10 18 -1c10 -4 16 9 7 13zM124 114c-7 -10 6 -17 12 -10c4 -9 19 -4 16 6c9 2 6 11 -2 10z"/>`,
];
// Every stroke gets drawn with the pen, in order.
const prep = (svg: string) => {
  let i = 0;
  return svg.replace(/<path /g, () => `<path pathLength="1" style="--i:${i++}" `);
};
const art = ART.map(prep);
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="process book-sec" id="como-trabajo" data-scene="process" aria-labelledby="process-title">
  <h2 class="sr-only" id="process-title">{ui.processTitle}</h2>
  <p class="sr-only">{ui.processLead}</p>

  <!-- The pencil wobble every sketch is drawn with. -->
  <svg class="defs" width="0" height="0" aria-hidden="true">
    <filter id="sketchy"><feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="3" /><feDisplacementMap in="SourceGraphic" scale="2.4" /></filter>
  </svg>

  <div class="book" data-book>
    <div class="pg pg-base">
      <article class="cpage" data-k="5">
        <p class="cap"><b>{num(5)}</b> {pages[5].name}</p>
        <div class="panel" data-poke="5" role="button" tabindex="0" aria-label={lab.poke}>
          <svg class="art" viewBox="0 0 200 120" aria-hidden="true"><g class="pencil" set:html={art[5]} /><g class="ink" set:html={art[5]} /></svg>
          <p class="bubble">{pages[5].title}</p>
          <span class="pow" aria-hidden="true">{lab.pow[5]}</span>
        </div>
        <p class="tx">{pages[5].text} <a class="go" href="#contacto">{ui.outroBtn} →</a></p>
      </article>
    </div>

    {[0, 1, 2].map((k) => (
      <div class="leaf" data-leaf={k} style={`--k:${k}`}>
        <div class="face front">
          {k === 0 ? (
            <div class="cover">
              <p class="cv-top"><span>{lab.vol}</span><span>JLP</span></p>
              <p class="cv-title">{ui.processTitle}</p>
              <p class="cv-sub">{lab.cover}</p>
              <span class="cv-burst" aria-hidden="true">{lab.poke}!</span>
              <span class="cv-pp" aria-hidden="true"><Puppet pose="happy" live={false} view="430 640 820 900" /></span>
            </div>
          ) : (
            <article class="cpage" data-k={2 * k - 1}>
              <p class="cap"><b>{num(2 * k - 1)}</b> {pages[2 * k - 1].name}</p>
              <div class="panel" data-poke={2 * k - 1} role="button" tabindex="0" aria-label={lab.poke}>
                <svg class="art" viewBox="0 0 200 120" aria-hidden="true"><g class="pencil" set:html={art[2 * k - 1]} /><g class="ink" set:html={art[2 * k - 1]} /></svg>
                <p class="bubble">{pages[2 * k - 1].title}</p>
                <span class="pow" aria-hidden="true">{lab.pow[2 * k - 1]}</span>
              </div>
              <p class="tx">{pages[2 * k - 1].text}</p>
            </article>
          )}
        </div>
        <div class="face back">
          <article class="cpage" data-k={2 * k}>
            <p class="cap"><b>{num(2 * k)}</b> {pages[2 * k].name}</p>
            <div class="panel" data-poke={2 * k} role="button" tabindex="0" aria-label={lab.poke}>
              <svg class="art" viewBox="0 0 200 120" aria-hidden="true"><g class="pencil" set:html={art[2 * k]} /><g class="ink" set:html={art[2 * k]} /></svg>
              <p class="bubble">{pages[2 * k].title}</p>
              <span class="pow" aria-hidden="true">{lab.pow[2 * k]}</span>
            </div>
            <p class="tx">{pages[2 * k].text}</p>
          </article>
        </div>
      </div>
    ))}
  </div>

</section>

<style>
  .book-sec {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 14px;
    overflow: hidden;
  }

  .defs { position: absolute; }

  /* ---------- The book ---------- */
  .book {
    --w: min(92vw, 1040px, calc((100svh - 190px) * 1.55));
    --h: calc(var(--w) / 1.55);
    --open: 0;
    --u: calc(var(--h) / 30); /* a unit for type and spacing */
    --ink: #1d1b2a;
    position: relative;
    width: var(--w);
    height: var(--h);
    perspective: 2400px;
    cursor: pointer;
    translate: calc((1 - var(--open)) * var(--w) * -0.25) 0;
    transition: translate 0.9s cubic-bezier(0.6, 0, 0.3, 1);
  }

  .book.is-open { --open: 1; }

  /* A page: sketchbook paper with a faint dot grid. */
  .pg,
  .face {
    position: absolute;
    top: 0;
    left: 50%;
    width: 50%;
    height: 100%;
    padding: calc(var(--u) * 1.4) calc(var(--u) * 1.4) calc(var(--u) * 1.2);
    border-radius: 4px 14px 14px 4px;
    background:
      radial-gradient(circle, #1d1b2a14 1px, #0000 1.4px) 0 0 / calc(var(--u) * 1.2) calc(var(--u) * 1.2),
      #fffaf0;
    box-shadow: inset 14px 0 18px -14px #0005, 0 18px 40px -24px #4a1f5a80;
    overflow: hidden;
  }

  .leaf {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    pointer-events: none;
    z-index: calc(10 - var(--k));
  }

  .leaf .face {
    backface-visibility: hidden;
    transform-origin: 0% 50%;
    transition: transform 1s cubic-bezier(0.6, 0, 0.3, 1);
  }

  .leaf .back {
    left: 0;
    transform-origin: 100% 50%;
    transform: rotateY(180deg);
    border-radius: 14px 4px 4px 14px;
    box-shadow: inset -14px 0 18px -14px #0005, 0 18px 40px -24px #4a1f5a80;
  }

  .leaf.is-flipped { z-index: calc(20 + var(--k)); }
  .leaf.is-flipped .front { transform: rotateY(-180deg); }
  .leaf.is-flipped .back { transform: rotateY(0deg); }

  /* ---------- The cover: a comic book ---------- */
  .leaf[data-leaf='0'] .front { padding: 0; border-radius: 6px 18px 18px 6px; background: none; box-shadow: none; }

  .cover {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    padding: calc(var(--u) * 1.2);
    border: 4px solid var(--ink);
    border-radius: inherit;
    background:
      radial-gradient(circle, #ffffff30 22%, #0000 24%) 0 0 / 12px 12px,
      radial-gradient(120% 90% at 50% 40%, #c556b4, #8a2f86);
    box-shadow: 8px 8px 0 var(--ink), 0 30px 50px -24px #2a0f3a;
    color: #fff;
    overflow: hidden;
  }

  .cv-top {
    justify-self: stretch;
    display: flex;
    justify-content: space-between;
    padding: 4px 10px;
    border: 3px solid var(--ink);
    background: #ffd23f;
    color: var(--ink);
    font-family: var(--comic);
    font-size: calc(var(--u) * 0.95);
    letter-spacing: 0.06em;
  }

  .cv-title {
    align-self: center;
    margin-top: -22%;
    font-family: var(--comic);
    font-size: calc(var(--u) * 3.6);
    line-height: 0.9;
    letter-spacing: 0.02em;
    text-align: center;
    color: #ffd23f;
    -webkit-text-stroke: 2px var(--ink);
    paint-order: stroke fill;
    text-shadow: 4px 4px 0 var(--ink);
    rotate: -4deg;
  }

  .cv-sub {
    align-self: end;
    justify-self: end;
    padding: 4px 12px;
    background: #fffaf0;
    border: 3px solid var(--ink);
    color: var(--ink);
    font-family: var(--hand);
    font-size: calc(var(--u) * 1.3);
    font-weight: 700;
    rotate: 2deg;
  }

  .cv-burst {
    position: absolute;
    right: 5%;
    top: 12%;
    display: grid;
    place-items: center;
    width: calc(var(--u) * 5.2);
    aspect-ratio: 1;
    padding: 10px;
    background: #e5483b;
    clip-path: polygon(50% 0, 61% 18%, 82% 8%, 80% 30%, 100% 36%, 85% 52%, 98% 70%, 76% 72%, 74% 94%, 56% 82%, 40% 100%, 34% 78%, 12% 86%, 18% 64%, 0 52%, 16% 38%, 6% 16%, 28% 20%, 34% 0);
    color: #fff;
    font-family: var(--comic);
    font-size: calc(var(--u) * 0.85);
    line-height: 1;
    text-align: center;
    rotate: 12deg;
  }

  .cv-pp {
    position: absolute;
    left: 7%;
    bottom: 5%;
    width: 27%;
    rotate: -8deg;
    filter: drop-shadow(0 3px 0 #fff) drop-shadow(0 -3px 0 #fff) drop-shadow(3px 0 0 #fff) drop-shadow(-3px 0 0 #fff) drop-shadow(4px 4px 0 var(--ink));
  }

  .cv-pp :global(.pp) { width: 100%; height: auto; overflow: visible; }

  /* ---------- A page of the comic ---------- */
  .cpage {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-items: stretch;
    gap: calc(var(--u) * 0.8);
    height: 100%;
    color: var(--ink);
  }

  /* The caption box with the phase. */
  .cap {
    justify-self: start;
    padding: 2px 12px;
    border: 3px solid var(--ink);
    background: #ffd23f;
    box-shadow: 4px 4px 0 var(--ink);
    font-family: var(--comic);
    font-size: calc(var(--u) * 1.5);
    letter-spacing: 0.04em;
    line-height: 1.15;
    rotate: -2deg;
  }

  .cap b { color: #e5483b; font-weight: 400; }

  /* The panel: inked border, the sketch, the speech bubble. */
  .panel {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    margin-top: calc(var(--u) * 1.2);
    border: 3px solid var(--ink);
    border-radius: 3px;
    background:
      radial-gradient(circle, #a8459c1c 1.2px, #0000 1.6px) 0 0 / 7px 7px,
      #fff;
    box-shadow: 5px 5px 0 var(--ink);
    cursor: pointer;
    pointer-events: auto;
    rotate: 0.6deg;
    transition: rotate 0.2s, translate 0.2s;
  }

  .panel:hover { rotate: -0.4deg; translate: 0 -2px; }
  .panel:focus-visible { outline: 3px dashed #e5483b; outline-offset: 4px; }

  /* Laid over the panel, so the drawing always fits whatever room the page leaves it. */
  .art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: calc(var(--u) * 2.2) 6% 5%;
    overflow: visible;
  }

  .art :global(path) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ink { filter: url(#sketchy); }
  .pencil { opacity: 0.28; translate: 1.4px 1px; }
  .pencil :global(path) { stroke-width: 1.2; }

  .art :global(.f) { stroke: none; opacity: 0; transition: opacity 0.4s 1.4s; }
  .art :global(.pencil .f) { display: none; }
  .art :global(.red) { fill: #e5483b; }
  .art :global(.yellow) { fill: #ffe36e; }
  .art :global(.green) { fill: #8fd694; }
  .art :global(.blue) { fill: #7fb0ff; }
  .art :global(.orange) { fill: #ff9a3c; }

  .art :global(.fx) { transform-box: fill-box; transform-origin: center; }

  /* The speech bubble, with its tail. */
  .bubble {
    position: absolute;
    left: 6%;
    top: calc(var(--u) * -1.6);
    max-width: 74%;
    padding: 6px 12px;
    border: 3px solid var(--ink);
    border-radius: 18px;
    background: #fff;
    font-family: var(--comic);
    font-size: calc(var(--u) * 1.1);
    letter-spacing: 0.03em;
    line-height: 1.1;
    rotate: -1.5deg;
  }

  .bubble::after {
    content: '';
    position: absolute;
    left: 22%;
    bottom: -13px;
    width: 16px;
    height: 13px;
    background: var(--ink);
    clip-path: polygon(0 0, 100% 0, 10% 100%);
  }

  /* The sound effect, on a poke. */
  .pow {
    position: absolute;
    right: 4%;
    top: 22%;
    padding: 10px 14px;
    background: #e5483b;
    clip-path: polygon(0 20%, 18% 18%, 22% 0, 40% 14%, 60% 0, 66% 18%, 100% 10%, 84% 40%, 100% 62%, 78% 70%, 82% 100%, 56% 84%, 34% 100%, 28% 80%, 0 88%, 12% 56%);
    color: #ffd23f;
    font-family: var(--comic);
    font-size: calc(var(--u) * 1.4);
    letter-spacing: 0.04em;
    scale: 0;
    rotate: 10deg;
    pointer-events: none;
  }

  .tx {
    font-family: var(--hand);
    font-size: calc(var(--u) * 1.15);
    font-weight: 700;
    line-height: 1.15;
  }

  .go { color: #e5483b; text-decoration: underline; text-underline-offset: 4px; pointer-events: auto; }

  /* ---------- Drawn as the page lands ---------- */
  .cpage > :is(.cap, .tx),
  .bubble { clip-path: inset(0 100% 0 0); }
  .art :global(path) { stroke-dasharray: 1; stroke-dashoffset: 1; }

  .cpage.is-written > :is(.cap, .tx),
  .cpage.is-written .bubble { clip-path: inset(-20px -20px -20px -20px); transition: clip-path 0.6s steps(14, end); }
  .cpage.is-written .bubble { transition-delay: 1.1s; }
  .cpage.is-written > .tx { transition-delay: 1.5s; transition-duration: 1.2s; transition-timing-function: steps(40, end); }
  .cpage.is-written .art :global(path) {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.5s ease-out calc(0.2s + var(--i) * 0.09s);
  }
  .cpage.is-written .art :global(.f) { opacity: 1; }

  /* ---------- Poked: each sketch reacts ---------- */
  .panel.is-poked .pow { animation: pow 0.9s cubic-bezier(0.3, 1.6, 0.5, 1) both; }
  @keyframes pow {
    0% { scale: 0; rotate: -20deg; }
    25% { scale: 1.15; rotate: 8deg; }
    75% { scale: 1; rotate: 10deg; opacity: 1; }
    100% { scale: 0.9; opacity: 0; }
  }

  .panel.is-poked { animation: shake 0.35s; }
  @keyframes shake { 30% { translate: -3px 1px; } 60% { translate: 3px -1px; } }

  [data-k='0'] .is-poked :global(.fx:not(.beat)) { animation: waves 0.8s ease-out; }
  [data-k='0'] .is-poked :global(.beat) { animation: beat 0.8s; }
  @keyframes waves { 0%, 100% { opacity: 1; translate: 0; } 50% { opacity: 0.2; translate: -8px 0; } }
  @keyframes beat { 30% { scale: 1.5; } 60% { scale: 0.9; } }

  [data-k='1'] .is-poked :global(.dart) { animation: dart 0.6s cubic-bezier(0.2, 0.9, 0.3, 1.2); }
  @keyframes dart { 0% { translate: 60px -60px; opacity: 0; } 60% { translate: 0 0; opacity: 1; } 75% { rotate: -6deg; } }

  [data-k='2'] .is-poked :global(.glow) { animation: glow 1s; }
  [data-k='2'] .is-poked :global(.rays) { animation: rays 1s; }
  @keyframes glow { 20%, 70% { fill: #ffd23f; filter: drop-shadow(0 0 10px #ffd23f); } }
  @keyframes rays { 0% { scale: 0.6; opacity: 0; } 30% { scale: 1.2; opacity: 1; } }

  [data-k='3'] .is-poked :global(.pad) { animation: pad 0.5s; }
  [data-k='3'] .is-poked :global(.cube) { animation: cube 0.8s ease-in-out; }
  @keyframes pad { 20% { rotate: -8deg; } 50% { rotate: 6deg; scale: 1.06; } 80% { rotate: -3deg; } }
  @keyframes cube { 50% { rotate: 90deg; scale: 0.9; } 100% { rotate: 180deg; } }

  /* Testing: the bug gets squashed and the last box on the checklist ticks itself. */
  [data-k='4'] .is-poked :global(.bug) { animation: squash 1.4s forwards; }
  .cpage[data-k='4'] .art :global(.tick path) { stroke-dashoffset: 1; }
  .cpage[data-k='4'] .is-poked .art :global(.tick path) { stroke-dashoffset: 0; transition: stroke-dashoffset 0.3s 0.4s; }
  @keyframes squash { 15% { scale: 1.2 0.4; } 30%, 80% { scale: 1.3 0.15; opacity: 1; } 100% { scale: 1.3 0.15; opacity: 0.25; } }

  [data-k='5'] .is-poked :global(.rocket) { animation: launch 1.4s cubic-bezier(0.5, 0, 0.3, 1); }
  @keyframes launch { 10% { translate: -2px 2px; } 15% { translate: 2px 0; } 55% { translate: 0 -220px; opacity: 1; } 56% { opacity: 0; translate: 0 140px; } 100% { opacity: 1; translate: 0 0; } }

  .turn {
    font-family: var(--hand);
    font-size: 20px;
    font-weight: 700;
    color: color-mix(in oklab, var(--fg) 55%, transparent);
    rotate: -2deg;
  }

  /* ---------- Narrow screens: a notepad bound at the top, pages flip up ---------- */
  @media (max-aspect-ratio: 1/1) {
    .book {
      --w: min(92vw, 520px);
      --h: min(74svh, calc(var(--w) * 1.9));
      --u: calc(var(--h) / 44);
      translate: 0 calc((1 - var(--open)) * var(--h) * -0.25);
    }

    .pg,
    .face {
      left: 0;
      top: 50%;
      width: 100%;
      height: 50%;
      border-radius: 4px 4px 14px 14px;
      padding: calc(var(--u) * 1) 14px calc(var(--u) * 0.8);
    }

    .leaf .face { transform-origin: 50% 0%; }
    .leaf .back { top: 0; left: 0; transform-origin: 50% 100%; transform: rotateX(-180deg); border-radius: 14px 14px 4px 4px; }
    .leaf.is-flipped .front { transform: rotateX(180deg); }
    .leaf.is-flipped .back { transform: rotateX(0deg); }

    .leaf[data-leaf='0'] .front { border-radius: 6px 6px 18px 18px; }
    .cpage { gap: calc(var(--u) * 0.6); }
    .cap { font-size: calc(var(--u) * 1.6); }
    .bubble { font-size: calc(var(--u) * 1.2); }
    .tx { font-size: calc(var(--u) * 1.25); }
    .cv-title { font-size: calc(var(--u) * 4); margin-top: 0; }
    .cv-pp { width: 22%; }
  }

  /* Without scripts: the pages, one after another. */
  :global(html:not(.js)) .book { width: auto; height: auto; translate: none; display: grid; gap: 12px; }
  :global(html:not(.js)) :is(.pg, .face) { position: relative; left: 0; width: 100%; height: auto; transform: none; }
  :global(html:not(.js)) .leaf { position: relative; }
  :global(html:not(.js)) .cpage > *,
  :global(html:not(.js)) .bubble { clip-path: none; }
  :global(html:not(.js)) .art path { stroke-dashoffset: 0; }

  @media (prefers-reduced-motion: reduce) {
    .leaf .face, .book { transition: none; }
    .cpage > *, .bubble { clip-path: none !important; }
    .art :global(path) { stroke-dashoffset: 0 !important; }
  }
</style>

<script>
  // Steps (from the deck): 0 closed, 1 open at Empathise/Define, 2 Ideate/Prototype, 3 Test/Launch.
  const sec = document.querySelector<HTMLElement>('.book-sec');
  const book = sec?.querySelector<HTMLElement>('[data-book]');
  const slide = sec?.closest<HTMLElement>('[data-slide]');
  if (sec && book && slide) {
    const leaves = [...book.querySelectorAll<HTMLElement>('.leaf')];
    const visible = (k: number): HTMLElement[] => {
      if (k <= 0) return [];
      const left = leaves[k - 1].querySelector<HTMLElement>('.back .cpage');
      const right = k < leaves.length ? leaves[k].querySelector<HTMLElement>('.front .cpage') : book.querySelector<HTMLElement>('.pg-base .cpage');
      return [left, right].filter((x): x is HTMLElement => !!x);
    };
    let timer = 0;
    const set = (k: number) => {
      book.classList.toggle('is-open', k > 0);
      leaves.forEach((l, i) => l.classList.toggle('is-flipped', i < k));
      book.querySelectorAll('.cpage.is-written').forEach((n) => n.classList.remove('is-written'));
      book.querySelectorAll('.panel.is-poked').forEach((n) => n.classList.remove('is-poked'));
      clearTimeout(timer);
      timer = window.setTimeout(() => visible(k).forEach((n) => n.classList.add('is-written')), k > 0 ? 700 : 0);
      // Only the drawings on the open spread can be reached with the keyboard.
      const open = visible(k);
      book.querySelectorAll<HTMLElement>('.panel').forEach((p) => (p.tabIndex = open.some((n) => n.contains(p)) ? 0 : -1));
      book.querySelectorAll<HTMLElement>('.go').forEach((a) => (a.tabIndex = open.some((n) => n.contains(a)) ? 0 : -1));
    };
    slide.addEventListener('fp-step', (e) => set((e as CustomEvent<number>).detail));

    // Poking a drawing plays its reaction (and its sound effect) instead of turning the page.
    const poke = (p: HTMLElement) => {
      p.classList.remove('is-poked');
      void p.offsetWidth;
      p.classList.add('is-poked');
    };
    book.querySelectorAll<HTMLElement>('.panel').forEach((p) => {
      p.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); e.stopPropagation(); poke(p); }
      });
    });

    // A click on the right-hand (lower) page turns forward; on the left (upper) one, back.
    book.addEventListener('click', (e) => {
      const target = e.target as Element;
      if (target.closest('a')) return;
      const panel = target.closest<HTMLElement>('.panel');
      if (panel) return poke(panel);
      const r = book.getBoundingClientRect();
      const portrait = matchMedia('(max-aspect-ratio: 1/1)').matches;
      const ev = e as MouseEvent;
      const forward = portrait ? ev.clientY > r.top + r.height / 2 : ev.clientX > r.left + r.width / 2;
      window.dispatchEvent(new Event(forward ? 'fp-next' : 'fp-prev'));
    });
    set(0);
  }
</script>
