---
// How José works, written by hand in his notebook. It arrives closed; each scroll (or a click on
// the page) opens the cover and turns a page: Empathise and Define, Ideate and Prototype, Test and
// Launch, every phase in his handwriting with a doodle that draws itself. On wide screens it opens
// like a book (pages turn left); on narrow ones like a notepad bound at the top (pages flip up).
// The deck (scripts/fullpage.ts) drives the steps; without scripts the six pages are simply listed.
import Puppet from './Puppet.astro';
import { getData, t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { process } = getData(lang);
const ui = t(lang);
const lab = ui.lab;
const pages = [
  ...process.map((s) => ({ name: s.name, title: s.title, text: s.text })),
  { name: lab.launchName, title: lab.launchTitle, text: ui.outro },
];
// Doodles, one per phase (24px grid, drawn with a pen).
const DOODLE = [
  'M5 13a7 7 0 0 1 14 0 M5 13v4a2 2 0 0 0 4 0v-3a2 2 0 0 0-4 0 M19 13v4a2 2 0 0 1-4 0v-3a2 2 0 0 1 4 0',
  'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M12 12l7-7 M16 4h3v3',
  'M9 18h6 M10 21h4 M12 3a6 6 0 0 0-3.5 10.9V16h7v-2.1A6 6 0 0 0 12 3z',
  'M3 21h18 M5 21v-6h6v6 M13 21v-10h6v10 M8 15V9h6 M11 9V5h6v6',
  'M9 7a3 3 0 0 1 6 0 M8 9h8v5a4 4 0 0 1-8 0z M12 9v9 M4 10l4 1 M20 10l-4 1 M4 15h4 M20 15h-4',
  'M12 2c3 2 5 6 5 10l-2 3H9l-2-3c0-4 2-8 5-10z M9 15l-2 4 3-1 M15 15l2 4-3-1 M12 8a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z',
];
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="process book-sec" id="como-trabajo" data-scene="process" aria-labelledby="process-title">
  <h2 class="sr-only" id="process-title">{ui.processTitle}</h2>
  <p class="sr-only">{ui.processLead}</p>

  <div class="book" data-book>
    <!-- Under all the leaves: the last right-hand page. -->
    <div class="pg pg-base">
      <article class="note">
        <span class="n">{num(5)}</span>
        <svg class="doodle" viewBox="0 0 24 24" aria-hidden="true"><path d={DOODLE[5]} pathLength="1" /></svg>
        <h3 class="nm">{pages[5].name}</h3>
        <p class="ti">{pages[5].title}</p>
        <p class="tx">{pages[5].text}</p>
        <a class="go" href="#contacto">{ui.outroBtn} →</a>
      </article>
    </div>

    <!-- Leaves: a front (a right-hand page) and a back (the next left-hand page). The first is the cover. -->
    {[0, 1, 2].map((k) => (
      <div class="leaf" data-leaf={k} style={`--k:${k}`}>
        <div class="face front">
          {k === 0 ? (
            <div class="cover">
              <span class="elastic" aria-hidden="true"></span>
              <p class="cover-label">{ui.processTitle}</p>
              <p class="cover-sub">{lab.cover}</p>
              <span class="cover-pp" aria-hidden="true"><Puppet pose="happy" live={false} view="430 640 820 900" /></span>
              <span class="cover-star" aria-hidden="true">★</span>
            </div>
          ) : (
            <article class="note">
              <span class="n">{num(2 * k - 1)}</span>
              <svg class="doodle" viewBox="0 0 24 24" aria-hidden="true"><path d={DOODLE[2 * k - 1]} pathLength="1" /></svg>
              <h3 class="nm">{pages[2 * k - 1].name}</h3>
              <p class="ti">{pages[2 * k - 1].title}</p>
              <p class="tx">{pages[2 * k - 1].text}</p>
            </article>
          )}
        </div>
        <div class="face back">
          <article class="note">
            <span class="n">{num(2 * k)}</span>
            <svg class="doodle" viewBox="0 0 24 24" aria-hidden="true"><path d={DOODLE[2 * k]} pathLength="1" /></svg>
            <h3 class="nm">{pages[2 * k].name}</h3>
            <p class="ti">{pages[2 * k].title}</p>
            <p class="tx">{pages[2 * k].text}</p>
          </article>
        </div>
      </div>
    ))}
  </div>

  <p class="turn" aria-hidden="true">{lab.turn} ↓</p>
</section>

<style>
  .book-sec {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 14px;
    overflow: hidden;
  }

  /* ---------- The book ---------- */
  .book {
    --w: min(92vw, 1040px, 128svh);
    --h: calc(var(--w) / 1.55);
    --open: 0;
    --line: calc(var(--h) / 16);
    position: relative;
    width: var(--w);
    height: var(--h);
    perspective: 2400px;
    cursor: pointer;
    /* Closed, the cover sits in the middle; open, the spread does. */
    translate: calc((1 - var(--open)) * var(--w) * -0.25) 0;
    transition: translate 0.9s cubic-bezier(0.6, 0, 0.3, 1);
  }

  .book.is-open { --open: 1; }

  /* A page: paper with lines and a red margin. */
  .pg,
  .face {
    position: absolute;
    top: 0;
    left: 50%;
    width: 50%;
    height: 100%;
    padding: calc(var(--line) * 0.9) calc(var(--w) * 0.035) var(--line) calc(var(--w) * 0.07);
    border-radius: 4px 14px 14px 4px;
    background:
      linear-gradient(90deg, #0000 calc(var(--w) * 0.05), #d6455a66 calc(var(--w) * 0.05) calc(var(--w) * 0.05 + 2px), #0000 0),
      repeating-linear-gradient(#0000 0 calc(var(--line) - 1px), #7c90da40 calc(var(--line) - 1px) var(--line)),
      #fffdf6;
    box-shadow: inset 14px 0 18px -14px #0005, 0 18px 40px -24px #4a1f5a80;
    overflow: hidden;
  }

  .leaf {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    pointer-events: none;
    z-index: calc(10 - var(--k));
  }

  .leaf .face {
    backface-visibility: hidden;
    transform-origin: 0% 50%;
    transition: transform 1s cubic-bezier(0.6, 0, 0.3, 1);
  }

  /* The back of a leaf is pre-turned, so it reads right once the leaf is over on the left. */
  .leaf .back {
    left: 0;
    transform-origin: 100% 50%;
    transform: rotateY(180deg);
    border-radius: 14px 4px 4px 14px;
    box-shadow: inset -14px 0 18px -14px #0005, 0 18px 40px -24px #4a1f5a80;
  }

  .leaf.is-flipped { z-index: calc(20 + var(--k)); }
  .leaf.is-flipped .front { transform: rotateY(-180deg); }
  .leaf.is-flipped .back { transform: rotateY(0deg); }

  /* ---------- The cover ---------- */
  .leaf[data-leaf='0'] .front { padding: 0; border-radius: 6px 18px 18px 6px; background: none; box-shadow: none; }

  .cover {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 10px;
    border-radius: inherit;
    background:
      radial-gradient(120% 80% at 30% 20%, #ffffff26, #fff0 60%),
      repeating-linear-gradient(45deg, #ffffff06 0 2px, #0000 2px 6px),
      #7a3a8c;
    box-shadow: inset 8px 0 0 #00000030, inset -2px 0 0 #ffffff22, 0 24px 50px -24px #2a0f3a;
    color: #fff;
  }

  .elastic { position: absolute; top: 0; bottom: 0; right: 14%; width: 10px; background: #2a2a2e; box-shadow: inset 2px 0 0 #ffffff30; }

  .cover-label {
    padding: 8px 24px;
    background: #fffdf6;
    color: #2b3a8f;
    font-family: var(--hand);
    font-size: clamp(1.8rem, 1rem + 2.6vw, 3.2rem);
    font-weight: 700;
    rotate: -3deg;
    box-shadow: 0 6px 12px -6px #0006;
  }

  .cover-sub { font-size: 12px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.8; }

  .cover-pp {
    position: absolute;
    left: 9%;
    bottom: 7%;
    width: 22%;
    rotate: -10deg;
    filter: drop-shadow(0 3px 0 #fff) drop-shadow(0 -3px 0 #fff) drop-shadow(3px 0 0 #fff) drop-shadow(-3px 0 0 #fff) drop-shadow(0 8px 10px #0005);
  }

  .cover-pp :global(.pp) { width: 100%; height: auto; overflow: visible; }

  .cover-star { position: absolute; right: 26%; top: 12%; font-size: 34px; color: #ffd23f; rotate: 14deg; }

  /* ---------- Handwritten notes, sitting on the lines ---------- */
  .note {
    position: relative;
    display: grid;
    align-content: start;
    height: 100%;
    font-family: var(--hand);
    color: #2b3a8f;
    line-height: var(--line);
  }

  .n {
    justify-self: start;
    padding: 0 10px;
    border: 2.5px solid #d6455a;
    border-radius: 50% 46% 52% 44%;
    color: #d6455a;
    font-size: calc(var(--line) * 0.75);
    line-height: 1.2;
    font-weight: 700;
    rotate: -6deg;
  }

  .doodle {
    position: absolute;
    right: 0;
    top: 0;
    z-index: -1;
    width: calc(var(--w) * 0.08);
    fill: none;
    stroke: #d6455a;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    rotate: 6deg;
  }

  .nm {
    font-size: calc(var(--line) * 1.7);
    line-height: calc(var(--line) * 2);
    font-weight: 700;
    color: #2a2a2e;
  }

  .ti {
    justify-self: start;
    max-width: 100%;
    font-size: calc(var(--line) * 0.95);
    font-weight: 700;
    background: linear-gradient(transparent 62%, #ffd23f99 0);
  }

  .tx { font-size: calc(var(--line) * 0.82); max-width: 32ch; }

  .go { justify-self: start; font-size: calc(var(--line) * 0.9); font-weight: 700; color: #d6455a; text-decoration: underline; text-underline-offset: 5px; }

  /* Written as the page comes into view: each line is uncovered left to right, the doodle drawn. */
  .note > :is(.n, .nm, .ti, .tx, .go) { clip-path: inset(0 100% 0 0); }
  .note .doodle path { stroke-dasharray: 1; stroke-dashoffset: 1; }

  .note.is-written > :is(.n, .nm, .ti, .tx, .go) { clip-path: inset(0 0 0 0); transition: clip-path 0.7s steps(18, end); }
  .note.is-written > .nm { transition-delay: 0.15s; }
  .note.is-written > .ti { transition-delay: 0.6s; }
  .note.is-written > .tx { transition-delay: 1s; transition-duration: 1.4s; transition-timing-function: steps(44, end); }
  .note.is-written > .go { transition-delay: 2.2s; }
  .note.is-written .doodle path { stroke-dashoffset: 0; transition: stroke-dashoffset 1.2s ease-out 0.4s; }

  .turn {
    font-family: var(--hand);
    font-size: 20px;
    font-weight: 700;
    color: color-mix(in oklab, var(--fg) 55%, transparent);
    rotate: -2deg;
  }

  /* ---------- Narrow screens: a notepad bound at the top, pages flip up ---------- */
  @media (max-aspect-ratio: 1/1) {
    .book {
      --w: min(92vw, 520px);
      --h: min(72svh, calc(var(--w) * 1.75));
      --line: calc(var(--h) / 30);
      translate: 0 calc((1 - var(--open)) * var(--h) * -0.25);
    }

    .pg,
    .face {
      left: 0;
      top: 50%;
      width: 100%;
      height: 50%;
      border-radius: 4px 4px 14px 14px;
      padding: calc(var(--line) * 0.6) 16px calc(var(--line) * 0.5) 48px;
      background:
        linear-gradient(90deg, #0000 34px, #d6455a66 34px 36px, #0000 0),
        repeating-linear-gradient(#0000 0 calc(var(--line) - 1px), #7c90da40 calc(var(--line) - 1px) var(--line)),
        #fffdf6;
    }

    .leaf .face { transform-origin: 50% 0%; }
    .leaf .back { top: 0; left: 0; transform-origin: 50% 100%; transform: rotateX(-180deg); border-radius: 14px 14px 4px 4px; }
    .leaf.is-flipped .front { transform: rotateX(180deg); }
    .leaf.is-flipped .back { transform: rotateX(0deg); }

    .leaf[data-leaf='0'] .front { border-radius: 6px 6px 18px 18px; }
    .elastic { top: auto; bottom: 14%; left: 0; right: 0; width: auto; height: 10px; }
    .doodle { width: 46px; }
    .nm { font-size: calc(var(--line) * 1.6); }
    .ti { font-size: calc(var(--line) * 0.95); }
    .tx { font-size: calc(var(--line) * 0.85); }
  }

  /* Without scripts: the pages, one after another. */
  :global(html:not(.js)) .book { width: auto; height: auto; translate: none; display: grid; gap: 12px; }
  :global(html:not(.js)) :is(.pg, .face) { position: relative; left: 0; width: 100%; height: auto; transform: none; }
  :global(html:not(.js)) .leaf { position: relative; }
  :global(html:not(.js)) .note > * { clip-path: none; }

  @media (prefers-reduced-motion: reduce) {
    .leaf .face, .book { transition: none; }
    .note > * { clip-path: none !important; }
  }
</style>

<script>
  // Steps (from the deck): 0 closed, 1 open at Empathise/Define, 2 Ideate/Prototype, 3 Test/Launch.
  const sec = document.querySelector<HTMLElement>('.book-sec');
  const book = sec?.querySelector<HTMLElement>('[data-book]');
  const slide = sec?.closest<HTMLElement>('[data-slide]');
  if (sec && book && slide) {
    const leaves = [...book.querySelectorAll<HTMLElement>('.leaf')];
    // The notes on show at a step: the spread's left page (a leaf's back) and right page.
    const visible = (k: number): HTMLElement[] => {
      if (k <= 0) return [];
      const left = leaves[k - 1].querySelector<HTMLElement>('.back .note');
      const right = k < leaves.length ? leaves[k].querySelector<HTMLElement>('.front .note') : book.querySelector<HTMLElement>('.pg-base .note');
      return [left, right].filter((x): x is HTMLElement => !!x);
    };
    let timer = 0;
    const set = (k: number) => {
      book.classList.toggle('is-open', k > 0);
      leaves.forEach((l, i) => l.classList.toggle('is-flipped', i < k));
      book.querySelectorAll('.note.is-written').forEach((n) => n.classList.remove('is-written'));
      clearTimeout(timer);
      // Written once the page has landed.
      timer = window.setTimeout(() => visible(k).forEach((n) => n.classList.add('is-written')), k > 0 ? 700 : 0);
    };
    slide.addEventListener('fp-step', (e) => set((e as CustomEvent<number>).detail));
    // A click on the right-hand (lower) page turns forward; on the left (upper) one, back.
    book.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) return;
      const r = book.getBoundingClientRect();
      const portrait = matchMedia('(max-aspect-ratio: 1/1)').matches;
      const ev = e as MouseEvent;
      const forward = portrait ? ev.clientY > r.top + r.height / 2 : ev.clientX > r.left + r.width / 2;
      window.dispatchEvent(new Event(forward ? 'fp-next' : 'fp-prev'));
    });
    set(0);
  }
</script>
