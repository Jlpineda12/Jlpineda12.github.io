---
// Who José is. Right after the way in, his Creative ID is found hanging from its lanyard at the top
// of the chapter (grab it, swing it, pull the cord, throw it); under it, his name and his story in
// the quiet column (after Candid's "Studio"), his email in a pill, a card with the facts and a
// controller he modelled in Blender that turns under the pointer. Then his achievements, two by
// two, and his skills.
import Puppet from './Puppet.astro';
import { getData, t, achievements, type Lang } from '../i18n';
import h3d from '../data/hero3d.json';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { site, softSkills } = getData(lang);
const ui = t(lang);
const c = ui.candid;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const spin = (h3d as { spin?: { frames: number; w: number; h: number } }).spin ?? { frames: 24, w: 552, h: 347 };
const gh = site.socials.find((s) => s.icon === 'github');
const li = site.socials.find((s) => s.icon === 'linkedin');
const talk = ui.talk;
const withEmail = (line: string) => line.replace('{email}', site.email);
---
<section data-scene="about" class="studio" id="quien-soy" aria-labelledby="about-title">
  <div class="hang" data-lanyard-scope>
    <div class="lanyard" data-lanyard>
      <div class="strap" aria-hidden="true"><span class="reel"></span></div>
      <span class="cord" aria-hidden="true"></span>
      <div class="swing">
        <svg class="clip" viewBox="0 0 60 92" aria-hidden="true">
          <rect x="16" y="0" width="28" height="18" rx="4" fill="#9aa0ad" />
          <circle cx="30" cy="30" r="13" fill="none" stroke="#b9bec8" stroke-width="7" />
          <path d="M22 40 L18 70 Q16 84 30 86 Q44 84 42 70 L38 40" fill="none" stroke="#c9cdd5" stroke-width="7" stroke-linecap="round" />
          <path d="M30 56 L30 74" stroke="#8b919d" stroke-width="5" stroke-linecap="round" />
        </svg>
        <div class="badge">
          <div class="badge-card id-card">
            <img src={`${base}img/creative-id.webp`} width="889" height="575" loading="lazy" alt={ui.cidAlt} draggable="false" />
            <span class="slot" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col">
    <header class="me reveal">
      <p class="me-kicker">
        {ui.aboutTitle}
        <svg class="flag" viewBox="0 0 30 20" aria-label="Colombia" role="img">
          <rect width="30" height="10" fill="#fcd116" /><rect y="10" width="30" height="5" fill="#003893" /><rect y="15" width="30" height="5" fill="#ce1126" />
        </svg>
      </p>
      <h2 class="me-name" id="about-title">{site.name.first} {site.name.last}</h2>
      <p class="me-role">{site.role}</p>
    </header>

    <!-- His story as a game dialogue: he talks, you pick the questions. -->
    <div class="talk reveal" style="--d:60ms" data-talk data-email={site.email}
      data-hello={talk.hello} data-topics={JSON.stringify(talk.topics)}>
      <div class="talk-box c-card" role="group" aria-label={talk.speaker}>
        <div class="talk-face" aria-hidden="true"><Puppet pose="happy" view="430 640 820 900" /></div>
        <div class="talk-body">
          <p class="talk-name">{talk.speaker}</p>
          <p class="talk-text" aria-live="polite">{talk.hello}</p>
          <button class="talk-next" type="button" aria-label={talk.next} hidden>▾</button>
        </div>
      </div>
      <ul class="talk-qs" aria-label={talk.speaker}>
        {talk.topics.map((tp, i) => (
          <li><button class="talk-q" type="button" data-q={i}><span aria-hidden="true">▸</span> {tp.q}</button></li>
        ))}
      </ul>
      <details class="talk-all">
        <summary>{talk.all}</summary>
        <dl>
          {talk.topics.map((tp) => (
            <div><dt>{tp.q}</dt><dd>{tp.a.map(withEmail).join(' ')}</dd></div>
          ))}
        </dl>
      </details>
      <p class="talk-links">
        <a class="c-pill" href={`mailto:${site.email}?subject=${encodeURIComponent(ui.subject)}`}>{site.email}</a>
        <a class="c-pill" href={gh?.url} target="_blank" rel="noopener">GitHub ↗</a>
        <a class="c-pill" href={li?.url} target="_blank" rel="noopener">LinkedIn ↗</a>
      </p>
    </div>

    <div class="tiles reveal" style="--d:120ms">
      <dl class="tile c-card facts">
        {site.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
      </dl>
      <div class="tile c-card tile-spin" role="img" aria-label={lang === 'es' ? 'Control de videojuego en 3D, modelado en Blender, que gira con el puntero' : 'A 3D game controller, modelled in Blender, that turns with the pointer'}>
        <span class="spin" style={`--n:${spin.frames};--ar:${spin.w / spin.h};background-image:url(${base}hero/spin.webp)`}></span>
        <span class="tile-tag" aria-hidden="true">Blender</span>
      </div>
    </div>

    <hr class="c-rule" />

    <h3 class="c-head reveal">{ui.achievements}</h3>
    <ul class="c-grid2 reveal" style="--d:60ms">
      {achievements[lang].map((a) => (
        <li><strong>{a.title}</strong><span>{a.text}</span></li>
      ))}
    </ul>

    <h3 class="c-head skills-head reveal">{c.skills}</h3>
    <ul class="skills reveal" style="--d:60ms">
      {softSkills.map((s) => <li class="c-pill">{s}</li>)}
    </ul>
  </div>
</section>

<style>
  .flag {
    width: 26px;
    height: auto;
    border-radius: 4px;
    box-shadow: 0 0 0 1px #0000001a;
  }

  .c-text a:not(.c-pill) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 28px;
  }

  .tile {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    perspective: 700px;
  }

  .studio {
    position: relative;
    padding-bottom: clamp(72px, 9vw, 128px);
  }

  /* The ID hangs from the top edge of the chapter, centred, and can swing out over everything. */
  .hang {
    --strap: clamp(64px, 9svh, 110px);
    --badge-w: min(360px, 76vw);
    --badge-h: calc(var(--badge-w) / 1.546);
    position: relative;
    z-index: 3;
    height: calc(var(--strap) + 50px + var(--badge-h) + 56px);
    /* The strap starts at the chapter's top edge: nothing of it shows above. */
    clip-path: inset(0 -100vw -100vh -100vw);
  }

  .badge { container-type: inline-size; }

  /* His name, under the card. */
  .me {
    display: grid;
    justify-items: center;
    gap: 8px;
    margin-bottom: 30px;
    text-align: center;
  }

  .me-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--fg) 65%, transparent);
  }

  .me-kicker .flag { width: 22px; }

  .me-name {
    font-size: clamp(2.6rem, 1.6rem + 4vw, 4.8rem);
    font-weight: 900;
    font-stretch: 125%;
    letter-spacing: -0.03em;
    line-height: 0.92;
    text-wrap: balance;
  }

  .me-role {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* The facts, like the back of a player card. */
  .facts {
    display: grid;
    align-content: center;
    gap: 14px;
    padding: 24px;
    place-items: stretch;
  }

  .facts div { display: grid; gap: 2px; }
  .facts dt { font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #2a2a2e8c; }
  .facts dd { margin: 0; font-weight: 700; line-height: 1.3; }

  /* ---------- The lanyard (scripts/lanyard.ts) ---------- */
  .lanyard {
    position: absolute;
    z-index: 2;
    left: var(--anchor, 50%);
    top: 0;
    width: 0;
    height: 0;
    transition: left 1s var(--ease-out);
  }

  .swing {
    --len: var(--strap);
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    will-change: transform;
  }

  .strap {
    position: absolute;
    left: -15px;
    top: -20px;
    width: 30px;
    height: calc(var(--strap-len, var(--strap)) + 24px);
    transform-origin: 15px 20px;
    rotate: var(--sa, 0deg);
    background:
      linear-gradient(90deg, #00000026 0 3px, #0000 3px calc(100% - 3px), #00000026 0),
      repeating-linear-gradient(0deg, #ffffff12 0 2px, #0000 2px 5px),
      var(--red);
  }

  /* The badge reel at the end of the strap; past it, a thin cord pulls out. */
  .reel {
    position: absolute;
    left: -2px;
    top: calc(100% - 18px);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, #2a2a2e 0 4px, #0000 4.5px),
      radial-gradient(circle at 35% 30%, #fff 0, #e6e8ee 30%, #a9aeb9 75%, #8b919d);
    box-shadow: 0 0 0 3px var(--red), 0 4px 6px #0000004d;
  }

  /* Drawn from the reel to the clip, wherever the card has been pulled. */
  .cord {
    position: absolute;
    left: -1px;
    top: 0;
    width: 2px;
    height: 0;
    border-radius: 2px;
    background: #2a2a2e;
    transform-origin: 1px 0;
  }

  .clip {
    position: absolute;
    left: -21px;
    top: calc(var(--len) - 6px);
    width: 42px;
    max-width: none;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 3px 2px #0000002e);
  }

  .badge {
    position: absolute;
    left: calc(var(--badge-w) / -2);
    top: calc(var(--len) + 50px);
    width: var(--badge-w);
    height: var(--badge-h);
    transform-origin: 50% -30px;
    perspective: 900px;
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .badge.is-grabbed {
    cursor: grabbing;
  }


  .lanyard.is-waiting .swing { visibility: hidden; }

  .id-card {
    position: absolute;
    inset: 0;
    border-radius: 5cqw;
    box-shadow: 0 2px 0 #0000000d, 0 24px 34px -18px #2a2a2e80;
    transform-style: preserve-3d;
  }

  .id-card img {
    width: 100%;
    height: 100%;
    border-radius: 5cqw;
    pointer-events: none;
    -webkit-user-drag: none;
  }

  /* A punched slot for the clip. */
  .slot {
    position: absolute;
    left: 50%;
    top: 1.6cqw;
    width: 15cqw;
    height: 2.4cqw;
    translate: -50% 0;
    border-radius: 99px;
    background: #2a2a2e;
    box-shadow: 0 1px 0 #fff8, inset 0 2px 3px #000;
  }

  .tile-tag {
    position: absolute;
    left: 18px;
    bottom: 12px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #2a2a2e80;
  }

  /* The controller, one frame per angle, side by side in one image. */
  .spin {
    display: block;
    width: 92%;
    aspect-ratio: var(--ar);
    background-size: calc(var(--n) * 100%) 100%;
    background-position: calc(var(--f, 0) / (var(--n) - 1) * 100%) 0;
    background-repeat: no-repeat;
    filter: drop-shadow(0 16px 14px #0000002e);
  }


  /* ---------- The dialogue ---------- */
  .talk { display: grid; gap: 14px; }

  .talk-box {
    position: relative;
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    min-height: 168px;
    padding: 20px 22px 22px;
    border-radius: 28px;
    cursor: pointer;
  }

  .talk-face {
    width: 96px;
    aspect-ratio: 1;
    border-radius: 24px;
    background: radial-gradient(circle at 50% 35%, #ffffffcc, #fff0 70%), var(--accent);
    box-shadow: inset 0 2px 0 #ffffff80, inset 0 -3px 0 #0000001f;
    overflow: hidden;
    display: grid;
    place-items: end center;
  }

  .talk-face :global(.pp) { width: 112%; height: auto; max-width: none; overflow: visible; margin-bottom: -6%; }

  .talk-body { display: grid; gap: 6px; min-width: 0; }

  .talk-name {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .talk-text {
    font-size: clamp(1.05rem, 0.98rem + 0.35vw, 1.25rem);
    font-weight: 600;
    line-height: 1.45;
    min-height: 3em;
  }

  .talk-text :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

  /* The blinking caret while he types, and the little "next" arrow when he is done. */
  .talk-text.is-typing::after {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: currentColor;
    animation: caret 0.8s steps(2) infinite;
  }

  @keyframes caret { 50% { opacity: 0; } }

  .talk-next {
    position: absolute;
    right: 18px;
    bottom: 12px;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-size: 16px;
    cursor: pointer;
    animation: next-bob 1s ease-in-out infinite;
  }

  @keyframes next-bob { 50% { translate: 0 3px; } }

  .talk-qs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .talk-q {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 42px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: #ffffffb3;
    color: var(--ink);
    font-weight: 800;
    font-size: 14.5px;
    cursor: pointer;
    box-shadow: inset 0 1px 0 #fff, 0 0 0 1px #2a2a2e14, 0 8px 16px -12px #2a2a2e80;
    transition: transform 0.3s var(--ease-spring), background-color 0.2s;
  }

  .talk-q:hover { transform: translateY(-2px); background: #fff; }
  .talk-q span { color: var(--accent); }
  .talk-q.is-on { background: var(--ink); color: #fff; }
  .talk-q.is-on span { color: #fff; }
  .talk-q.is-done { opacity: 0.6; }
  .talk-q.is-done span::before { content: '✓ '; }

  .talk-all summary {
    width: max-content;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    color: color-mix(in oklab, var(--fg) 65%, transparent);
  }

  .talk-all dl { display: grid; gap: 12px; margin-top: 12px; }
  .talk-all dt { font-weight: 800; }
  .talk-all dd { margin: 2px 0 0; color: color-mix(in oklab, var(--fg) 75%, transparent); line-height: 1.5; }

  .talk-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }

  @media (max-width: 520px) {
    .talk-box { grid-template-columns: 64px minmax(0, 1fr); gap: 12px; padding: 16px; }
    .talk-face { width: 64px; border-radius: 18px; }
  }

  .skills-head { margin-top: 44px; }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .skills .c-pill { font-size: 14px; }

  @media (max-width: 520px) {
    .tiles { gap: 8px; }
  }
</style>

<script>
  import { initLanyard } from '../scripts/lanyard';
  import { mountPuppet, type Anim } from '../scripts/puppet';

  // ---------- The dialogue ----------
  // He greets you when the chapter comes into view; each question plays its answer line by line,
  // typed out, with his gestures. A tap on the box finishes the line, then moves to the next.
  const talk = document.querySelector<HTMLElement>('[data-talk]');
  const box = talk?.querySelector<HTMLElement>('.talk-box');
  const text = talk?.querySelector<HTMLElement>('.talk-text');
  const next = talk?.querySelector<HTMLButtonElement>('.talk-next');
  const face = talk?.querySelector<SVGSVGElement>('.talk-face svg.pp');
  if (talk && box && text && next) {
    const reducedTalk = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const email = talk.dataset.email || '';
    const hello = talk.dataset.hello || '';
    const topics: { q: string; a: string[]; anims: Anim[] }[] = JSON.parse(talk.dataset.topics || '[]');
    const qs = [...talk.querySelectorAll<HTMLButtonElement>('.talk-q')];
    const puppet = face ? mountPuppet(face, 'happy') : null;
    let lines: string[] = [];
    let anims: Anim[] = [];
    let at = 0;
    let typing = 0;
    let full = '';

    const html = (t: string) =>
      t.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!)
        .replace(email, `<a href="mailto:${email}">${email}</a>`);
    const finish = () => {
      clearInterval(typing);
      typing = 0;
      text.classList.remove('is-typing');
      text.innerHTML = html(full);
      next.hidden = at >= lines.length - 1;
    };
    const say = (t: string, anim: Anim) => {
      full = t.replace('{email}', email);
      puppet?.play(anim);
      next.hidden = true;
      if (reducedTalk) return finish();
      let i = 0;
      text.textContent = '';
      text.classList.add('is-typing');
      clearInterval(typing);
      typing = window.setInterval(() => {
        i += full[i] === ' ' ? 2 : 1;
        text.textContent = full.slice(0, i);
        if (i >= full.length) finish();
      }, 24);
    };
    const play = (k: number) => {
      lines = topics[k].a;
      anims = topics[k].anims;
      at = 0;
      qs.forEach((b, j) => {
        b.classList.toggle('is-on', j === k);
        if (j === k) b.classList.add('is-done');
      });
      say(lines[0], anims[0] || 'happy');
    };
    const advance = () => {
      if (typing) return finish();
      if (at < lines.length - 1) {
        at++;
        say(lines[at], anims[at] || anims[0] || 'happy');
      }
    };
    qs.forEach((b) => b.addEventListener('click', () => play(Number(b.dataset.q))));
    box.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) return;
      advance();
    });
    next.addEventListener('click', (e) => {
      e.stopPropagation();
      advance();
    });
    // The greeting, typed, the first time the box is seen.
    let greeted = false;
    new IntersectionObserver((e) => {
      if (greeted || !e[0].isIntersecting) return;
      greeted = true;
      lines = [hello];
      anims = ['happy'];
      at = 0;
      say(hello, 'happy');
    }, { threshold: 0.6 }).observe(box);
  }

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // The ID swings on its lanyard.
  initLanyard(document.querySelector<HTMLElement>('.studio [data-lanyard]'));

  // The controller turns slowly on its own, and follows the pointer across the tile (or a finger).
  const tile = document.querySelector<HTMLElement>('.studio .tile-spin');
  const spin = tile?.querySelector<HTMLElement>('.spin');
  if (tile && spin) {
    const n = Number(getComputedStyle(spin).getPropertyValue('--n')) || 24;
    let f = 0, held = false, timer = 0;
    const show = (k: number) => {
      f = ((Math.round(k) % n) + n) % n;
      spin.style.setProperty('--f', String(f));
    };
    const idle = () => {
      if (reduced || timer) return;
      timer = window.setInterval(() => { if (!held) show(f + 1); }, 110);
    };
    const rest = () => { clearInterval(timer); timer = 0; };
    tile.addEventListener('pointermove', (e) => {
      const r = tile.getBoundingClientRect();
      held = true;
      show(((e.clientX - r.left) / r.width) * n * 1.5);
    });
    tile.addEventListener('pointerleave', () => { held = false; });
    new IntersectionObserver((e) => (e[0].isIntersecting ? idle() : rest())).observe(tile);
  }
</script>
