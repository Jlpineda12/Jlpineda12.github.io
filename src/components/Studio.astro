---
// Who José is, only the essentials. His Creative ID hangs from its lanyard on the left (grab it,
// swing it, pull the cord, throw it) and stays in view; on the right, a few cards stuck on like
// stickers: his name, his age, his profession and studies, his experience as a QA tester, what he
// makes (his four worlds) and his languages.
import { getData, t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { site, worlds, languages } = getData(lang);
const ui = t(lang);
const b = ui.bento;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const study = site.facts.find((f) => /Estudios|Studies/.test(f.label))?.value ?? '';
// His age, from his birthday (on his Creative ID); the page recounts it when it loads.
const BORN = '2004-08-31';
const ageOn = (d: Date) => {
  const b = new Date(BORN);
  return d.getFullYear() - b.getFullYear() - (d < new Date(d.getFullYear(), b.getMonth(), b.getDate()) ? 1 : 0);
};
const age = ageOn(new Date());
// Simple line icons, drawn on a 24px grid.
const ICON: Record<string, string> = {
  pin: 'M12 21s-6-5.4-6-10.2a6 6 0 1 1 12 0C18 15.6 12 21 12 21z M12 13a2.2 2.2 0 1 0 0-4.4 2.2 2.2 0 0 0 0 4.4z',
  cap: 'M2 9.5 12 4.5l10 5-10 5z M6 11.5V16c0 1.4 2.7 3 6 3s6-1.6 6-3v-4.5 M22 9.5v5',
  chat: 'M4 5h16v11H10l-5 4v-4H4z M8 10h8 M8 13h5',
  juegos: 'M7 8h10a4.5 4.5 0 0 1 4.4 5.5l-.7 3a2.4 2.4 0 0 1-4.2 1L15 16H9l-1.5 1.5a2.4 2.4 0 0 1-4.2-1l-.7-3A4.5 4.5 0 0 1 7 8z M8 11v3 M6.5 12.5h3 M15.5 11.5h.01 M17.5 13.5h.01',
  vr: 'M3 9.5A2.5 2.5 0 0 1 5.5 7h13A2.5 2.5 0 0 1 21 9.5v5a2.5 2.5 0 0 1-2.5 2.5H15l-2-2.5h-2L9 17H5.5A2.5 2.5 0 0 1 3 14.5z',
  '3d': 'M12 3l8 4.5v9L12 21l-8-4.5v-9z M12 12l8-4.5 M12 12v9 M12 12 4 7.5',
  software: 'M8 7 3 12l5 5 M16 7l5 5-5 5 M14 4l-4 16',
  play: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M10 8.5v7l6-3.5z',
  story: 'M4 5.5C6 4.5 9 4.5 12 6c3-1.5 6-1.5 8-.5V19c-2-1-5-1-8 .5-3-1.5-6-1.5-8-.5z M12 6v13.5',
  learn: 'M12 3l2.3 5.6 6 .5-4.6 3.9 1.4 5.9L12 15.8 6.9 18.9l1.4-5.9L3.7 9.1l6-.5z',
  trophy: 'M8 4h8v5a4 4 0 0 1-8 0z M8 6H5a3 3 0 0 0 3 4 M16 6h3a3 3 0 0 1-3 4 M12 13v4 M9 20h6 M10 17h4',
  mail: 'M3 6h18v12H3z M3 7l9 6 9-6',
  bug: 'M9 7a3 3 0 0 1 6 0 M8 9h8v5a4 4 0 0 1-8 0z M12 9v9 M4 10l4 1 M20 10l-4 1 M4 15h4 M20 15h-4 M5 20l3.5-2.5 M19 20l-3.5-2.5',
};
const icon = (k: string) => ICON[k] ?? ICON.learn;
---
<section data-scene="about" class="studio" id="quien-soy" aria-labelledby="about-title">
  <div class="col-wide about-grid">
    <!-- His ID, hanging on the left. -->
    <aside class="id-col">
      <div class="hang" data-lanyard-scope>
        <div class="lanyard" data-lanyard>
          <div class="strap" aria-hidden="true"><span class="reel"></span></div>
          <span class="cord" aria-hidden="true"></span>
          <div class="swing">
            <svg class="clip" viewBox="0 0 60 92" aria-hidden="true">
              <rect x="16" y="0" width="28" height="18" rx="4" fill="#9aa0ad" />
              <circle cx="30" cy="30" r="13" fill="none" stroke="#b9bec8" stroke-width="7" />
              <path d="M22 40 L18 70 Q16 84 30 86 Q44 84 42 70 L38 40" fill="none" stroke="#c9cdd5" stroke-width="7" stroke-linecap="round" />
              <path d="M30 56 L30 74" stroke="#8b919d" stroke-width="5" stroke-linecap="round" />
            </svg>
            <div class="badge">
              <div class="badge-card id-card">
                <img src={`${base}img/creative-id.webp`} width="889" height="575" decoding="async" alt={ui.cidAlt} draggable="false" />
                <span class="slot" aria-hidden="true"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </aside>

    <!-- The essentials, in cards stuck on like stickers. -->
    <div class="bento">
      <article class="card c-card b-intro reveal" style="--rot:-0.6deg">
        <p class="kicker">
          {b.kicker}
          <svg class="flag" viewBox="0 0 30 20" aria-label="Colombia" role="img">
            <rect width="30" height="10" fill="#fcd116" /><rect y="10" width="30" height="5" fill="#003893" /><rect y="15" width="30" height="5" fill="#ce1126" />
          </svg>
        </p>
        <h2 class="me-name" id="about-title">{site.name.first} {site.name.last}</h2>
        <p class="me-bio">{b.short}</p>
      </article>

      <article class="card b-age reveal" style="--d:60ms;--rot:2deg" data-born={BORN}>
        <p class="age-n"><span data-age>{age}</span></p>
        <p class="age-l">{b.age}</p>
      </article>

      <article class="card c-card b-role reveal" style="--d:90ms;--rot:1deg">
        <p class="label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon('cap')} /></svg>{b.role}</p>
        <p class="big">{site.role}</p>
        <p class="small">{study.split(',')[1]?.trim() ?? 'UMNG'} · Universidad Militar Nueva Granada</p>
        <p class="open"><span class="dot" aria-hidden="true"></span>{b.open} · Bogotá</p>
      </article>

      <article class="card b-qa reveal" style="--d:120ms;--rot:-1.4deg">
        <span class="qa-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={icon('bug')} /></svg></span>
        <p class="qa-k">{b.qaKicker}</p>
        <p class="qa-t">{b.qaTitle}</p>
        <p class="qa-x">{b.qaText}</p>
      </article>

      <article class="card c-card b-does reveal" style="--d:150ms;--rot:0.5deg">
        <p class="label">{b.does}</p>
        <ul class="worlds">
          {worlds.map((w) => (
            <li style={`--wc:${w.bg}`}>
              <span class="w-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon(w.id)} /></svg></span>
              <span class="w-txt"><strong>{w.name}</strong><span>{w.blurb}</span></span>
            </li>
          ))}
        </ul>
      </article>

      <article class="card c-card b-langs reveal" style="--d:180ms;--rot:-1deg">
        <p class="label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon('chat')} /></svg>{b.langs}</p>
        <ul class="rings">
          {languages.map((l, i) => (
            <li style={`--lv:${i === 0 ? 1 : 0.7}`}>
              <svg viewBox="0 0 44 44" aria-hidden="true"><circle class="rt" cx="22" cy="22" r="18" /><circle class="rf" cx="22" cy="22" r="18" pathLength="100" /></svg>
              <span class="r-code">{i === 0 ? 'ES' : 'EN'}</span>
              <span class="r-name">{l.group}</span>
              <span class="r-lv">{l.items}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .studio {
    position: relative;
    padding-block: clamp(40px, 6vw, 80px) clamp(72px, 9vw, 120px);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(240px, 0.36fr) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 44px);
    align-items: start;
  }

  /* ---------- The ID, hanging on the left and staying in view ---------- */
  .id-col {
    position: sticky;
    top: 0;
  }

  .hang {
    --strap: clamp(70px, 12svh, 140px);
    --badge-w: min(24vw, 300px);
    --badge-h: calc(var(--badge-w) / 1.546);
    position: relative;
    z-index: 3;
    height: calc(var(--strap) + 50px + var(--badge-h) + 70px);
    margin-top: calc(clamp(40px, 6vw, 80px) * -1);
    /* The strap starts at the top edge: nothing of it shows above. */
    clip-path: inset(0 -100vw -100vh -100vw);
  }

  .badge { container-type: inline-size; }

  .id-card {
    position: absolute;
    inset: 0;
    border-radius: 5cqw;
    box-shadow: 0 2px 0 #0000000d, 0 24px 34px -18px #2a2a2e80;
  }

  .id-card img {
    width: 100%;
    height: 100%;
    border-radius: 5cqw;
    pointer-events: none;
    -webkit-user-drag: none;
  }

  .slot {
    position: absolute;
    left: 50%;
    top: 1.6cqw;
    width: 15cqw;
    height: 2.4cqw;
    translate: -50% 0;
    border-radius: 99px;
    background: #2a2a2e;
    box-shadow: 0 1px 0 #fff8, inset 0 2px 3px #000;
  }

  .hang-hint {
    position: absolute;
    left: 50%;
    bottom: 10px;
    translate: -50% 0;
    font-size: 20px;
    font-weight: 700;
    white-space: nowrap;
    color: color-mix(in oklab, var(--fg) 55%, transparent);
    rotate: -3deg;
  }

  /* ---------- The cards: stickers, each a little askew, straightening when pointed at ---------- */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
  }

  .card {
    position: relative;
    padding: clamp(18px, 1.8vw, 26px);
    border-radius: 28px;
    color: var(--ink);
    rotate: var(--rot, 0deg);
    box-shadow: inset 0 1.5px 0 #ffffffe6, 0 18px 34px -22px #1b1f6b66;
    transition: rotate 0.45s var(--ease-spring), translate 0.45s var(--ease-spring);
  }

  .card:hover { rotate: 0deg; translate: 0 -4px; }

  .label {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 12px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2a2a2e99;
  }

  .label svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Name */
  .b-intro { grid-column: span 4; display: grid; gap: 10px; align-content: center; }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2a2a2e99;
  }

  .flag { width: 22px; height: auto; border-radius: 3px; box-shadow: 0 0 0 1px #0000001a; }

  .me-name {
    font-size: clamp(2.2rem, 1.3rem + 3vw, 3.8rem);
    font-weight: 900;
    font-stretch: 125%;
    letter-spacing: -0.03em;
    line-height: 0.9;
  }

  .me-bio { font-size: 1.05rem; font-weight: 600; color: #2a2a2ec4; line-height: 1.45; }

  /* Age: one big number */
  .b-age {
    grid-column: span 2;
    display: grid;
    place-content: center;
    justify-items: center;
    background: var(--accent);
    color: #fff;
    text-align: center;
  }

  .age-n {
    font-size: clamp(4.5rem, 2.5rem + 6vw, 8rem);
    font-weight: 900;
    font-stretch: 125%;
    line-height: 0.85;
    letter-spacing: -0.05em;
    text-shadow: 0 6px 0 #0000002e;
  }

  .age-l { font-size: 14px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.85; }

  /* Profession and studies */
  .b-role { grid-column: span 3; display: grid; align-content: start; gap: 4px; }
  .big { font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.7rem); font-weight: 900; font-stretch: 112%; line-height: 1.1; }
  .small { font-size: 14px; color: #2a2a2ea6; }
  .open { display: flex; align-items: center; gap: 8px; margin-top: 10px; font-size: 14px; font-weight: 800; }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #3fbf6f;
    animation: live 2s ease-out infinite;
  }

  @keyframes live {
    0% { box-shadow: 0 0 0 0 #3fbf6faa; }
    100% { box-shadow: 0 0 0 10px #3fbf6f00; }
  }

  /* QA experience: a dark card with a bug */
  .b-qa {
    grid-column: span 3;
    display: grid;
    align-content: start;
    gap: 4px;
    padding-right: 90px;
    background: var(--ink);
    color: #fff;
  }

  .qa-ico {
    position: absolute;
    right: 20px;
    top: 20px;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 18px;
    background: #ffd23f;
    rotate: 8deg;
  }

  .qa-ico svg { width: 32px; height: 32px; fill: none; stroke: var(--ink); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .qa-k { font-size: 12px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.6; }
  .qa-t { font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.7rem); font-weight: 900; font-stretch: 112%; }
  .qa-x { font-size: 14.5px; line-height: 1.45; opacity: 0.85; }

  /* What he makes: his four worlds */
  .b-does { grid-column: span 4; }

  .worlds {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .worlds li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 10px; align-items: start; }

  .w-ico {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: var(--wc);
    box-shadow: inset 0 2px 0 #ffffff40, inset 0 -2px 0 #0000002e;
    transition: rotate 0.4s var(--ease-spring), scale 0.4s var(--ease-spring);
  }

  .worlds li:hover .w-ico { rotate: -8deg; scale: 1.08; }
  .w-ico svg { width: 24px; height: 24px; fill: none; stroke: #fff; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }

  .w-txt { display: grid; gap: 2px; font-size: 13.5px; line-height: 1.35; color: #2a2a2eb3; }
  .w-txt strong { font-size: 15px; color: var(--ink); }

  /* Languages: two dials */
  .b-langs { grid-column: span 2; }

  .rings { display: grid; gap: 14px; }

  .rings li {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 12px;
    align-items: center;
  }

  .rings svg { grid-row: 1 / 3; width: 56px; height: 56px; rotate: -90deg; }
  .rings circle { fill: none; stroke-width: 6; }
  .rt { stroke: #2a2a2e14; }
  .rf { stroke: var(--accent); stroke-linecap: round; stroke-dasharray: calc(var(--lv) * 100) 100; }

  .r-code {
    position: absolute;
    left: 0;
    top: 50%;
    width: 56px;
    translate: 0 -50%;
    text-align: center;
    font-size: 13px;
    font-weight: 900;
  }

  .r-name { font-weight: 800; align-self: end; }
  .r-lv { font-size: 13px; font-weight: 700; color: #2a2a2ea6; align-self: start; }

  /* Short laptop screens: the same layout, a little tighter. */
  @media (min-width: 1101px) and (max-height: 880px) {
    .bento { gap: 10px; }
    .card { padding: 14px 18px; border-radius: 22px; }
    .label { margin-bottom: 8px; }
    .me-name { font-size: clamp(2rem, 6svh, 3.8rem); }
    .me-bio { font-size: 0.95rem; line-height: 1.35; }
    .age-n { font-size: clamp(3.6rem, 11svh, 8rem); }
    .big, .qa-t { font-size: clamp(1.15rem, 3svh, 1.7rem); }
    .qa-x { font-size: 13.5px; line-height: 1.35; }
    .worlds { gap: 8px; }
    .w-txt { font-size: 12.5px; line-height: 1.3; }
    .rings { gap: 8px; }
    .rings li { grid-template-columns: 46px minmax(0, 1fr); }
    .rings svg, .r-code { width: 46px; height: 46px; }
    .hang { --badge-w: min(22vw, 270px, 40svh); }
  }

  @media (min-width: 1101px) and (max-height: 760px) {
    .w-txt > span { display: none; }
    .worlds li { align-items: center; }
  }

  /* Tablets and phones: one screen still. The ID hangs beside the name (top right), and the cards
     tighten up underneath. */
  @media (max-width: 1100px) {
    .about-grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 12px; align-items: stretch; }
    .bento { display: contents; }
    .id-col { position: relative; grid-column: 2; grid-row: 1; }
    .b-intro { grid-column: 1; grid-row: 1; }
    .b-age { grid-column: 1; grid-row: 2; }
    .b-langs { grid-column: 2; grid-row: 2; }
    .b-role, .b-qa, .b-does { grid-column: 1 / -1; }
    .hang {
      --badge-w: min(40vw, 320px);
      --strap: calc(var(--pad-top, clamp(32px, 7svh, 110px)) + 18px);
      height: calc(var(--strap) + 44px + var(--badge-h) + 8px);
      margin-top: calc(var(--pad-top, clamp(32px, 7svh, 110px)) * -1);
    }
    .hang-hint { display: none; }
  }

  @media (min-width: 701px) and (max-width: 1100px) {
    .b-role { grid-column: 1; }
    .b-qa { grid-column: 2; }
  }

  @media (max-width: 700px) {
    .hang { --pad-top: 36px; }
    .about-grid { gap: 9px; }
    .card { padding: 14px 16px; border-radius: 20px; }
    .label { margin-bottom: 6px; font-size: 11px; }
    .kicker { font-size: 11px; }
    .me-name { font-size: clamp(1.6rem, 1rem + 4vw, 2.2rem); }
    .me-bio { display: none; }
    .age-n { font-size: 3.6rem; }
    .age-l { font-size: 12px; }
    .big { font-size: 1.15rem; }
    .small { font-size: 12px; }
    .open { margin-top: 4px; font-size: 12px; }
    .b-qa { padding-right: 64px; }
    .qa-ico { right: 14px; top: 14px; width: 40px; height: 40px; border-radius: 12px; }
    .qa-ico svg { width: 22px; height: 22px; }
    .qa-t { font-size: 1.15rem; }
    .qa-x { font-size: 12.5px; line-height: 1.35; }
    .worlds { gap: 8px; }
    .worlds li { grid-template-columns: 32px minmax(0, 1fr); gap: 8px; align-items: center; }
    .w-ico { width: 32px; height: 32px; border-radius: 10px; }
    .w-ico svg { width: 18px; height: 18px; }
    .w-txt > span { display: none; }
    .w-txt strong { font-size: 13px; line-height: 1.15; }
    .rings { gap: 8px; }
    .rings li { grid-template-columns: 40px minmax(0, 1fr); column-gap: 8px; }
    .rings svg, .r-code { width: 40px; height: 40px; }
    .r-code { font-size: 11px; }
    .r-name { font-size: 13px; }
    .r-lv { font-size: 12px; }
  }
</style>

<script>
  import { initLanyard } from '../scripts/lanyard';

  // The ID swings on its lanyard.
  initLanyard(document.querySelector<HTMLElement>('.studio [data-lanyard]'), { waitFor: 'fp-enter-quien-soy' });

  // His age, counted again on the visitor's day (the page may be older than his last birthday).
  const ageEl = document.querySelector<HTMLElement>('[data-age]');
  const born = ageEl?.closest<HTMLElement>('[data-born]')?.dataset.born;
  if (ageEl && born) {
    const b = new Date(born), d = new Date();
    ageEl.textContent = String(d.getFullYear() - b.getFullYear() - (d < new Date(d.getFullYear(), b.getMonth(), b.getDate()) ? 1 : 0));
  }
</script>
