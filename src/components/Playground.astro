---
// What José carries and what he has made, in the quiet column: his tools two by two with his
// languages, then a playground of pictures (after Candid's) — his projects and his 3D models, in a
// loose mosaic, each naming itself on a small glass pill when you point at it.
import Edge from './Edge.astro';
import { getData, t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { projects, tools, languages } = getData(lang);
const ui = t(lang);
const c = ui.candid;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
type Tile = { src: string; name: string; url: string };
const models: Tile[] = projects.flatMap((p) =>
  (p.models ?? []).map((m) => ({ src: `img/sketchfab/${m.uid}.jpg`, name: m.name, url: `https://sketchfab.com/3d-models/${m.uid}` })),
);
const posters: Tile[] = projects.map((p) => ({ src: p.poster, name: p.name, url: p.url }));
// Interleave posters and models so the colours mix.
const tiles: Tile[] = [];
for (let i = 0; i < Math.max(posters.length, models.length); i++) {
  if (posters[i]) tiles.push(posters[i]);
  if (models[i]) tiles.push(models[i]);
}
---
<section data-scene="inventory" class="c-sec play" id="inventario" aria-labelledby="tools-title">
  <Edge kind="dome" />
  <div class="col">
    <h2 class="c-head reveal" id="tools-title">{c.tools}</h2>
    <ul class="c-grid2 reveal" style="--d:60ms">
      {tools.map((tl) => <li><strong>{tl.group}</strong><span>{tl.items}</span></li>)}
      <li><strong>{c.langs}</strong><span>{languages.map((l) => `${l.group} · ${l.items}`).join(' — ')}</span></li>
    </ul>

    <hr class="c-rule" />

    <h3 class="c-head reveal">
      {c.play}
      <svg class="dots" viewBox="0 0 16 16" aria-hidden="true"><rect x="1" y="1" width="6" height="6" rx="1.5" /><rect x="9" y="1" width="6" height="6" rx="1.5" /><rect x="1" y="9" width="6" height="6" rx="1.5" /><rect x="9" y="9" width="6" height="6" rx="1.5" /></svg>
    </h3>
    <ul class="mosaic reveal" style="--d:60ms">
      {tiles.map((tl) => (
        <li>
          <a href={tl.url} target="_blank" rel="noopener" data-lens={tl.name} aria-label={tl.name}>
            <img src={`${base}${tl.src}`} loading="lazy" alt="" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .dots {
    width: 16px;
    margin-left: auto;
    fill: currentColor;
    opacity: 0.45;
  }

  /* A loose masonry, four columns, every picture at its own height. */
  .mosaic {
    columns: 4;
    column-gap: 8px;
  }

  .mosaic li {
    break-inside: avoid;
    margin-bottom: 8px;
  }

  .mosaic a {
    position: relative;
    display: block;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 10px 20px -14px #2a2a2e80;
    transition: transform 0.35s var(--ease-spring);
  }

  .mosaic a:hover { transform: scale(1.04) rotate(-1deg); }
  .mosaic li:nth-child(3n) a:hover { transform: scale(1.04) rotate(1.2deg); }

  .mosaic img {
    width: 100%;
    height: auto;
  }

  /* The name, on a small glass pill that rises in on hover (or focus). */
  .mosaic a::after {
    content: attr(data-lens);
    position: absolute;
    left: 8px;
    bottom: 8px;
    max-width: calc(100% - 16px);
    padding: 5px 10px;
    border-radius: 999px;
    background: #ffffffd9;
    -webkit-backdrop-filter: blur(8px) saturate(160%);
    backdrop-filter: blur(8px) saturate(160%);
    color: var(--ink);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    box-shadow: inset 0 1px 0 #fff, 0 6px 14px -8px #2a2a2e80;
    opacity: 0;
    translate: 0 6px;
    transition: opacity 0.2s, translate 0.3s var(--ease-spring);
    pointer-events: none;
  }

  .mosaic a:hover::after,
  .mosaic a:focus-visible::after {
    opacity: 1;
    translate: 0 0;
  }

  /* Some tiles crop square, some tall, so the wall doesn't look like a grid. */
  .mosaic li:nth-child(4n + 1) img { aspect-ratio: 1; object-fit: cover; }
  .mosaic li:nth-child(5n + 2) img { aspect-ratio: 3 / 4; object-fit: cover; }

  @media (max-width: 560px) {
    .mosaic { columns: 2; }
  }
</style>
